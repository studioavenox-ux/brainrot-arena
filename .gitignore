# Local development tools / caches (never shipped)
.tools/
.cache/
__pycache__/
*.pyc
node_modules/
.DS_Store

# Studio recovery / local settings
*.rbxl
*.rbxl.lock
*.rbxlx.lock
*.rbxl.autosave
*.rbxlx.autosave
*.rbxs

# Art-review renders (docs/previews) are intentionally tracked: they are the visual
# deliverable of the art-direction pass. They are regenerated with tools/preview.py.

# Build output is reproducible; the two ready-to-open XML places are intentionally tracked.
artifacts/*.log

# Reproducible delivery archives (regenerate with tools/package_release.py)
artifacts/*.zip

# Requested complete project attachment is intentionally preserved with the project.
!artifacts/BrainrotArena-Project.zip
