      <Item class="ModuleScript" referent="RBX000387">
        <Properties>
          <string name="Name">WorldService</string>
          <ProtectedString name="Source">--!strict
-- The downloadable place already contains the map. Rojo users get this exact map at runtime.
local Workspace = game:GetService("Workspace")
local Data = require(script.Parent.WorldData)
local WorldService = {}
WorldService.__index = WorldService

local function rgb(values: { number }): Color3
	return Color3.fromRGB(values[1], values[2], values[3])
end
local function vector(values: { number }): Vector3
	return Vector3.new(values[1], values[2], values[3])
end

local function makeSign(parent: BasePart, lines)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Sign"
	gui.Face = Enum.NormalId.Front
	gui.CanvasSize = Vector2.new(1200, math.max(100, math.floor(1200 * parent.Size.Y / parent.Size.X)))
	gui.LightInfluence = 0
	gui.Parent = parent
	local total = 0
	for _, line in lines do
		total += line.Fraction
	end
	local y = 0.04
	for index, line in lines do
		local label = Instance.new("TextLabel")
		label.Name = "Line" .. index
		local height = 0.92 * line.Fraction / total
		label.Position = UDim2.fromScale(0.04, y)
		label.Size = UDim2.fromScale(0.92, height)
		label.BackgroundTransparency = 1
		label.Text = line.Text
		label.TextColor3 = rgb(line.Color)
		label.TextScaled = true
		label.TextWrapped = true
		label.Font = Enum.Font.GothamBold
		label.TextStrokeTransparency = 0.8
		label.Parent = gui
		y += height
	end
end

function WorldService.new()
	local root = Workspace:FindFirstChild("BrainrotWorld")
	if not root then
		local model = Instance.new("Model")
		model.Name = "BrainrotWorld"
		local lookup: { [string]: BasePart } = {}
		for _, spec in Data.Parts do
			local part = Instance.new(spec.Class) :: BasePart
			part.Name = spec.Name
			part.Size = vector(spec.Size)
			part.CFrame = CFrame.new(vector(spec.Position)) * CFrame.Angles(
				math.rad(spec.Rotation[1]), math.rad(spec.Rotation[2]), math.rad(spec.Rotation[3])
			)
			part.Color = rgb(spec.Color)
			part.Material = Enum.Material[spec.Material]
			part.Anchored = true
			part.CanCollide = spec.Collide
			part.CanTouch = spec.Class == "SpawnLocation"
			part.CanQuery = spec.Collide
			part.CastShadow = spec.Material ~= "Neon"
			part.Transparency = spec.Transparency
			part.TopSurface = Enum.SurfaceType.Smooth
			part.BottomSurface = Enum.SurfaceType.Smooth
			if part:IsA("Part") then
				part.Shape = Enum.PartType[spec.Shape]
			end
			if part:IsA("SpawnLocation") then
				part.Neutral = true
				part.Duration = 0
				part.AllowTeamChangeOnTouch = false
			end
			if spec.Name == "ChaosAccent_BeaconTop" then
				local light = Instance.new("PointLight")
				light.Name = "BeaconLight"
				light.Color = Color3.fromRGB(255, 130, 221)
				light.Brightness = 1.5
				light.Range = 28
				light.Parent = part
			end
			part.Parent = model
			lookup[spec.Name] = part
		end
		for _, sign in Data.Signs do
			makeSign(lookup[sign.Part], sign.Lines)
		end
		model.Parent = Workspace
		root = model
	end
	local spawn = root:FindFirstChild("LobbySpawn")
	assert(spawn and spawn:IsA("SpawnLocation"), "BrainrotWorld is missing LobbySpawn")
	local queueBoard = root:FindFirstChild("QueueStatusBoard")
	assert(queueBoard, "Missing queue board")
	local status = queueBoard:FindFirstChild("Line1", true) :: TextLabel?
	local accents: { BasePart } = {}
	for _, child in root:GetChildren() do
		if child:IsA("BasePart") and string.sub(child.Name, 1, 12) == "ChaosAccent_" then
			table.insert(accents, child)
			child:SetAttribute("RestColor", child.Color)
		end
	end
	return setmetatable({ root = root, lobbySpawn = spawn, status = status, accents = accents }, WorldService)
end

function WorldService.spawnCFrame(_self, arena: boolean, index: number): CFrame
	local positions = if arena then Data.ArenaSpawns else Data.LobbySpawns
	local position = vector(positions[(index - 1) % #positions + 1])
	local target = if arena then Vector3.new(0, position.Y, 0) else Vector3.new(0, position.Y, 155)
	return CFrame.lookAt(position, target)
end

function WorldService.setLowGravity(self, active: boolean)
	for _, part in self.accents do
		part.Color = if active then Color3.fromRGB(177, 122, 255) else part:GetAttribute("RestColor")
	end
end

function WorldService.setStatus(self, phase: string, remaining: number)
	if not self.status then
		return
	end
	if phase == "Playing" then
		self.status.Text = "ROUND LIVE • AUTO JOIN"
	elseif phase == "Intermission" then
		self.status.Text = string.format("AUTO JOIN IN %02d:%02d", math.floor(remaining / 60), remaining % 60)
	elseif phase == "Results" then
		self.status.Text = "NICE BRAIN. NEXT ROUND SOON."
	else
		self.status.Text = "AUTO JOIN • EVERY ROUND"
	end
end

return WorldService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="Folder" referent="RBX000388">
        <Properties>
          <string name="Name">core</string>
        </Properties>
        <Item class="ModuleScript" referent="RBX000389">
          <Properties>
            <string name="Name">MovementGuard</string>
            <ProtectedString name="Source">--!strict
-- A modest server-side teleport/speed sanity check, not a claim of exploit-proof physics.
-- Vertical motion is unrestricted so low-gravity jumps and falling remain valid.
local MovementGuard = {}
MovementGuard.__index = MovementGuard

export type Position = { x: number, y: number, z: number }
type Track = { position: Position, at: number, unlockAt: number }
type Fields = { tracks: { [number]: Track }, speed: number, slack: number, protection: number }
export type Guard = typeof(setmetatable({} :: Fields, MovementGuard))

local function valid(p: Position): boolean
	return p.x == p.x and p.y == p.y and p.z == p.z
		and math.abs(p.x) &lt; 100000 and math.abs(p.y) &lt; 100000 and math.abs(p.z) &lt; 100000
end

function MovementGuard.new(speed: number, slack: number, protection: number): Guard
	return setmetatable({ tracks = {}, speed = speed, slack = slack, protection = protection }, MovementGuard)
end

function MovementGuard.teleport(self: Guard, id: number, position: Position, now: number)
	self.tracks[id] = { position = position, at = now, unlockAt = now + self.protection }
end

function MovementGuard.remove(self: Guard, id: number)
	self.tracks[id] = nil
end

function MovementGuard.observe(self: Guard, id: number, position: Position, now: number): (boolean, Position?)
	local track = self.tracks[id]
	if not valid(position) then
		return false, if track then track.position else nil
	end
	if not track then
		self:teleport(id, position, now)
		return false, nil
	end
	local dt = math.clamp(now - track.at, 0, 1)
	local dx = position.x - track.position.x
	local dz = position.z - track.position.z
	local limit = self.speed * dt + self.slack
	if dx * dx + dz * dz &gt; limit * limit then
		track.at = now
		track.unlockAt = now + self.protection
		return false, track.position
	end
	track.position = position
	track.at = now
	return now &gt;= track.unlockAt, nil
end

return MovementGuard
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX000390">
          <Properties>
            <string name="Name">PickupLedger</string>
            <ProtectedString name="Source">--!strict
-- Atomic, non-yielding collectible ownership. Positions and values originate on the server.
local PickupLedger = {}
PickupLedger.__index = PickupLedger

export type Position = { x: number, y: number, z: number }
export type Kind = { Name: string, Value: number, Weight: number, Color: { number } }
export type Slot = {
	id: number, position: Position, generation: number, available: boolean,
	readyAt: number, kindIndex: number,
}
export type Context = {
	userId: number, roundId: number, active: boolean, alive: boolean, position: Position,
}
export type Receipt = {
	userId: number, roundId: number, slotId: number, generation: number,
	kindIndex: number, value: number, position: Position,
}
type Fields = {
	slots: { Slot }, kinds: { Kind }, radius: number, respawn: number,
	roundId: number, running: boolean, choose: () -&gt; number,
}
export type Ledger = typeof(setmetatable({} :: Fields, PickupLedger))

local function finite(n: number): boolean
	return n == n and n &gt; -math.huge and n &lt; math.huge
end
local function validPosition(p: Position): boolean
	return finite(p.x) and finite(p.y) and finite(p.z)
end

function PickupLedger.new(positions: { Position }, kinds: { Kind }, radius: number, respawn: number, choose: () -&gt; number): Ledger
	assert(radius &gt; 0 and respawn &gt; 0 and #kinds &gt; 0, "Invalid pickup rules")
	for _, kind in kinds do
		assert(kind.Value == 1 or kind.Value == 5 or kind.Value == 10, "Invalid server denomination")
		assert(kind.Weight &gt; 0, "Positive rarity weights required")
	end
	local slots: { Slot } = {}
	for id, position in positions do
		assert(validPosition(position), "Invalid server spawn point")
		table.insert(slots, { id = id, position = position, generation = 0, available = false, readyAt = 0, kindIndex = 1 })
	end
	return setmetatable({
		slots = slots, kinds = kinds, radius = radius, respawn = respawn,
		roundId = 0, running = false, choose = choose,
	}, PickupLedger)
end

function PickupLedger.rollKind(self: Ledger): number
	local total = 0
	for _, kind in self.kinds do
		total += kind.Weight
	end
	local roll = math.clamp(self.choose(), 0, 0.999999) * total
	for index, kind in self.kinds do
		roll -= kind.Weight
		if roll &lt; 0 then
			return index
		end
	end
	return #self.kinds
end

function PickupLedger.beginRound(self: Ledger, roundId: number)
	self.roundId = roundId
	self.running = true
	for _, slot in self.slots do
		slot.generation += 1
		slot.available = true
		slot.readyAt = 0
		slot.kindIndex = self:rollKind()
	end
end

function PickupLedger.clear(self: Ledger)
	self.running = false
	for _, slot in self.slots do
		slot.available = false
		slot.readyAt = math.huge
	end
end

function PickupLedger.tryClaim(self: Ledger, slotId: number, generation: number, context: Context, now: number): (Receipt?, string)
	if not finite(now) or not self.running or not context.active or context.roundId ~= self.roundId then
		return nil, "inactive-round"
	end
	if not finite(context.userId) or context.userId == 0 or context.userId % 1 ~= 0 or not context.alive then
		return nil, "invalid-player"
	end
	if not finite(slotId) or slotId % 1 ~= 0 then
		return nil, "invalid-slot"
	end
	local slot = self.slots[slotId]
	if not slot or not slot.available or slot.generation ~= generation then
		return nil, "unavailable"
	end
	if not validPosition(context.position) then
		return nil, "invalid-position"
	end
	local dx = slot.position.x - context.position.x
	local dy = slot.position.y - context.position.y
	local dz = slot.position.z - context.position.z
	if dx * dx + dy * dy + dz * dz &gt; self.radius * self.radius then
		return nil, "out-of-range"
	end
	-- Consume BEFORE returning. Two players in the same simulation tick cannot both win it.
	slot.available = false
	slot.readyAt = now + self.respawn
	return {
		userId = context.userId, roundId = self.roundId, slotId = slotId, generation = generation,
		kindIndex = slot.kindIndex, value = self.kinds[slot.kindIndex].Value, position = slot.position,
	}, "ok"
end

function PickupLedger.step(self: Ledger, now: number): { number }
	local changed: { number } = {}
	if not self.running then
		return changed
	end
	for _, slot in self.slots do
		if not slot.available and now &gt;= slot.readyAt then
			slot.generation += 1
			slot.kindIndex = self:rollKind()
			slot.available = true
			table.insert(changed, slot.id)
		end
	end
	return changed
end

return PickupLedger
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX000391">
          <Properties>
            <string name="Name">RoundMachine</string>
            <ProtectedString name="Source">--!strict
-- Engine-independent authority. No task.wait(), remotes, or Roblox objects live here.
local RoundMachine = {}
RoundMachine.__index = RoundMachine

export type Timing = {
	Intermission: number, Round: number, Results: number, EventStart: number, EventDuration: number,
}
export type Settings = {
	Timing: Timing, ParticipationCoins: number, CoinsPerPoint: number, WinnerCoins: number, HaloCost: number,
}
export type Player = {
	id: number, name: string, score: number, coins: number, wins: number, pickups: number,
	participating: boolean, haloOwned: boolean, haloEquipped: boolean,
}
export type Row = {
	id: number, name: string, score: number, coins: number, wins: number, pickups: number,
	haloOwned: boolean, haloEquipped: boolean,
}
export type Results = {
	roundId: number, winners: { Row }, topScore: number, rewards: { [string]: number },
}
export type Effect = { kind: string, phase: string?, active: boolean? }
type Fields = {
	config: Settings, players: { [number]: Player }, phase: string, roundId: number,
	phaseStartedAt: number, phaseEndsAt: number, eventActive: boolean, eventEndsAt: number,
	eventFinished: boolean, lastNow: number, lastResults: Results?,
}
export type Machine = typeof(setmetatable({} :: Fields, RoundMachine))

local function finite(value: number): boolean
	return value == value and value &gt; -math.huge and value &lt; math.huge
end

function RoundMachine.new(config: Settings): Machine
	assert(config.Timing.Intermission &gt; 0 and config.Timing.Round &gt; 0 and config.Timing.Results &gt; 0, "Positive phase durations required")
	assert(config.Timing.EventStart &gt;= 0 and config.Timing.EventDuration &gt; 0, "Invalid event timing")
	assert(config.Timing.EventStart + config.Timing.EventDuration &lt; config.Timing.Round, "Chaos event must fit inside the round")
	return setmetatable({
		config = config, players = {}, phase = "Waiting", roundId = 0,
		phaseStartedAt = 0, phaseEndsAt = 0, eventActive = false, eventEndsAt = 0,
		eventFinished = false, lastNow = 0, lastResults = nil,
	}, RoundMachine)
end

function RoundMachine.addPlayer(self: Machine, id: number, name: string): boolean
	-- Studio local clients use negative UserIds. Never reject those.
	if not finite(id) or id % 1 ~= 0 or id == 0 or self.players[id] then
		return false
	end
	self.players[id] = {
		id = id, name = string.sub(name, 1, 50), score = 0, coins = 0, wins = 0, pickups = 0,
		participating = self.phase == "Playing", haloOwned = false, haloEquipped = false,
	}
	return true
end

function RoundMachine.removePlayer(self: Machine, id: number)
	self.players[id] = nil
end

function RoundMachine.isParticipating(self: Machine, id: number): boolean
	local player = self.players[id]
	return self.phase == "Playing" and player ~= nil and player.participating
end

function RoundMachine.award(self: Machine, id: number, value: number, roundId: number): boolean
	if roundId ~= self.roundId or not self:isParticipating(id) then
		return false
	end
	-- Only the server's three collectible denominations are permitted.
	if value ~= 1 and value ~= 5 and value ~= 10 then
		return false
	end
	local player = self.players[id]
	player.score += value
	player.pickups += 1
	return true
end

function RoundMachine.haloAction(self: Machine, id: number): (boolean, string)
	local player = self.players[id]
	if not player then
		return false, "Player missing"
	end
	if player.haloOwned then
		player.haloEquipped = not player.haloEquipped
		return true, if player.haloEquipped then "Halo equipped" else "Halo unequipped"
	end
	if player.coins &lt; self.config.HaloCost then
		return false, "Not enough session coins"
	end
	player.coins -= self.config.HaloCost
	player.haloOwned = true
	player.haloEquipped = true
	return true, "Pulse Halo unlocked for this session!"
end

function RoundMachine.rows(self: Machine): { Row }
	local rows: { Row } = {}
	for _, player in self.players do
		table.insert(rows, {
			id = player.id, name = player.name, score = player.score, coins = player.coins,
			wins = player.wins, pickups = player.pickups,
			haloOwned = player.haloOwned, haloEquipped = player.haloEquipped,
		})
	end
	table.sort(rows, function(a: Row, b: Row)
		return if a.score == b.score then a.id &lt; b.id else a.score &gt; b.score
	end)
	return rows
end

function RoundMachine.finishRound(self: Machine)
	local rows = self:rows()
	local topScore = if rows[1] then rows[1].score else 0
	local winners: { Row } = {}
	local rewards: { [string]: number } = {}
	for _, row in rows do
		local player = self.players[row.id]
		if player.participating then
			local won = topScore &gt; 0 and row.score == topScore
			local amount = self.config.ParticipationCoins + row.score * self.config.CoinsPerPoint
			if won then
				amount += self.config.WinnerCoins
				player.wins += 1
				table.insert(winners, row)
			end
			player.coins += amount
			rewards[tostring(row.id)] = amount
		end
		player.participating = false
	end
	self.lastResults = { roundId = self.roundId, winners = winners, topScore = topScore, rewards = rewards }
end

function RoundMachine.setPhase(self: Machine, phase: string, now: number, effects: { Effect })
	self.phase = phase
	self.phaseStartedAt = now
	if phase == "Playing" then
		self.roundId += 1
		self.lastResults = nil
		self.eventFinished = false
		self.phaseEndsAt = now + self.config.Timing.Round
		for _, player in self.players do
			player.score = 0
			player.pickups = 0
			player.participating = true
		end
	elseif phase == "Intermission" then
		self.phaseEndsAt = now + self.config.Timing.Intermission
	elseif phase == "Results" then
		self:finishRound()
		self.phaseEndsAt = now + self.config.Timing.Results
	else
		self.phaseEndsAt = 0
		self.lastResults = nil
		for _, player in self.players do
			player.participating = false
		end
	end
	table.insert(effects, { kind = "phase", phase = phase })
end

function RoundMachine.step(self: Machine, now: number): { Effect }
	assert(finite(now) and now &gt;= self.lastNow, "Server clock must be finite and monotonic")
	self.lastNow = now
	local effects: { Effect } = {}
	if next(self.players) == nil then
		if self.eventActive then
			self.eventActive = false
			self.eventEndsAt = 0
			table.insert(effects, { kind = "event", active = false })
		end
		if self.phase ~= "Waiting" then
			self:setPhase("Waiting", now, effects)
		end
		return effects
	end

	-- End first: a stalled server must never award a pickup after the deadline.
	if self.phase == "Waiting" then
		self:setPhase("Intermission", now, effects)
	elseif self.phase == "Intermission" and now &gt;= self.phaseEndsAt then
		self:setPhase("Playing", now, effects)
	elseif self.phase == "Playing" and now &gt;= self.phaseEndsAt then
		if self.eventActive then
			self.eventActive = false
			self.eventEndsAt = 0
			table.insert(effects, { kind = "event", active = false })
		end
		self:setPhase("Results", now, effects)
	elseif self.phase == "Results" and now &gt;= self.phaseEndsAt then
		self:setPhase("Intermission", now, effects)
	end

	if self.phase == "Playing" then
		local startAt = self.phaseStartedAt + self.config.Timing.EventStart
		local endAt = startAt + self.config.Timing.EventDuration
		if now &gt;= endAt then
			self.eventFinished = true
			if self.eventActive then
				self.eventActive = false
				self.eventEndsAt = 0
				table.insert(effects, { kind = "event", active = false })
			end
		elseif now &gt;= startAt and not self.eventFinished and not self.eventActive then
			self.eventActive = true
			self.eventEndsAt = endAt
			table.insert(effects, { kind = "event", active = true })
		end
	end
	return effects
end

function RoundMachine.snapshot(self: Machine)
	return {
		phase = self.phase, roundId = self.roundId, phaseEndsAt = self.phaseEndsAt,
		eventActive = self.eventActive, eventEndsAt = self.eventEndsAt,
		rows = self:rows(), results = self.lastResults,
	}
end

return RoundMachine
</ProtectedString>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBX000392">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CharacterWalkSpeed">22</float>
      <float name="CharacterJumpPower">50</float>
      <float name="CameraMaxZoomDistance">80</float>
      <float name="CameraMinZoomDistance">8</float>
      <bool name="CharacterUseJumpPower">true</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBX000393">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="RBX000394">
        <Properties>
          <string name="Name">BrainrotClient</string>
        </Properties>
        <Item class="ModuleScript" referent="RBX000395">
          <Properties>
            <string name="Name">Effects</string>
            <ProtectedString name="Source">--!nonstrict
-- Lightweight local cosmetics. The server's invisible pickup positions never move.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Effects = {}
Effects.__index = Effects

local function fxPart(parent, name, size, color)
	local p = Instance.new("Part")
	p.Name, p.Size, p.Color = name, size, color
	p.Anchored = true
	p.CanCollide, p.CanTouch, p.CanQuery, p.CastShadow = false, false, false, false
	p.Material = Enum.Material.SmoothPlastic
	p.Parent = parent
	return p
end

function Effects.new(hud, config)
	local self = setmetatable({ hud = hud, config = config, visuals = {}, connections = {}, accumulator = 0, eventActive = false, lastTone = 0 }, Effects)
	self.folder = Instance.new("Folder")
	self.folder.Name = "BrainrotClientFX"
	self.folder.Parent = Workspace
	self.tint = Instance.new("ColorCorrectionEffect")
	self.tint.Name = "BrainrotChaosTint"
	self.tint.Parent = Lighting
	local pickups = Workspace:WaitForChild("BrainrotPickups")
	for _, child in pickups:GetChildren() do self:add(child) end
	table.insert(self.connections, pickups.ChildAdded:Connect(function(child) self:add(child) end))
	table.insert(self.connections, pickups.ChildRemoved:Connect(function(child) self:remove(child) end))
	table.insert(self.connections, RunService.RenderStepped:Connect(function(dt) self:step(dt) end))
	return self
end

function Effects:refresh(part)
	local view = self.visuals[part]
	if not view then return end
	view.active = part:GetAttribute("Active") == true
	view.value = part:GetAttribute("Value") or 1
	local base = part.Color
	for _, kind in self.config.Kinds do
		if kind.Value == view.value then base = Color3.fromRGB(kind.Color[1], kind.Color[2], kind.Color[3]); break end
	end
	for index, lobe in view.lobes do
		lobe.Color = if view.value == 10 and index%2 == 0 then Color3.fromRGB(193, 122, 255) else base:Lerp(Color3.new(1, 1, 1), if index%3 == 0 then .13 else 0)
		lobe.Material = if view.value == 1 then Enum.Material.SmoothPlastic else Enum.Material.Neon
		lobe.Transparency = if view.active and view.near then 0 else 1
	end
	view.seam.Transparency = if view.active and view.near then 0 else 1
end

function Effects:add(part)
	if not part:IsA("BasePart") or self.visuals[part] then return end
	part.LocalTransparencyModifier = 1
	local model = Instance.new("Model")
	model.Name = "CellVisual_" .. tostring(part:GetAttribute("SlotId") or 0)
	local pivot = fxPart(model, "Pivot", Vector3.new(.1, .1, .1), part.Color)
	pivot.Transparency = 1
	pivot.CFrame = CFrame.new(part.Position)
	model.PrimaryPart = pivot
	local lobes = {}
	for side = -1, 1, 2 do
		for row = 1, 3 do
			local lobe = fxPart(model, "Lobe", Vector3.new(.98, 1.1, .92), part.Color)
			lobe.Shape = Enum.PartType.Ball
			lobe.CFrame = CFrame.new(part.Position) * CFrame.new(side*.38, if row == 2 then .15 else 0, (row-2)*.46)
			table.insert(lobes, lobe)
		end
	end
	local seam = fxPart(model, "Split", Vector3.new(.09, .95, 1.35), Color3.fromRGB(144, 61, 178))
	seam.CFrame = CFrame.new(part.Position + Vector3.new(0, .08, 0))
	model.Parent = self.folder
	local view = { model = model, lobes = lobes, seam = seam, active = true, near = true, value = 1, phase = (part:GetAttribute("SlotId") or 0)*.77 }
	self.visuals[part] = view
	view.connection = part.AttributeChanged:Connect(function() self:refresh(part) end)
	self:refresh(part)
end

function Effects:remove(part)
	local view = self.visuals[part]
	if not view then return end
	view.connection:Disconnect()
	view.model:Destroy()
	self.visuals[part] = nil
end

function Effects:step(dt)
	self.accumulator += dt
	if self.accumulator &lt; 1/30 then return end
	self.accumulator = 0
	local camera = Workspace.CurrentCamera
	if not camera then return end
	local now = Workspace:GetServerTimeNow()
	for part, view in self.visuals do
		local near = (part.Position-camera.CFrame.Position).Magnitude &lt; 150
		if view.near ~= near then view.near = near; self:refresh(part) end
		if view.active and near then
			local bob = if self.hud.reducedMotion then 0 else math.sin(now*2+view.phase)*.28
			local angle = if self.hud.reducedMotion then 0 else (now*.7+view.phase) % (math.pi*2)
			view.model:PivotTo(CFrame.new(part.Position + Vector3.new(0, bob, 0)) * CFrame.Angles(0, angle, 0))
		end
	end
end

function Effects:update(state)
	if state.eventActive == self.eventActive then return end
	self.eventActive = state.eventActive
	local properties = {
		TintColor = if state.eventActive then Color3.fromRGB(238, 228, 255) else Color3.new(1, 1, 1),
		Saturation = if state.eventActive then .08 else 0,
	}
	if self.hud.reducedMotion then
		for key, value in properties do self.tint[key] = value end
	else
		TweenService:Create(self.tint, TweenInfo.new(.6), properties):Play()
	end
end

function Effects:pickup(receipt)
	local own = receipt.userId == Players.LocalPlayer.UserId
	local pos = Vector3.new(receipt.position.x, receipt.position.y, receipt.position.z)
	local color = self.config.Kinds[receipt.kindIndex].Color
	local tint = Color3.fromRGB(color[1], color[2], color[3])
	if own then
		self.hud:pulse()
		local now = os.clock()
		if self.hud.soundOn and now-self.lastTone &gt; .07 then
			self.lastTone = now
			local sound = Instance.new("Sound")
			sound.Name = "CellChime"
			-- Roblox's bundled short tone; no uploaded or third-party sound assets required.
			sound.SoundId = "rbxasset://sounds/electronicpingshort.wav"
			sound.Volume = .2
			sound.PlaybackSpeed = .95 + receipt.kindIndex*.12
			sound.Parent = SoundService
			sound:Play()
			Debris:AddItem(sound, 3)
		end
		local anchor = fxPart(self.folder, "ScorePopup", Vector3.new(.1, .1, .1), tint)
		anchor.Position, anchor.Transparency = pos+Vector3.new(0, 2, 0), 1
		local gui = Instance.new("BillboardGui")
		gui.Size, gui.AlwaysOnTop, gui.MaxDistance = UDim2.fromOffset(100, 50), true, 100
		gui.Parent = anchor
		local label = Instance.new("TextLabel")
		label.Size, label.BackgroundTransparency = UDim2.fromScale(1, 1), 1
		label.Text, label.TextColor3 = "+" .. receipt.value, tint
		label.Font, label.TextSize, label.TextStrokeTransparency = Enum.Font.GothamBlack, 32, .6
		label.Parent = gui
		TweenService:Create(anchor, TweenInfo.new(.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = anchor.Position+Vector3.new(0, 2.8, 0) }):Play()
		TweenService:Create(label, TweenInfo.new(.7), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		Debris:AddItem(anchor, .8)
	end
	local camera = Workspace.CurrentCamera
	if self.hud.reducedMotion or not camera or (camera.CFrame.Position-pos).Magnitude &gt; 100 then return end
	for i = 1, 7 do
		local spark = fxPart(self.folder, "Spark", Vector3.new(.3, .3, .3), tint)
		spark.Shape, spark.Material, spark.Position = Enum.PartType.Ball, Enum.Material.Neon, pos
		local angle = i*math.pi*2/7
		local target = pos + Vector3.new(math.cos(angle)*2.2, 1.5+(i%3)*.6, math.sin(angle)*2.2)
		TweenService:Create(spark, TweenInfo.new(.42, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = target, Size = Vector3.new(.05, .05, .05), Transparency = 1 }):Play()
		Debris:AddItem(spark, .5)
	end
end

function Effects:destroy()
	for _, connection in self.connections do connection:Disconnect() end
	local parts = {}
	for part in self.visuals do table.insert(parts, part) end
	for _, part in parts do self:remove(part) end
	self.folder:Destroy()
	self.tint:Destroy()
end

return Effects
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX000396">
          <Properties>
            <string name="Name">Hud</string>
            <ProtectedString name="Source">--!nonstrict
-- Original responsive UI. No score, currency, or reward decisions are made here.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local Hud = {}
Hud.__index = Hud

local C = {
	Ink = Color3.fromRGB(18, 22, 46), Panel = Color3.fromRGB(27, 32, 64),
	Line = Color3.fromRGB(73, 82, 122), Muted = Color3.fromRGB(167, 181, 210),
	White = Color3.fromRGB(244, 249, 255), Pink = Color3.fromRGB(255, 102, 192),
	Cyan = Color3.fromRGB(83, 238, 255), Gold = Color3.fromRGB(255, 216, 83),
	Purple = Color3.fromRGB(172, 124, 255),
}
local function make(className, properties, parent)
	local instance = Instance.new(className)
	for key, value in properties do
		instance[key] = value
	end
	instance.Parent = parent
	return instance
end
local function corner(parent, radius)
	make("UICorner", { CornerRadius = UDim.new(0, radius or 16) }, parent)
end
local function stroke(parent, color, transparency)
	return make("UIStroke", { Color = color or C.Line, Thickness = 1, Transparency = transparency or 0.2 }, parent)
end
local function panel(parent, name, size, pos, anchor)
	local f = make("Frame", {
		Name = name, Size = size, Position = pos, AnchorPoint = anchor or Vector2.zero,
		BackgroundColor3 = C.Ink, BackgroundTransparency = 0.07, BorderSizePixel = 0,
	}, parent)
	corner(f, 18)
	stroke(f)
	return f
end
local function text(parent, name, content, size, pos, color, font, textSize)
	return make("TextLabel", {
		Name = name, Text = content, Size = size, Position = pos,
		BackgroundTransparency = 1, TextColor3 = color or C.White,
		Font = font or Enum.Font.GothamBold, TextSize = textSize or 16,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center,
		RichText = false, BorderSizePixel = 0,
	}, parent)
end
local function centerLabel(parent, name, content, size, pos, color, font, textSize)
	local label = text(parent, name, content, size, pos, color, font, textSize)
	label.TextXAlignment = Enum.TextXAlignment.Center
	return label
end
local function button(parent, name, content, size, pos, color)
	local b = make("TextButton", {
		Name = name, Text = content, Size = size, Position = pos,
		BackgroundColor3 = color or C.Panel, BorderSizePixel = 0,
		Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = C.White,
		AutoButtonColor = true,
	}, parent)
	corner(b, 12)
	stroke(b)
	return b
end
local function brainIcon(parent, position, scale)
	local frame = make("Frame", { Name = "BrainIcon", Size = UDim2.fromOffset(48*scale, 44*scale), Position = position, BackgroundTransparency = 1 }, parent)
	for side = 0, 1 do
		for row = 0, 2 do
			local lobe = make("Frame", {
				Size = UDim2.fromOffset(24*scale, 22*scale),
				Position = UDim2.fromOffset((side*18+2)*scale, (row*10+1)*scale),
				BackgroundColor3 = if row == 1 then Color3.fromRGB(255, 142, 211) else C.Pink,
				BorderSizePixel = 0,
			}, frame)
			corner(lobe, 20)
		end
	end
	return frame
end
local function timeString(remaining)
	local seconds = math.max(0, math.ceil(remaining))
	return string.format("%02d:%02d", math.floor(seconds/60), seconds%60)
end

function Hud.new(config, request)
	local self = setmetatable({}, Hud)
	self.config, self.request = config, request
	self.soundOn, self.reducedMotion = true, false
	self.state, self.rows, self.connections = nil, {}, {}
	self.noticeToken, self.lastPhase, self.lastEvent = 0, "", false
	self.userId = Players.LocalPlayer.UserId
	self.screen = make("ScreenGui", {
		Name = "BrainrotHUD", ResetOnSpawn = false, IgnoreGuiInset = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 10,
		ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
	}, Players.LocalPlayer:WaitForChild("PlayerGui"))
	self.root = make("Frame", { Name = "SafeArea", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }, self.screen)

	self.brand = make("Frame", { Name = "Brand", Size = UDim2.fromOffset(220, 88), Position = UDim2.fromOffset(22, 16), BackgroundTransparency = 1 }, self.root)
	text(self.brand, "Wordmark", "BRAINROT", UDim2.fromOffset(220, 32), UDim2.fromOffset(0, 0), C.Gold, Enum.Font.GothamBlack, 28)
	text(self.brand, "Arena", "A R E N A", UDim2.fromOffset(220, 27), UDim2.fromOffset(1, 30), C.Pink, Enum.Font.GothamBlack, 23)
	text(self.brand, "Tagline", "A VERY UNREASONABLE SPORT.", UDim2.fromOffset(220, 18), UDim2.fromOffset(2, 60), C.Muted, Enum.Font.GothamMedium, 10)

	self.timerPanel = panel(self.root, "RoundClock", UDim2.fromOffset(288, 98), UDim2.new(.5, 0, 0, 12), Vector2.new(.5, 0))
	self.phaseLabel = centerLabel(self.timerPanel, "Phase", "SYNCING YOUR BRAIN…", UDim2.new(1, -16, 0, 22), UDim2.fromOffset(8, 9), C.Cyan, nil, 12)
	self.timeLabel = centerLabel(self.timerPanel, "Countdown", "--:--", UDim2.new(1, 0, 0, 48), UDim2.fromOffset(0, 31), C.White, Enum.Font.GothamBlack, 40)
	centerLabel(self.timerPanel, "MapName", "S Y N A P S E   C I R C U I T", UDim2.new(1, -10, 0, 14), UDim2.fromOffset(5, 80), C.Muted, Enum.Font.GothamMedium, 9)

	self.eventPanel = panel(self.root, "Chaos", UDim2.fromOffset(350, 46), UDim2.new(.5, 0, 0, 120), Vector2.new(.5, 0))
	self.eventPanel.BackgroundColor3 = Color3.fromRGB(55, 37, 90)
	self.eventLabel = centerLabel(self.eventPanel, "Event", "GRAB THE GLOW. TOP THE BOARD.", UDim2.new(1, -16, 1, 0), UDim2.fromOffset(8, 0), C.Muted, nil, 12)

	self.scorePanel = panel(self.root, "YourCells", UDim2.fromOffset(252, 78), UDim2.new(.5, 0, 1, -22), Vector2.new(.5, 1))
	self.scoreIcon = brainIcon(self.scorePanel, UDim2.fromOffset(18, 17), 1)
	self.scoreScale = make("UIScale", { Scale = 1 }, self.scoreIcon)
	self.scoreLabel = text(self.scorePanel, "Score", "0", UDim2.fromOffset(150, 42), UDim2.fromOffset(88, 4), C.White, Enum.Font.GothamBlack, 36)
	text(self.scorePanel, "Caption", "YOUR BRAIN CELLS", UDim2.fromOffset(155, 22), UDim2.fromOffset(89, 46), C.Pink, nil, 11)
	self.legend = make("Frame", { Name = "RarityKey", Size = UDim2.fromOffset(360, 24), Position = UDim2.new(.5, 0, 1, -112), AnchorPoint = Vector2.new(.5, 1), BackgroundTransparency = 1 }, self.root)
	for index, entry in { {"PINK +1", C.Pink}, {"GOLD +5", C.Gold}, {"PRISM +10", C.Cyan} } do
		centerLabel(self.legend, "Rarity" .. index, entry[1], UDim2.fromOffset(120, 24), UDim2.fromOffset((index-1)*120, 0), entry[2], nil, 12)
	end

	self.coinsPanel = panel(self.root, "Coins", UDim2.fromOffset(238, 78), UDim2.new(1, -20, 0, 16), Vector2.new(1, 0))
	text(self.coinsPanel, "Caption", "SESSION COINS", UDim2.new(1, -30, 0, 20), UDim2.fromOffset(16, 8), C.Gold, nil, 10)
	self.coinsLabel = text(self.coinsPanel, "Amount", "0", UDim2.new(1, -30, 0, 38), UDim2.fromOffset(16, 28), C.White, Enum.Font.GothamBlack, 30)

	self.ranksButton = button(self.root, "Ranks", "RANKS  /  TAB", UDim2.fromOffset(128, 36), UDim2.new(1, -148, 0, 104))
	self.board = panel(self.root, "Leaderboard", UDim2.fromOffset(238, 310), UDim2.new(1, -20, 0, 150), Vector2.new(1, 0))
	text(self.board, "Heading", "THIS ROUND", UDim2.new(1, -30, 0, 27), UDim2.fromOffset(15, 7), C.White, nil, 13)
	self.boardHint = text(self.board, "Subheading", "MOST CELLS WINS", UDim2.new(1, -30, 0, 17), UDim2.fromOffset(15, 32), C.Muted, Enum.Font.GothamMedium, 9)
	self.roster = make("ScrollingFrame", {
		Name = "Players", Position = UDim2.fromOffset(10, 57), Size = UDim2.new(1, -20, 1, -68),
		BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3,
		ScrollBarImageColor3 = C.Purple, CanvasSize = UDim2.fromOffset(0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
	}, self.board)
	make("UIListLayout", { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder }, self.roster)

	self.helpButton = button(self.root, "Help", "HOW TO PLAY  /  H", UDim2.fromOffset(146, 44), UDim2.new(0, 22, 1, -68))
	self.rewardsButton = button(self.root, "Rewards", "REWARDS", UDim2.fromOffset(112, 44), UDim2.new(0, 178, 1, -68))
	self.rewardsButton.TextColor3 = C.Gold
	self.soundButton = button(self.root, "Sound", "SFX ON", UDim2.fromOffset(84, 36), UDim2.new(0, 22, 1, -112))
	self.noticePanel = panel(self.root, "Notice", UDim2.fromOffset(420, 48), UDim2.new(.5, 0, 0, 180), Vector2.new(.5, 0))
	self.noticePanel.Visible = false
	self.noticeLabel = centerLabel(self.noticePanel, "Message", "", UDim2.new(1, -24, 1, 0), UDim2.fromOffset(12, 0), C.White, nil, 13)
	self.noticeLabel.TextWrapped = true

	-- Results are non-modal: players can still move around the lobby.
	self.resultsPanel = panel(self.root, "Results", UDim2.fromOffset(468, 264), UDim2.fromScale(.5, .49), Vector2.new(.5, .5))
	self.resultsPanel.Visible = false
	self.resultsPanel.ZIndex = 5
	centerLabel(self.resultsPanel, "Eyebrow", "ROUND COMPLETE", UDim2.new(1, -36, 0, 24), UDim2.fromOffset(18, 18), C.Cyan, nil, 12)
	self.resultTitle = centerLabel(self.resultsPanel, "Title", "BIG BRAIN ENERGY", UDim2.new(1, -32, 0, 46), UDim2.fromOffset(16, 51), C.Gold, Enum.Font.GothamBlack, 27)
	self.resultName = centerLabel(self.resultsPanel, "Winner", "", UDim2.new(1, -40, 0, 54), UDim2.fromOffset(20, 99), C.White, nil, 22)
	self.resultName.TextWrapped = true
	self.resultName.TextScaled = true
	make("UITextSizeConstraint", { MinTextSize = 12, MaxTextSize = 22 }, self.resultName)
	self.resultTitle.TextScaled = true
	make("UITextSizeConstraint", { MinTextSize = 12, MaxTextSize = 27 }, self.resultTitle)
	self.resultReward = centerLabel(self.resultsPanel, "Reward", "", UDim2.new(1, -40, 0, 34), UDim2.fromOffset(20, 166), C.Pink, nil, 18)
	self.resultNext = centerLabel(self.resultsPanel, "Next", "Next round soon. Keep your neurons warm.", UDim2.new(1, -28, 0, 32), UDim2.fromOffset(14, 213), C.Muted, Enum.Font.GothamMedium, 11)

	self.modal = make("Frame", { Name = "ModalLayer", Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.Ink, BackgroundTransparency = .24, Visible = false, ZIndex = 20, Active = true }, self.root)
	self.modalPanel = panel(self.modal, "Card", UDim2.fromOffset(468, 374), UDim2.fromScale(.5, .5), Vector2.new(.5, .5))
	self.modalPanel.ZIndex = 21
	self.modalTitle = text(self.modalPanel, "Title", "A QUICK BRAIN BRIEF", UDim2.new(1, -100, 0, 40), UDim2.fromOffset(24, 18), C.Gold, Enum.Font.GothamBlack, 22)
	self.modalBody = text(self.modalPanel, "Body", "", UDim2.new(1, -48, 1, -180), UDim2.fromOffset(24, 70), C.White, Enum.Font.GothamMedium, 16)
	self.modalBody.TextWrapped = true
	self.modalBody.TextYAlignment = Enum.TextYAlignment.Top
	self.modalBody.TextScaled = true
	make("UITextSizeConstraint", { MinTextSize = 11, MaxTextSize = 16 }, self.modalBody)
	self.modalAction = button(self.modalPanel, "Action", "LET'S GO", UDim2.new(1, -48, 0, 46), UDim2.new(0, 24, 1, -102), Color3.fromRGB(104, 62, 185))
	self.motionButton = button(self.modalPanel, "Motion", "REDUCED MOTION: OFF", UDim2.new(.5, -30, 0, 44), UDim2.new(0, 24, 1, -52))
	self.motionButton.TextSize = 10
	self.modalSoundButton = button(self.modalPanel, "ModalSound", "SFX ON", UDim2.new(.5, -30, 0, 44), UDim2.new(.5, 6, 1, -52))
	self.modalSoundButton.TextSize = 10
	self.closeButton = button(self.modalPanel, "Close", "X", UDim2.fromOffset(44, 44), UDim2.new(1, -64, 0, 16))
	self.closeButton.TextSize = 10
	-- Descendants share their panel's stacking context; the modal is above the whole HUD.
	for _, descendant in self.modal:GetDescendants() do
		if descendant:IsA("GuiObject") then
			descendant.ZIndex = 21
		end
	end

	self.ranksButton.Activated:Connect(function()
		self.board.Visible = not self.board.Visible
		self.ranksTouched = true
	end)
	self.helpButton.Activated:Connect(function() self:showModal("Help") end)
	self.rewardsButton.Activated:Connect(function() self:showModal("Rewards") end)
	self.closeButton.Activated:Connect(function() self.modal.Visible = false end)
	local function toggleSound()
		self.soundOn = not self.soundOn
		self.soundButton.Text = if self.soundOn then "SFX ON" else "SFX OFF"
		self.modalSoundButton.Text = self.soundButton.Text
	end
	self.soundButton.Activated:Connect(toggleSound)
	self.modalSoundButton.Activated:Connect(toggleSound)
	self.motionButton.Activated:Connect(function()
		self.reducedMotion = not self.reducedMotion
		self.motionButton.Text = "REDUCED MOTION: " .. (if self.reducedMotion then "ON" else "OFF")
	end)
	self.modalAction.Activated:Connect(function()
		if self.modalKind == "Rewards" then
			self.request("Halo")
		else
			self.modal.Visible = false
		end
	end)
	table.insert(self.connections, UserInputService.InputBegan:Connect(function(input, processed)
		if processed or UserInputService:GetFocusedTextBox() then return end
		if input.KeyCode == Enum.KeyCode.Tab then
			self.board.Visible = not self.board.Visible
			self.ranksTouched = true
		elseif input.KeyCode == Enum.KeyCode.H then
			if self.modal.Visible then self.modal.Visible = false else self:showModal("Help") end
		elseif input.KeyCode == Enum.KeyCode.Escape and self.modal.Visible then
			self.modal.Visible = false
		end
	end))
	table.insert(self.connections, self.root:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() self:resize() end))
	self:resize()
	return self
end

function Hud:resize()
	local width, height = self.root.AbsoluteSize.X, self.root.AbsoluteSize.Y
	if width &lt; 1 or height &lt; 1 then return end
	local compact = width &lt; 760
	local short = height &lt; 500
	local portraitTouch = compact and not short
	self.scorePanel.Size = UDim2.fromOffset(if portraitTouch then 208 else 252, if portraitTouch then 68 else 78)
	self.scorePanel.Position = UDim2.new(.5, 0, 1, if portraitTouch then -116 else -22)
	self.scoreLabel.Size = UDim2.new(1, -88, 0, if portraitTouch then 36 else 42)
	self.scoreLabel.TextSize = if portraitTouch then 30 else 36
	self.scorePanel.Caption.Position = UDim2.fromOffset(89, if portraitTouch then 40 else 46)
	self.scorePanel.Caption.Size = UDim2.new(1, -94, 0, 20)
	self.scorePanel.Caption.TextSize = if portraitTouch then 9 else 11
	self.compact = compact
	self.brand.Visible = not compact and not short
	self.timerPanel.Size = UDim2.fromOffset(if compact then math.clamp(width-168, 160, 208) else 288, if short then 82 else 98)
	self.timeLabel.TextSize = if short then 32 else 40
	self.timeLabel.Size = UDim2.new(1, 0, 0, if short then 35 else 48)
	self.timerPanel.MapName.Visible = not short
	self.phaseLabel.TextSize = if compact then 10 else 12
	self.eventPanel.Size = UDim2.fromOffset(math.min(width-32, if compact then 300 else 350), 38)
	self.eventPanel.Position = UDim2.new(.5, 0, 0, if short then 101 else 120)
	self.eventLabel.TextSize = if compact then 10 else 12
	self.ranksButton.Size = UDim2.fromOffset(if compact or short then 66 else 128, 44)
	self.ranksButton.Position = if compact or short then UDim2.new(1, -80, 0, 18) else UDim2.new(1, -148, 0, 104)
	self.ranksButton.Text = if compact or short then "RANKS" else "RANKS / TAB"
	self.board.Size = UDim2.fromOffset(if compact then 220 else 238, math.min(310, height-110))
	self.board.Position = UDim2.new(1, -14, 0, if compact or short then 76 else 150)
	if not self.ranksTouched then self.board.Visible = not compact and not short end
	self.coinsPanel.Size = UDim2.fromOffset(if compact or short then 170 else 238, if compact or short then 36 else 78)
	self.coinsPanel.AnchorPoint = if compact or short then Vector2.new(.5, 1) else Vector2.new(1, 0)
	self.coinsPanel.Position = if compact or short then UDim2.new(.5, 0, 1, if portraitTouch then -190 else -106) else UDim2.new(1, -20, 0, 16)
	self.coinsPanel.Caption.Visible = not compact and not short
	self.coinsLabel.Position = if compact or short then UDim2.fromOffset(12, 0) else UDim2.fromOffset(16, 28)
	self.coinsLabel.Size = if compact or short then UDim2.new(1, -24, 1, 0) else UDim2.new(1, -30, 0, 38)
	self.coinsLabel.TextSize = if compact or short then 13 else 30
	self.coinsLabel.TextXAlignment = if compact or short then Enum.TextXAlignment.Center else Enum.TextXAlignment.Left
	self.legend.Visible = not compact and not short
	self.helpButton.Text = if compact or short then "?" else "HOW TO PLAY / H"
	self.helpButton.Size = UDim2.fromOffset(if compact or short then 44 else 146, 44)
	self.helpButton.Position = if compact or short then UDim2.fromOffset(14, 18) else UDim2.new(0, 22, 1, -68)
	self.rewardsButton.Position = if compact or short then UDim2.fromOffset(14, 76) else UDim2.new(0, 178, 1, -68)
	self.rewardsButton.Size = UDim2.fromOffset(if compact then 60 elseif short then 92 else 112, 44)
	self.rewardsButton.TextSize = if compact then 9 else 12
	self.soundButton.Position = if compact or short then UDim2.fromOffset(14, 128) else UDim2.new(0, 22, 1, -112)
	self.soundButton.Size = UDim2.fromOffset(if compact or short then 92 else 84, 36)
	self.soundButton.Visible = not compact and not short
	self.resultsPanel.Size = UDim2.fromOffset(math.min(width-32, 468), math.min(264, height-32))
	self.resultTitle.TextSize = if compact then 22 else 27
	self.modalPanel.Size = UDim2.fromOffset(math.min(width-28, 468), math.min(height-24, 374))
	self.modalTitle.TextSize = if compact then 19 else 22
	self.modalBody.TextSize = if short then 13 elseif compact then 14 else 16
	self.noticePanel.Size = UDim2.fromOffset(math.min(width-32, 420), 48)
	self.noticePanel.Position = UDim2.new(.5, 0, 0, if short then 145 else 174)
	if self.state then self:updateLocalValues() end
end

function Hud:showModal(kind)
	self.modalKind = kind
	self.modal.Visible = true
	if kind == "Rewards" then
		self:updateRewardModal()
	else
		self.modalTitle.Text = "A QUICK BRAIN BRIEF"
		self.modalBody.Text = "01   COLLECT THE GLOW\nPink +1 • Gold +5 • Prism +10\n\n02   KEEP YOUR COOL\nLow gravity hits mid-round. Fall? You pop back with your score.\n\n03   BE THE BIGGEST BRAIN\nMost cells wins. Ties share the crown. Rounds start automatically."
		self.modalAction.Text = "LET'S GO"
	end
end

function Hud:updateRewardModal()
	local row = self.localRow
	self.modalTitle.Text = "YOUR NEXT FLEX"
	local owned = row and row.haloOwned
	local balance = if row then row.coins else 0
	self.modalBody.Text = "PULSE HALO\nA cyan orbit for a truly overactive brain.\n\n" .. (if owned then "You own this glow for the current session." else "Unlock with " .. self.config.HaloCost .. " coins earned by playing.") .. "\nBalance: " .. balance .. " session coins.\n\nCoins and unlocks reset when you leave. No Robux. No purchases."
	self.modalAction.Text = if owned then (if row.haloEquipped then "UNEQUIP HALO" else "EQUIP HALO") else "UNLOCK PULSE HALO  •  " .. self.config.HaloCost
end

function Hud:updateLocalValues()
	local row = self.localRow
	local coins = if row then row.coins else 0
	self.scoreLabel.Text = tostring(if row then row.score else 0)
	self.coinsLabel.Text = if self.compact or self.root.AbsoluteSize.Y &lt; 500 then (tostring(coins) .. "  SESSION COINS") else tostring(coins)
	if self.modal.Visible and self.modalKind == "Rewards" then self:updateRewardModal() end
end

function Hud:update(state)
	self.state = state
	self.localRow = nil
	local found = {}
	for index, row in state.rows do
		found[row.id] = true
		if row.id == self.userId then self.localRow = row end
		local view = self.rows[row.id]
		if not view then
			local frame = make("Frame", { Name = "Player_" .. row.id, Size = UDim2.new(1, -4, 0, 34), BackgroundColor3 = C.Panel, BorderSizePixel = 0 }, self.roster)
			corner(frame, 9)
			view = {
				frame = frame,
				rank = text(frame, "Rank", "", UDim2.fromOffset(30, 34), UDim2.fromOffset(8, 0), C.Muted, nil, 11),
				name = text(frame, "Player", "", UDim2.new(1, -82, 1, 0), UDim2.fromOffset(36, 0), C.White, Enum.Font.GothamMedium, 11),
				score = text(frame, "Cells", "", UDim2.fromOffset(38, 34), UDim2.new(1, -44, 0, 0), C.White, nil, 14),
			}
			view.score.TextXAlignment = Enum.TextXAlignment.Right
			view.name.TextTruncate = Enum.TextTruncate.AtEnd
			self.rows[row.id] = view
		end
		view.frame.LayoutOrder = index
		view.frame.BackgroundColor3 = if row.id == self.userId then Color3.fromRGB(70, 48, 113) else C.Panel
		view.rank.Text = string.format("%02d", index)
		view.rank.TextColor3 = if index == 1 then C.Gold else C.Muted
		view.name.Text = row.name .. (if row.id == self.userId then " (you)" else "")
		view.score.Text = tostring(row.score)
	end
	for id, view in self.rows do
		if not found[id] then view.frame:Destroy(); self.rows[id] = nil end
	end
	self:updateLocalValues()
	self.resultsPanel.Visible = state.phase == "Results"
	if state.phase == "Results" and state.results then
		local results = state.results
		local winners = results.winners
		if #winners == 0 then
			self.resultTitle.Text = "THE BRAINS ARE WARMING UP"
			self.resultName.Text = "No cells collected this time.\nNext round is yours."
		elseif #winners == 1 then
			self.resultTitle.Text = "BIG BRAIN ENERGY"
			self.resultName.Text = winners[1].name .. " wins!\n" .. results.topScore .. " Brain Cells"
		else
			self.resultTitle.Text = "A MEETING OF MINDS!"
			local names = {}
			for index, row in winners do
				if index &lt;= 3 then table.insert(names, row.name) end
			end
			self.resultName.Text = table.concat(names, ", ") .. (if #winners &gt; 3 then " + more" else "") .. "\nTied at " .. results.topScore .. " cells"
		end
		local reward = results.rewards[tostring(self.userId)] or 0
		self.resultReward.Text = if reward &gt; 0 then ("+" .. reward .. " SESSION COINS") else "YOUR NEXT ROUND STARTS SOON"
	end
	if state.phase ~= self.lastPhase then
		if state.phase == "Playing" then self:notice("GRAB THE GLOW! Pink +1 • Gold +5 • Prism +10") end
		self.lastPhase = state.phase
	end
	if state.eventActive and not self.lastEvent then self:notice("LOW GRAVITY! Moon feet. Same mission.") end
	self.lastEvent = state.eventActive
	self:tick()
end

function Hud:tick()
	local state = self.state
	if not state then return end
	local now = Workspace:GetServerTimeNow()
	local remaining = math.max(0, state.phaseEndsAt-now)
	self.timeLabel.Text = if state.phase == "Waiting" then "--:--" else timeString(remaining)
	local phase = if state.phase == "Playing" then string.format("ROUND %02d • COLLECT", state.roundId)
		elseif state.phase == "Intermission" then "GET READY • AUTO JOIN"
		elseif state.phase == "Results" then "ROUND COMPLETE" else "WAITING FOR BRAINS"
	self.phaseLabel.Text = phase .. (if state.fastMode then " • TEST" else "")
	self.timeLabel.TextColor3 = if state.phase == "Playing" and remaining &lt;= 15 then C.Pink else C.White
	if state.eventActive then
		self.eventLabel.Text = "LOW GRAVITY  /  " .. timeString(state.eventEndsAt-now)
		self.eventLabel.TextColor3 = C.Cyan
		self.eventPanel.BackgroundColor3 = Color3.fromRGB(64, 40, 111)
	else
		self.eventLabel.Text = if state.phase == "Playing" then "GRAB THE GLOW. TOP THE BOARD." else "NEXT ROUND IS AUTOMATIC. YOU'RE IN."
		self.eventLabel.TextColor3 = C.Muted
		self.eventPanel.BackgroundColor3 = C.Ink
	end
	self.resultNext.Text = "INTERMISSION IN " .. timeString(remaining) .. "  •  KEEP YOUR NEURONS WARM."
end

function Hud:notice(message)
	self.noticeToken += 1
	local token = self.noticeToken
	self.noticeLabel.Text = message
	self.noticePanel.Visible = true
	task.delay(3.5, function()
		if self.noticeToken == token then self.noticePanel.Visible = false end
	end)
end

function Hud:pulse()
	if self.reducedMotion then return end
	self.scoreScale.Scale = 1.16
	TweenService:Create(self.scoreScale, TweenInfo.new(.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

function Hud:destroy()
	for _, connection in self.connections do connection:Disconnect() end
	self.screen:Destroy()
end

return Hud
</ProtectedString>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="RBX000397">
          <Properties>
            <string name="Name">Main</string>
            <ProtectedString name="Source">--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local Config = require(ReplicatedStorage:WaitForChild("BrainrotShared"):WaitForChild("Config"))
local Hud = require(script.Parent.Hud)
local Effects = require(script.Parent.Effects)
local remotes = ReplicatedStorage:WaitForChild("BrainrotRemotes")
local stateRemote = remotes:WaitForChild("State") :: RemoteEvent
local pickupRemote = remotes:WaitForChild("Pickup") :: RemoteEvent
local requestRemote = remotes:WaitForChild("Request") :: RemoteEvent

local hud = Hud.new(Config, function(action: string)
	requestRemote:FireServer(action)
end)
local effects = Effects.new(hud, Config)
local connections: { RBXScriptConnection } = {}

table.insert(connections, stateRemote.OnClientEvent:Connect(function(state, notice)
	hud:update(state)
	effects:update(state)
	if typeof(notice) == "string" then hud:notice(notice) end
end))
table.insert(connections, pickupRemote.OnClientEvent:Connect(function(receipt)
	effects:pickup(receipt)
end))
local accumulator = 0
table.insert(connections, RunService.RenderStepped:Connect(function(dt)
	accumulator += dt
	if accumulator &gt;= .1 then
		accumulator = 0
		hud:tick()
	end
end))

-- Request AFTER listeners connect. Periodic server snapshots also recover missed joins.
requestRemote:FireServer("Snapshot")
task.spawn(function()
	for _ = 1, 5 do
		local ok = pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, false)
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
		end)
		if ok then break end
		task.wait(.5)
	end
end)

script.Destroying:Connect(function()
	for _, connection in connections do connection:Disconnect() end
	effects:destroy()
	hud:destroy()
end)
</ProtectedString>
            <bool name="Disabled">false</bool>
