        <Item class="ModuleScript" referent="RBX000889">
          <Properties>
            <string name="Name">Creatures</string>
            <ProtectedString name="Source">--!nonstrict
-- Original collectible cast — runtime builder.
--
-- Every slot shows one of six silly low-poly critters. The server only owns a
-- cell's rarity *value*; which variant a slot shows is derived here from its slot
-- id, so appearance can never feed back into scoring, claiming or respawn timing.
--
-- Geometry comes from the generated `CreatureData` table, which in turn comes from
-- tools/creatures.py — the same data the review plates are rendered from.
local CreatureData = require(script.Parent.CreatureData)

local Creatures = {}

local FIXED = {}
for role, rgb in CreatureData.Fixed do
	FIXED[role] = Color3.fromRGB(rgb[1], rgb[2], rgb[3])
end

local function tint(base, role)
	if role == "body" then
		return base
	elseif role == "body_light" then
		return base:Lerp(Color3.new(1, 1, 1), .24)
	elseif role == "body_dark" then
		return base:Lerp(Color3.new(.14, .16, .20), .40)
	elseif role == "neon" then
		return base
	end
	return FIXED[role] or base
end

local function makePart(spec)
	local part
	if spec.Shape == "WedgePart" then
		part = Instance.new("WedgePart")
	elseif spec.Shape == "Cylinder" then
		part = Instance.new("Part")
		part.Shape = Enum.PartType.Cylinder
	elseif spec.Shape == "Ball" then
		part = Instance.new("Part")
		part.Shape = Enum.PartType.Ball
	else
		part = Instance.new("Part")
		part.Shape = Enum.PartType.Block
	end
	part.Name = spec.Name
	part.Size = Vector3.new(spec.Size[1], spec.Size[2], spec.Size[3])
	part.Material = Enum.Material[spec.Material] or Enum.Material.SmoothPlastic
	part.Anchored = true
	part.CanCollide, part.CanTouch, part.CanQuery, part.CastShadow = false, false, false, false
	part.Massless = true
	part.CFrame = CFrame.new(spec.Offset[1], spec.Offset[2], spec.Offset[3])
		* CFrame.Angles(math.rad(spec.Rotation[1]), math.rad(spec.Rotation[2]), math.rad(spec.Rotation[3]))
	return part
end

-- Deterministic variant choice: the same slot always shows the same critter.
function Creatures.variantFor(slotId, value)
	local family = CreatureData.Family[value] or CreatureData.Family[1]
	return family[(slotId or 0) % #family + 1]
end

function Creatures.label(value)
	local family = CreatureData.Family[value] or CreatureData.Family[1]
	local spec = CreatureData.Creatures[family[1]]
	return spec and spec.Label or "BRAIN CELL"
end

-- Build the creature for `value` inside `model`.
-- Returns { name, parts } so the caller can recolour without rebuilding.
function Creatures.build(model, slotId, value, base)
	local name = Creatures.variantFor(slotId, value)
	local spec = CreatureData.Creatures[name]
	assert(spec, "Unknown creature variant: " .. tostring(name))
	local parts = {}
	for _, partSpec in spec.Parts do
		local part = makePart(partSpec)
		part.Color = tint(base, partSpec.Role)
		part.Parent = model
		table.insert(parts, part)
	end
	return { name = name, parts = parts }
end

function Creatures.recolour(view, base)
	if not view then
		return
	end
	local spec = CreatureData.Creatures[view.name]
	for index, part in view.parts do
		part.Color = tint(base, spec.Parts[index].Role)
	end
end

-- Shared hover ring: the one part every cell keeps, whatever its rarity.
function Creatures.halo(model)
	local spec = CreatureData.Halo
	local part = Instance.new("Part")
	part.Name = spec.Name
	part.Size = Vector3.new(spec.Size[1], spec.Size[2], spec.Size[3])
	part.Shape = Enum.PartType.Cylinder
	part.Material = Enum.Material[spec.Material] or Enum.Material.SmoothPlastic
	part.Color = Color3.new(1, 1, 1)
	part.Transparency = 1
	part.Anchored = true
	part.CanCollide, part.CanTouch, part.CanQuery, part.CastShadow = false, false, false, false
	part.Massless = true
	part.CFrame = CFrame.Angles(0, 0, math.pi / 2)
	part.Parent = model
	return part
end

return Creatures
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX000890">
          <Properties>
            <string name="Name">Effects</string>
            <ProtectedString name="Source">--!nonstrict
-- Lightweight local cosmetics. The server's invisible pickup positions never move.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Iconography = require(script.Parent.Iconography)
local Creatures = require(script.Parent.Creatures)
local CreatureData = require(script.Parent.CreatureData)
local Effects = {}
Effects.__index = Effects

local function fxPart(parent, name, size, color)
	local p = Instance.new("Part")
	p.Name, p.Size, p.Color = name, size, color
	p.Anchored = true
	p.CanCollide, p.CanTouch, p.CanQuery, p.CastShadow = false, false, false, false
	p.Material = Enum.Material.SmoothPlastic
	p.Parent = parent
	return p
end

function Effects.new(hud, config)
	local self = setmetatable({ hud = hud, config = config, visuals = {}, connections = {}, accumulator = 0, eventActive = false, lastTone = 0 }, Effects)
	self.folder = Instance.new("Folder")
	self.folder.Name = "BrainrotClientFX"
	self.folder.Parent = Workspace
	-- Owned by the client so the low-gravity pulse is purely local feedback.
	-- Saturation stays near neutral: the environment must never look washed out.
	self.tint = Instance.new("ColorCorrectionEffect")
	self.tint.Name = "BrainrotEventTint"
	self.tint.Parent = Lighting
	local pickups = Workspace:WaitForChild("BrainrotPickups")
	for _, child in pickups:GetChildren() do self:add(child) end
	table.insert(self.connections, pickups.ChildAdded:Connect(function(child) self:add(child) end))
	table.insert(self.connections, pickups.ChildRemoved:Connect(function(child) self:remove(child) end))
	table.insert(self.connections, RunService.RenderStepped:Connect(function(dt) self:step(dt) end))
	return self
end

function Effects:refresh(part)
	local view = self.visuals[part]
	if not view then return end
	view.active = part:GetAttribute("Active") == true
	local value = part:GetAttribute("Value") or 1
	local base = part.Color
	for _, kind in self.config.Kinds do
		if kind.Value == value then
			base = Color3.fromRGB(kind.Color[1], kind.Color[2], kind.Color[3])
			break
		end
	end
	self:syncCreature(view, value, base)
	local shown = view.active and view.near
	for _, item in view.creature.parts do
		item.Transparency = if shown then 0 else 1
	end
	-- One neutral self-lit ring per cell: guarantees separation from pale sand and
	-- stone without tinting the creature itself.
	view.halo.Transparency = if shown then .34 else 1
	view.halo.Color = Color3.new(1, 1, 1)
	Iconography.apply(view.marks, view.value, base, shown)
end

function Effects:add(part)
	if not part:IsA("BasePart") or self.visuals[part] then return end
	part.LocalTransparencyModifier = 1
	local slotId = part:GetAttribute("SlotId") or 0
	local model = Instance.new("Model")
	model.Name = "CellVisual_" .. tostring(slotId)
	local pivot = fxPart(model, "Pivot", Vector3.new(.1, .1, .1), part.Color)
	pivot.Transparency = 1
	pivot.CFrame = CFrame.new(part.Position)
	model.PrimaryPart = pivot
	local halo = Creatures.halo(model)
	local view = {
		model = model, pivot = pivot, halo = halo, slotId = slotId,
		creature = nil, value = 0, marks = nil,
		active = true, near = true, phase = slotId * .77,
	}
	model.Parent = self.folder
	self.visuals[part] = view
	view.connection = part.AttributeChanged:Connect(function() self:refresh(part) end)
	self:refresh(part)
end

-- Rebuild only when the rarity (and therefore the creature family) changes.
function Effects:syncCreature(view, value, base)
	if view.value ~= value or not view.creature then
		if view.creature then
			for _, item in view.creature.parts do item:Destroy() end
		end
		view.creature = Creatures.build(view.model, view.slotId, value, base)
		view.value = value
		if view.marks then
			for _, item in view.marks.parts do item:Destroy() end
		end
		view.marks = Iconography.marks(view.model, base, CreatureData.Mark[value] or "none")
		Iconography.apply(view.marks, value, base, view.active and view.near)
	else
		Creatures.recolour(view.creature, base)
	end
end

function Effects:remove(part)
	local view = self.visuals[part]
	if not view then return end
	view.connection:Disconnect()
	view.model:Destroy()
	self.visuals[part] = nil
end

function Effects:step(dt)
	self.accumulator += dt
	if self.accumulator &lt; 1/30 then return end
	self.accumulator = 0
	local camera = Workspace.CurrentCamera
	if not camera then return end
	local now = Workspace:GetServerTimeNow()
	local reduced = self.hud.reducedMotion
	local eye = camera.CFrame.Position
	for part, view in self.visuals do
		local near = (part.Position - eye).Magnitude &lt; 150
		if view.near ~= near then
			view.near = near
			self:refresh(part)
		end
		if view.active and near then
			local phase = now + view.phase
			local hover = if reduced then 0 else math.sin(phase * 1.9) * .24
			local spin = if reduced then 0 else (phase * .55) % (math.pi * 2)
			-- Rare cells breathe a little more so value reads before the player is close.
		local flourish = if reduced or view.value == 1 then 0
				else math.sin(phase * 2.6) * (if view.value == 10 then .07 else .04)
			local tilt = if reduced then 0 else math.sin(phase * 1.1) * .05
			-- Rare cells breathe: the ring tells you it is worth more before you read it.
			if view.value &gt; 1 then
				view.halo.Transparency = .26 + math.sin(phase * 3.1) * .1
			end
			view.model:PivotTo(
				CFrame.new(part.Position + Vector3.new(0, hover, 0))
					* CFrame.Angles(tilt, spin, 0)
					* CFrame.new(0, flourish, 0)
			)
		end
	end
end

function Effects:update(state)
	if state.eventActive == self.eventActive then return end
	self.eventActive = state.eventActive
	local properties = {
		TintColor = if state.eventActive then Color3.fromRGB(236, 246, 255) else Color3.new(1, 1, 1),
		Saturation = if state.eventActive then .05 else 0,
		Brightness = if state.eventActive then .02 else 0,
	}
	if self.hud.reducedMotion then
		for key, value in properties do self.tint[key] = value end
	else
		TweenService:Create(self.tint, TweenInfo.new(.6), properties):Play()
	end
end

function Effects:pickup(receipt)
	local own = receipt.userId == Players.LocalPlayer.UserId
	local pos = Vector3.new(receipt.position.x, receipt.position.y, receipt.position.z)
	local color = self.config.Kinds[receipt.kindIndex].Color
	local tint = Color3.fromRGB(color[1], color[2], color[3])
	if own then
		self.hud:pulse()
		local now = os.clock()
		if self.hud.soundOn and now-self.lastTone &gt; .07 then
			self.lastTone = now
			local sound = Instance.new("Sound")
			sound.Name = "CellChime"
			-- Roblox's bundled short tone; no uploaded or third-party sound assets required.
			sound.SoundId = "rbxasset://sounds/electronicpingshort.wav"
			sound.Volume = .2
			sound.PlaybackSpeed = .95 + receipt.kindIndex*.12
			sound.Parent = SoundService
			sound:Play()
			Debris:AddItem(sound, 3)
		end
		local anchor = fxPart(self.folder, "ScorePopup", Vector3.new(.1, .1, .1), tint)
		anchor.Position, anchor.Transparency = pos+Vector3.new(0, 2, 0), 1
		local gui = Instance.new("BillboardGui")
		gui.Size, gui.AlwaysOnTop, gui.MaxDistance = UDim2.fromOffset(100, 50), true, 100
		gui.Parent = anchor
		local label = Instance.new("TextLabel")
		label.Size, label.BackgroundTransparency = UDim2.fromScale(1, 1), 1
		label.Text, label.TextColor3 = "+" .. receipt.value, tint
		label.Font, label.TextSize, label.TextStrokeTransparency = Enum.Font.GothamBlack, 32, .6
		label.Parent = gui
		TweenService:Create(anchor, TweenInfo.new(.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = anchor.Position+Vector3.new(0, 2.8, 0) }):Play()
		TweenService:Create(label, TweenInfo.new(.7), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		Debris:AddItem(anchor, .8)
	end
	local camera = Workspace.CurrentCamera
	if self.hud.reducedMotion or not camera or (camera.CFrame.Position-pos).Magnitude &gt; 100 then return end
	for i = 1, 7 do
		local spark = fxPart(self.folder, "Spark", Vector3.new(.3, .3, .3), tint)
		spark.Shape, spark.Material, spark.Position = Enum.PartType.Ball, Enum.Material.Neon, pos
		local angle = i*math.pi*2/7
		local target = pos + Vector3.new(math.cos(angle)*2.2, 1.5+(i%3)*.6, math.sin(angle)*2.2)
		TweenService:Create(spark, TweenInfo.new(.42, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = target, Size = Vector3.new(.05, .05, .05), Transparency = 1 }):Play()
		Debris:AddItem(spark, .5)
	end
end

function Effects:destroy()
	for _, connection in self.connections do connection:Disconnect() end
	local parts = {}
	for part in self.visuals do table.insert(parts, part) end
	for _, part in parts do self:remove(part) end
	self.folder:Destroy()
	self.tint:Destroy()
end

return Effects
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX000891">
          <Properties>
            <string name="Name">Hud</string>
            <ProtectedString name="Source">--!nonstrict
-- The interface. Every value shown here arrives in a server snapshot; nothing is
-- invented locally. Layout is responsive (desktop / tablet / phone portrait and
-- landscape) and every button opens a real panel or sends a whitelisted request.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)
local Panels = require(script.Parent.Panels)
local Iconography = require(script.Parent.Iconography)
local CreatureData = require(script.Parent.CreatureData)
local Hud = {}
Hud.__index = Hud

local C, Type, Space, Motion, Copy = Theme.Colors, Theme.Type, Theme.Space, Theme.Motion, Theme.Copy

local function timeString(remaining)
	local seconds = math.max(0, math.ceil(remaining))
	return string.format("%02d:%02d", math.floor(seconds / 60), seconds % 60)
end

local function phaseWord(phase, fastMode)
	if phase == "Playing" then
		return Copy.PlayingStatus
	elseif phase == "Intermission" then
		return Copy.IntermissionStatus
	elseif phase == "Results" then
		return Copy.ResultsStatus
	end
	return Copy.WaitingStatus
end

function Hud.new(config, request)
	local self = setmetatable({}, Hud)
	self.config, self.request = config, request
	self.soundOn, self.reducedMotion = true, false
	self.state, self.rows, self.connections = nil, {}, {}
	self.noticeToken, self.noticeSerial = 0, 0
	self.lastPhase, self.lastEvent = "", false
	self.modalKind = nil
	self.userId = Players.LocalPlayer.UserId

	self.screen = Kit.instance("ScreenGui", {
		Name = "BrainrotHUD",
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 10,
		ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
	}, Players.LocalPlayer:WaitForChild("PlayerGui"))
	self.root = Kit.instance("Frame", {
		Name = "SafeArea", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
	}, self.screen)
	-- Scrims are built after `root` exists; declared here so resize() can see them.

	-- ---- legibility scrims (never interactive) ------------------------------
	-- The world is bright; a soft navy wash at the top and bottom keeps translucent
	-- panels readable without dimming the play space in the middle of the screen.
	self.scrimTop = Kit.scrim(self.root, 170, true, { zIndex = 0 })
	self.scrimBottom = Kit.scrim(self.root, 130, false, { zIndex = 0 })

	-- ---- top HUD: brand, brain cells, round timer, coins --------------------
	self.top = Panels.topHud(self.root)

	-- ---- leaderboard (right) ----------------------------------------------
	self.board = Panels.leaderboard(self.root)
	self.boardVisible = true
	self.ranksTouched = false

	-- ---- bottom action bar: shop / inventory / settings --------------------
	self.actions = Panels.actionBar(self.root, {
		Shop = function() self:showModal("Shop") end,
		Inventory = function() self:showModal("Inventory") end,
		Settings = function() self:showModal("Settings") end,
	})

	-- ---- centre messaging --------------------------------------------------
	self.toast = Panels.toast(self.root)
	self.event = Panels.eventBanner(self.root)
	self.lobby = Panels.lobbyBanner(self.root)

	-- ---- rarity key above the action bar -----------------------------------
	self.legend = Kit.panel(self.root, "RarityKey", UDim2.fromOffset(368, 26), UDim2.new(.5, 0, 1, -Space.lg - 52 - 32), {
		anchor = Vector2.new(.5, 0), radius = 10, transparency = .3, zIndex = 2,
	})
	for index, entry in { { "+1  BRAIN / FROG", C.Cyan, 1 }, { "+5  FISH / GOOSE", C.Amber, 5 }, { "+10  TOAST / SOCK", C.Violet, 10 } } do
		local slot = Kit.instance("Frame", {
			Name = "Rarity" .. index,
			Size = UDim2.fromOffset(120, 26),
			Position = UDim2.fromOffset(6 + (index - 1) * 120, 0),
			BackgroundTransparency = 1,
			ZIndex = 3,
		}, self.legend)
		local label = Kit.text(slot, "Label", entry[1], "Micro", {
			size = UDim2.new(1, -24, 1, 0), position = UDim2.fromOffset(22, 0),
			color = entry[2], truncate = true, zIndex = 4,
		})
		label.Font = Enum.Font.GothamMedium
		Iconography.glyph(slot, entry[3], entry[2]).Position = UDim2.fromOffset(3, 5)
	end

	-- ---- results card ------------------------------------------------------
	self.results = Kit.panel(self.root, "Results", UDim2.fromOffset(468, 268), UDim2.fromScale(.5, .44), {
		anchor = Vector2.new(.5, .5), zIndex = 8, visible = false, padding = Space.xl,
	})
	Kit.text(self.results, "Eyebrow", Copy.ResultsStatus, "Label", {
		size = UDim2.new(1, 0, 0, 16), color = C.Cyan, xAlign = Enum.TextXAlignment.Center,
	})
	self.resultTitle = Kit.text(self.results, "Title", Copy.WinBanner, "Display", {
		size = UDim2.new(1, 0, 0, 44), position = UDim2.fromOffset(0, 22),
		color = C.Amber, xAlign = Enum.TextXAlignment.Center, truncate = true,
	})
	self.resultName = Kit.text(self.results, "Winner", "", "Heading", {
		size = UDim2.new(1, 0, 0, 52), position = UDim2.fromOffset(0, 70),
		color = C.White, xAlign = Enum.TextXAlignment.Center, wrapped = true,
	})
	self.resultCast = Kit.text(self.results, "Cast", "", "Micro", {
		size = UDim2.new(1, 0, 0, 14), position = UDim2.fromOffset(0, 124),
		color = C.Dim, xAlign = Enum.TextXAlignment.Center, truncate = true,
	})
	Kit.divider(self.results, 146, Space.xl)
	self.resultReward = Kit.text(self.results, "Reward", "", "Title", {
		size = UDim2.new(1, 0, 0, 30), position = UDim2.fromOffset(0, 158),
		color = C.Amber, xAlign = Enum.TextXAlignment.Center,
	})
	self.resultNext = Kit.text(self.results, "Next", "", "Micro", {
		size = UDim2.new(1, 0, 0, 30), position = UDim2.fromOffset(0, 196),
		color = C.Muted, xAlign = Enum.TextXAlignment.Center, wrapped = true,
	})

	-- ---- modal: shop / inventory / settings / help --------------------------
	self.modal = Kit.instance("Frame", {
		Name = "ModalLayer", Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.Void,
		BackgroundTransparency = .35, Visible = false, ZIndex = 20, Active = true,
	}, self.root)
	self.modalCard = Kit.panel(self.modal, "Card", UDim2.fromOffset(468, 348), UDim2.fromScale(.5, .5), {
		anchor = Vector2.new(.5, .5), zIndex = 21, padding = Space.xl,
	})
	self.modalTitle = Kit.text(self.modalCard, "Title", Copy.ShopTitle, "Title", {
		size = UDim2.new(1, -60, 0, 26), color = C.Amber, zIndex = 22,
	})
	self.modalBody = Kit.text(self.modalCard, "Body", "", "Body", {
		size = UDim2.new(1, 0, 1, -120), position = UDim2.fromOffset(0, 34),
		color = C.White, wrapped = true, zIndex = 22,
	})
	self.modalBody.TextYAlignment = Enum.TextYAlignment.Top
	self.modalFocus = nil
	self.modalPrimary = Kit.button(self.modalCard, "Action", "UNLOCK", UDim2.new(1, -56, 0, 44),
		UDim2.new(0, 0, 1, -44), function() self:activateModal() end,
		{ accent = C.Amber, zIndex = 22 })
	self.modalSound = Kit.button(self.modalCard, "ModalSound", "SFX ON", UDim2.fromOffset(110, 34),
		UDim2.new(0, 0, 1, -88), function() self:toggleSound() end, { accent = C.Cyan, zIndex = 22 })
	self.modalMotion = Kit.button(self.modalCard, "ModalMotion", "MOTION: FULL", UDim2.fromOffset(132, 34),
		UDim2.new(0, 118, 1, -88), function() self:toggleMotion() end, { accent = C.Violet, zIndex = 22 })
	self.modalClose = Kit.button(self.modalCard, "Close", "X", UDim2.fromOffset(36, 36),
		UDim2.new(1, -36, 0, 0), function() self:closeModal() end, { accent = C.NavyEdge, zIndex = 22 })
	self.modalClose.Label.TextSize = Type.Body

	-- ---- persistent secondary buttons -------------------------------------
	self.helpButton = Kit.button(self.root, "Help", "?", UDim2.fromOffset(36, 36),
		UDim2.fromOffset(Space.xl, 148), function() self:showModal("Help") end,
		{ accent = C.Cyan, zIndex = 3 })
	self.ranksButton = Kit.button(self.root, "Ranks", "RANKS", UDim2.fromOffset(84, 32),
		UDim2.new(1, -Space.lg - 84, 0, 128), function() self:toggleBoard() end,
		{ accent = C.Violet, zIndex = 3 })

	-- ---- input -------------------------------------------------------------
	self.modal.Parent = self.root
	self.ranksButton.Activated:Connect(function() self.ranksTouched = true end)
	table.insert(self.connections, UserInputService.InputBegan:Connect(function(input, processed)
		if processed or UserInputService:GetFocusedTextBox() then return end
		if input.KeyCode == Enum.KeyCode.Tab then
			self:toggleBoard()
			self.ranksTouched = true
		elseif input.KeyCode == Enum.KeyCode.H then
			if self.modal.Visible then self:closeModal() else self:showModal("Help") end
		elseif input.KeyCode == Enum.KeyCode.Escape and self.modal.Visible then
			self:closeModal()
		elseif input.KeyCode == Enum.KeyCode.B then
			self:showModal("Shop")
		end
	end))
	table.insert(self.connections, self.root:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		self:resize()
	end))
	self:resize()
	return self
end

-- --------------------------------------------------------------------------- #
-- Layout
-- --------------------------------------------------------------------------- #
function Hud:resize()
	local size = self.root.AbsoluteSize
	local width, height = size.X, size.Y
	if width &lt; 1 or height &lt; 1 then return end
	local compact = width &lt; 780
	local short = height &lt; 520
	local portrait = width &lt; height
	self.compact, self.short, self.portrait = compact, short, portrait

	local top = self.top
	self.scrimTop.Size = UDim2.new(1, 0, 0, math.min(190, math.max(120, height * .26)))
	self.scrimBottom.Size = UDim2.new(1, 0, 0, math.min(150, math.max(100, height * .2)))
	self.scrimBottom.Position = UDim2.new(0, 0, 1, -self.scrimBottom.Size.Y.Offset)
	-- brand
	top.brand.Visible = not compact and not short
	top.brand.Position = UDim2.fromOffset(Space.xl, Space.lg)

	-- brain-cell counter: under the brand on desktop, top-left on compact
	top.cells.Size = UDim2.fromOffset(if compact then 128 else 196, if short then 44 else 52)
	top.cells.Position = if compact then UDim2.fromOffset(Space.md, Space.md)
		else UDim2.fromOffset(Space.xl, 78)

	-- round clock: always centred at the top, shrinks on phones
	-- The clock keeps its centre line; on phones it narrows so the RANKS chip never
	-- collides with it. 132px is the floor where "00:00" still reads cleanly.
	local clockWidth = math.clamp(width - 340, 150, 212)
	if compact then clockWidth = math.clamp(width - 368, 96, 190) end
	top.clock.Size = UDim2.fromOffset(clockWidth, if short then 62 else 76)
	top.clock.Position = UDim2.new(.5, 0, 0, if short then Space.sm else Space.lg)
	top.time.TextSize = if short then 26 elseif compact then 30 else Type.Display
	top.roundLabel.Visible = not short
	top.divider.Visible = not short

	-- coin counter: top-right, never overlapping the clock
	top.coins.Size = UDim2.fromOffset(if compact then 112 else 152, if short then 44 else 52)
	top.coins.Position = UDim2.new(1, -Space.md, 0, if compact then Space.sm else Space.lg)
	top.coinValue.TextSize = if compact then 18 else Type.Title
	top.coinValue.Size = UDim2.new(1, -40, 0, 24)

	-- leaderboard
	local board = self.board
	board.board.Visible = self:boardShown()
	board.board.Size = UDim2.fromOffset(if compact then 196 else 232,
		math.clamp(height - (if compact then 190 else 230), 150, 320))
	board.board.Position = UDim2.new(1, -Space.md, 0, if compact then 118 else 162)
	self.ranksButton.Visible = compact or short
	-- On short landscape screens the RANKS chip moves up, clear of the toast band.
	self.ranksButton.Position = UDim2.new(1, -Space.md - 84, 0, if short then 40 elseif compact then 74 else 128)
	self.ranksButton.Size = UDim2.fromOffset(if compact then 68 else 84, 32)

	-- Action bar. On phones it sits above the thumbstick and jump zones so a tap on
	-- the shop never registers as a jump; on desktop it hugs the bottom edge.
	local barLift = if compact then 118 else Space.lg
	self.actions.bar.Position = UDim2.new(.5, 0, 1, -barLift - 52)
	self.actions.bar.Visible = true
	for _, name in { "Shop", "Inventory", "Settings" } do
		local button = self.actions.buttons[name]
		button.Size = UDim2.fromOffset(if compact then 76 else 84, 52)
		button.Position = UDim2.fromOffset(
			(if name == "Shop" then 0 elseif name == "Inventory" then (if compact then 84 else 92) else (if compact then 168 else 184)),
			0)
	end
	self.actions.bar.Size = UDim2.fromOffset(if compact then 252 else 268, 52)
	self.legend.Visible = not compact and not short
	self.legend.Position = UDim2.new(.5, 0, 1, -barLift - 52 - 32)

	-- help button sits above the action bar on phones, beside it on desktop
	self.helpButton.Position = if compact then UDim2.new(0, Space.md, 0, 74) else UDim2.fromOffset(Space.xl, 136)

	-- toasts and banners
	self.toast.frame.Size = UDim2.fromOffset(math.min(width - 32, 432), 56)
	self.toast.frame.Position = UDim2.new(.5, 0, 0, if short then 84 else 112)
	self.event.frame.Size = UDim2.fromOffset(math.min(width - 40, 320), 34)
	self.event.frame.Position = UDim2.new(.5, 0, 0, if short then 146 else 174)
	self.lobby.frame.Size = UDim2.fromOffset(math.min(width - 32, 420), 92)
	self.lobby.frame.Position = UDim2.new(.5, 0, 0, if short then 186 else 236)

	-- cards
	self.results.Size = UDim2.fromOffset(math.min(width - 32, 468), math.min(height - 32, 268))
	self.resultTitle.TextSize = if compact then 24 else Type.Display
	self.modalCard.Size = UDim2.fromOffset(math.min(width - 28, 468), math.min(height - 24, 348))
	self.modalPrimary.Size = UDim2.new(1, -56, 0, 44)
	self.modalBody.TextSize = if short then 12 elseif compact then 13 else Type.Body
	self.modalTitle.TextSize = if compact then 18 else Type.Title

	if self.state then self:updateLocalValues() end
end

-- True when the leaderboard is actually on screen for this viewport.
function Hud:boardShown()
	return self.boardVisible and not (self.compact and not self.ranksTouched)
end

function Hud:toggleBoard()
	self.boardVisible = not self.boardVisible
	self.board.board.Visible = self.boardVisible
end

-- --------------------------------------------------------------------------- #
-- Server state
-- --------------------------------------------------------------------------- #
function Hud:update(state)
	self.state = state
	self.localRow = nil
	-- The server sends rows in rank order; sort defensively so a stale snapshot can
	-- never show a lower score above a higher one.
	local ordered = table.clone(state.rows)
	table.sort(ordered, function(a, b)
		if a.score ~= b.score then return a.score &gt; b.score end
		return a.name &lt; b.name
	end)
	local found = {}
	for index, row in ordered do
		found[row.id] = true
		if row.id == self.userId then self.localRow = row end
		local view = self.rows[row.id]
		if not view then
			view = Panels.row(self.board.roster, row.id, index)
			self.rows[row.id] = view
		end
		local mine = row.id == self.userId
		view.frame.LayoutOrder = index
		view.frame.BackgroundColor3 = if mine then C.NavyRaised else C.Navy
		view.frame.BackgroundTransparency = if mine then .05 else .4
		view.accent.BackgroundColor3 = if index == 1 then C.Amber else (if mine then C.Cyan else C.NavyEdge)
		view.accent.BackgroundTransparency = if index == 1 or mine then 0 else .5
		view.rank.Text = string.format("%02d", index)
		view.rank.TextColor3 = if index == 1 then C.Amber else C.Dim
		view.name.Text = row.name .. (if mine then "  • you" else "")
		view.score.Text = tostring(row.score)
		view.score.TextColor3 = if index == 1 then C.Amber else C.Cyan
	end
	for id, view in self.rows do
		if not found[id] then
			view.frame:Destroy()
			self.rows[id] = nil
		end
	end
	self:updateLocalValues()
	self:updateResults(state)
	self:updateBanners(state)
	self:tick()
end

function Hud:updateLocalValues()
	local row = self.localRow
	local cells = if row then row.score else 0
	local coins = if row then row.coins else 0
	self.top.cellValue.Text = tostring(cells)
	self.top.coinValue.Text = tostring(coins)
	if self.state then
		-- On phones the clock is narrow: the round number alone still fits.
		local round = string.format("ROUND %02d", self.state.roundId or 0)
		self.top.roundLabel.Text = if self.compact then round
			else round .. "  •  " .. (if self.state.fastMode then "QUICK TEST" else self.config.ArenaName)
	end
	if self.modal.Visible then
		self:refreshModal()
	end
end

function Hud:updateResults(state)
	local showing = state.phase == "Results" and state.results ~= nil
	if showing ~= self.results.Visible then
		self.results.Visible = showing
		if showing then
			Kit.enter(self.results, { reducedMotion = self.reducedMotion, rise = 16 })
		end
	end
	if not showing then
		return
	end
	local results = state.results
	local winners = results.winners
	if #winners == 0 then
		self.resultTitle.Text = Copy.NoScoreBanner
		self.resultName.Text = "No cells collected this time.\nThe next round is yours."
	elseif #winners == 1 then
		self.resultTitle.Text = Copy.WinBanner
		self.resultName.Text = winners[1].name .. " wins!\n" .. results.topScore .. " brain cells"
	else
		self.resultTitle.Text = Copy.TieBanner
		local names = {}
		for index, row in winners do
			if index &lt;= 3 then table.insert(names, row.name) end
		end
		self.resultName.Text = table.concat(names, ", ") .. (if #winners &gt; 3 then " + more" else "")
			.. "\nTied at " .. results.topScore .. " cells"
	end
	self.resultCast.Text = self:castLine(results.roundId)
	local reward = results.rewards[tostring(self.userId)] or 0
	self.resultReward.Text = if reward &gt; 0 then "+" .. reward .. " COINS" else "NEXT ROUND SOON"
end

function Hud:updateBanners(state)
	self.lobby.frame.Visible = state.phase ~= "Playing"
	if self.lobby.frame.Visible then
		local remaining = math.max(0, (state.phaseEndsAt or 0) - Workspace:GetServerTimeNow())
		self.lobby.status.Text = phaseWord(state.phase, state.fastMode)
		self.lobby.status.TextColor3 = if state.phase == "Results" then C.Amber else C.Cyan
		if state.phase == "Intermission" then
			self.lobby.countdown.Text = "ARENA OPENS IN " .. timeString(remaining)
		elseif state.phase == "Results" then
			self.lobby.countdown.Text = "NEXT ROUND IN " .. timeString(remaining)
		else
			self.lobby.countdown.Text = "WAITING FOR THE FIRST PLAYER"
		end
	end
	if state.eventActive then
		self.event.frame.Visible = true
		self.event.label.Text = Copy.EventBanner .. "  •  " .. timeString(state.eventEndsAt - Workspace:GetServerTimeNow())
		self.event.dot.BackgroundColor3 = C.Cyan
	else
		self.event.frame.Visible = false
	end
end

function Hud:tick()
	local state = self.state
	if not state then return end
	local now = Workspace:GetServerTimeNow()
	local remaining = math.max(0, (state.phaseEndsAt or 0) - now)
	self.top.time.Text = if state.phase == "Waiting" then "--:--" else timeString(remaining)
	self.top.time.TextColor3 = if state.phase == "Playing" and remaining &lt;= 15 then C.Danger else C.White
	self.top.phase.Text = phaseWord(state.phase, state.fastMode)
	self.top.phase.TextColor3 = if state.phase == "Playing" then C.Cyan
		elseif state.phase == "Results" then C.Amber else C.Violet
	self:updateBanners(state)
	if self.lobby.frame.Visible then
		if state.phase == "Intermission" then
			self.lobby.countdown.Text = "ARENA OPENS IN " .. timeString(remaining)
		elseif state.phase == "Results" then
			self.lobby.countdown.Text = "NEXT ROUND IN " .. timeString(remaining)
		end
	end
	if state.eventActive then
		self.event.label.Text = Copy.EventBanner .. "  •  " .. timeString(state.eventEndsAt - now)
	end
	if self.results.Visible then
		self.resultNext.Text = "INTERMISSION IN " .. timeString(remaining)
	end
end

-- --------------------------------------------------------------------------- #
-- Toast
-- --------------------------------------------------------------------------- #
function Hud:notice(message, accent)
	self.noticeToken += 1
	local token = self.noticeToken
	self.toast.label.Text = message
	self.toast.accent.BackgroundColor3 = accent or C.Cyan
	self.toast.frame.Visible = true
	Kit.enter(self.toast.frame, { reducedMotion = self.reducedMotion, rise = 10, duration = Motion.Toast })
	task.delay(Motion.Notice, function()
		if self.noticeToken == token then
			self.toast.frame.Visible = false
		end
	end)
end

function Hud:pulse()
	if self.reducedMotion then return end
	self.top.cellScale.Scale = 1.14
	TweenService:Create(self.top.cellScale, TweenInfo.new(Motion.Fast, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Scale = 1,
	}):Play()
end

-- --------------------------------------------------------------------------- #
-- Shop / inventory / settings / help
-- --------------------------------------------------------------------------- #
function Hud:showModal(kind)
	self.modalKind = kind
	self.modal.Visible = true
	self:refreshModal()
end

function Hud:closeModal()
	self.modal.Visible = false
	self.modalKind = nil
end

function Hud:refreshModal()
	local kind = self.modalKind
	local row = self.localRow
	local owned = row and row.haloOwned
	local equipped = row and row.haloEquipped
	local coins = if row then row.coins else 0
	if kind == "Shop" then
		self.modalTitle.Text = Copy.ShopTitle
		self.modalTitle.TextColor3 = C.Amber
		self.modalBody.Text = Copy.ShopBody .. "\n\nPULSE HALO — " .. self.config.HaloCost .. " session coins."
			.. "\n\nBalance: " .. coins .. " coins."
			.. (if owned then "\n\nYou already own this glow for the session." else "")
		self.modalPrimary.Label.Text = if owned then (if equipped then "UNEQUIP" else "EQUIP") else "UNLOCK  •  " .. self.config.HaloCost
		self.modalPrimary.Visible = true
	elseif kind == "Inventory" then
		self.modalTitle.Text = Copy.InventoryTitle
		self.modalTitle.TextColor3 = C.Cyan
		local lines = {}
		if row then
			table.insert(lines, string.format("ROUND SCORE      %d", row.score))
			table.insert(lines, string.format("ROUNDS WON      %d", row.wins))
			table.insert(lines, string.format("CELLS CLAIMED   %d", row.pickups))
			table.insert(lines, string.format("SESSION COINS   %d", row.coins))
			table.insert(lines, "")
			if owned then
				table.insert(lines, "PULSE HALO      " .. (if equipped then "EQUIPPED" else "OWNED"))
			else
				table.insert(lines, "PULSE HALO      NOT OWNED")
			end
		else
			table.insert(lines, Copy.InventoryEmpty)
		end
		self.modalBody.Text = table.concat(lines, "\n")
		self.modalPrimary.Visible = owned
		self.modalPrimary.Label.Text = if equipped then "UNEQUIP" else "EQUIP"
	elseif kind == "Settings" then
		self.modalTitle.Text = Copy.SettingsTitle
		self.modalTitle.TextColor3 = C.Violet
		self.modalBody.Text = "Sound effects: " .. (if self.soundOn then "ON" else "OFF")
			.. "\nMotion: " .. (if self.reducedMotion then "REDUCED" else "FULL")
			.. "\n\nREDUCED MOTION turns off camera-shaking effects, halo breathing and\npanel transitions. It never changes gameplay."
		self.modalPrimary.Visible = false
	else
		self.modalTitle.Text = "HOW TO PLAY"
		self.modalTitle.TextColor3 = C.Cyan
		self.modalBody.Text = "01   COLLECT THE CAST\nBrain or frog +1  •  fish or goose +5  •  toast or sock +10"
			.. "\n\n02   KEEP YOUR COOL\nLow gravity hits mid-round. Fall? You respawn in the arena with your score."
			.. "\n\n03   BE THE BIGGEST BRAIN\nMost cells wins. Ties share the crown. Rounds start automatically."
		self.modalPrimary.Visible = false
	end
	self.modalSound.Label.Text = if self.soundOn then "SFX ON" else "SFX OFF"
	self.modalMotion.Label.Text = if self.reducedMotion then "REDUCED MOTION: ON" else "MOTION: FULL"
end

function Hud:activateModal()
	local kind = self.modalKind
	if kind == "Shop" or kind == "Inventory" then
		-- The only cosmetic verb the server accepts. Ownership is decided server-side.
		self.request("Halo")
	end
end

function Hud:toggleSound()
	self.soundOn = not self.soundOn
	self:refreshModal()
end

function Hud:toggleMotion()
	self.reducedMotion = not self.reducedMotion
	self:refreshModal()
end

-- Deterministic flavour line, chosen from the round id only. No gameplay meaning.
function Hud:castLine(roundId)
	local round = math.max(1, math.floor(tonumber(roundId) or 1))
	local value = if round % 3 == 0 then 10 elseif round % 3 == 1 then 1 else 5
	local family = CreatureData.Family[value]
	local spec = CreatureData.Creatures[family[(round % 2) + 1]]
	return spec.Label .. "  •  " .. spec.Blurb
end

function Hud:destroy()
	for _, connection in self.connections do connection:Disconnect() end
	self.screen:Destroy()
end

return Hud
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX000892">
          <Properties>
            <string name="Name">Iconography</string>
            <ProtectedString name="Source">--!nonstrict
-- Procedural recognisability layer.
--
-- Every gameplay object keeps a unique silhouette *in addition to* its colour, so
-- the redesign stays readable for colour-blind players and on washed-out phone
-- screens:
--   pink  +1  -&gt; critter only (no extra parts)
--   gold  +5  -&gt; critter plus one floating ring
--   prism +10 -&gt; critter plus two crossed arms
-- Built from part/UI primitives only; no images, decals or asset IDs.
local Iconography = {}

local KIND_ORDER = { 1, 5, 10 }        -- value -&gt; silhouette index

local KINDS = {}
for index, value in KIND_ORDER do
	KINDS[value] = index
end

-- Rarity marks sit *outside* the creature silhouette so the critter stays legible:
--   gold  +5  -&gt; one floating ring above the head (single part, Neon)
--   prism +10 -&gt; two crossed arms in front of the chest (two parts, Neon)
-- Only rarer cells pay for these parts; +1 cells cost nothing.
local MARK_LAYOUT = {
	Crown = { Size = Vector3.new(.10, .74, .74), Node = Vector3.new(0, 1.12, 0), Pitch = 0,
		Name = "MarkCrown", Shape = Enum.PartType.Cylinder },
	ArmX = { Size = Vector3.new(.12, .12, .92), Node = Vector3.new(0, -.06, .62), Pitch = math.rad(38),
		Name = "MarkArm", Shape = Enum.PartType.Block },
	ArmZ = { Size = Vector3.new(.92, .12, .12), Node = Vector3.new(0, -.06, .62), Pitch = -math.rad(38),
		Name = "MarkArm", Shape = Enum.PartType.Block },
}

-- A mark handle. No parts are created here; `apply` allocates on demand.
function Iconography.marks(model, color, kind)
	return { model = model, color = color, kind = kind or "none", parts = {} }
end

local function ensure(marks, key, color)
	local existing = marks.parts[key]
	if existing then
		existing.Color = color
		return existing
	end
	local layout = MARK_LAYOUT[key]
	local part = Instance.new("Part")
	part.Name, part.Size, part.Shape = layout.Name, layout.Size, layout.Shape
	part.Material = Enum.Material.Neon
	part.Color = color
	part.CFrame = CFrame.new(layout.Node) * CFrame.Angles(0, 0, layout.Pitch)
	if key == "Crown" then
		-- Roblox cylinders are X-axis; lay it flat so it reads as a ring.
		part.CFrame = CFrame.new(layout.Node) * CFrame.Angles(0, 0, math.pi / 2)
	end
	part.Anchored = true
	part.CanCollide, part.CanTouch, part.CanQuery, part.CastShadow = false, false, false, false
	part.Massless = true
	part.Transparency = 1
	part.Parent = marks.model
	marks.parts[key] = part
	return part
end

-- Show only the marks belonging to `value`.
function Iconography.apply(marks, value, color, visible)
	if not marks then
		return
	end
	local kind = marks.kind or "none"
	local shown = visible == true
	if kind == "crown" then
		ensure(marks, "Crown", color)
	elseif kind == "arms" then
		ensure(marks, "ArmX", color)
		ensure(marks, "ArmZ", color)
	end
	for key, part in marks.parts do
		local active = (kind == "crown" and key == "Crown")
			or (kind == "arms" and (key == "ArmX" or key == "ArmZ"))
		part.Transparency = if shown and active then 0 else 1
	end
end

-- ---------------------------------------------------------------------------
-- HUD helper: a small glyph mirroring the in-world silhouette, for the rarity key
-- and reward rows. Parent must be a Frame.
-- ---------------------------------------------------------------------------
function Iconography.glyph(parent, value, color)
	local index = KINDS[value] or 1
	local box = Instance.new("Frame")
	box.Name = "Glyph_" .. tostring(value)
	box.Size = UDim2.fromOffset(18, 18)
	box.BackgroundTransparency = 1
	box.Parent = parent

	local function square(name, size, position, hex)
		local frame = Instance.new("Frame")
		frame.Name = name
		frame.Size = UDim2.fromOffset(size, size)
		frame.Position = UDim2.fromOffset(position[1], position[2])
		frame.BackgroundColor3 = color
		frame.BorderSizePixel = 0
		frame.Parent = box
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, hex and 0 or size)
		corner.Parent = frame
		return frame
	end

	-- All three glyphs share a round base dot; the extra mark disambiguates them.
	square("Base", 8, { 5, 5 }, false)
	if index == 2 then
		square("TipTop", 5, { 6, -1 }, true)
		square("TipBottom", 5, { 6, 14 }, true)
	elseif index == 3 then
		square("ArmUp", 4, { 7, -1 }, true)
		square("ArmDown", 4, { 7, 15 }, true)
		square("ArmLeft", 4, { -1, 7 }, true)
		square("ArmRight", 4, { 15, 7 }, true)
	end
	return box
end

return Iconography
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX000893">
          <Properties>
            <string name="Name">Kit</string>
            <ProtectedString name="Source">--!nonstrict
-- UI kit: the only place that constructs HUD primitives.
--
-- Every panel in the interface comes from `Kit.panel`, `Kit.button`, `Kit.text`
-- and friends, so the design system in `Theme` (generated from tools/ui.py) is
-- actually enforced instead of being a suggestion. No images, no asset ids, no
-- uploaded fonts: corners, strokes, gradients and glyph frames only.
--
-- Everything here is presentation. It reads no gameplay state and writes none.
local TweenService = game:GetService("TweenService")
local Theme = require(script.Parent.Theme)

local Kit = {}

local C = Theme.Colors
local Alpha = Theme.Alpha
local Type = Theme.Type
local Space = Theme.Space
local Motion = Theme.Motion
local Fonts = Theme.Fonts

Kit.Colors = C
Kit.Theme = Theme

-- --------------------------------------------------------------------------- #
-- primitives
-- --------------------------------------------------------------------------- #

-- Kinds that never take input. Screenshot-only framing or decoration, so a click
-- passes through to whatever is underneath.
local PASSIVE = {
	Frame = true,
	TextLabel = true,
	ImageLabel = true,
}

function Kit.instance(className, properties, parent)
	local object = Instance.new(className)
	if PASSIVE[className] then
		object.Active = false
		object.Interactable = false
	end
	for key, value in properties do
		object[key] = value
	end
	if parent then
		object.Parent = parent
	end
	return object
end

function Kit.corner(parent, radius)
	return Kit.instance("UICorner", { CornerRadius = UDim.new(0, radius or Theme.Radius) }, parent)
end

function Kit.stroke(parent, color, transparency, thickness)
	return Kit.instance("UIStroke", {
		Color = color or C.NavyEdge,
		Thickness = thickness or 1,
		Transparency = transparency or Alpha.Hairline,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, parent)
end

function Kit.padding(parent, left, top, right, bottom)
	return Kit.instance("UIPadding", {
		PaddingLeft = UDim.new(0, left or Space.md),
		PaddingTop = UDim.new(0, top or Space.md),
		PaddingRight = UDim.new(0, right or left or Space.md),
		PaddingBottom = UDim.new(0, bottom or top or Space.md),
	}, parent)
end

-- Vertical gradient. Degrades to a flat fill if the client cannot build one.
function Kit.gradient(parent, top, bottom, rotation)
	if type(ColorSequence) ~= "table" or not ColorSequence.new then
		return nil
	end
	return Kit.instance("UIGradient", {
		Color = ColorSequence.new(top, bottom),
		Rotation = rotation or 90,
	}, parent)
end

-- A panel: navy, translucent, rounded, hairline edge, gentle top-light gradient.
function Kit.panel(parent, name, size, position, options)
	local o = options or {}
	local frame = Kit.instance("Frame", {
		Name = name,
		Size = size,
		Position = position,
		AnchorPoint = o.anchor or Vector2.zero,
		BackgroundColor3 = o.color or C.Navy,
		BackgroundTransparency = o.transparency or Alpha.Panel,
		BorderSizePixel = 0,
		ClipsDescendants = o.clip == true,
		Visible = if o.visible == nil then true else o.visible,
		ZIndex = o.zIndex or 1,
	}, parent)
	Kit.corner(frame, o.radius or Theme.Radius)
	Kit.stroke(frame, o.edge or C.NavyEdge, o.edgeTransparency or Alpha.Hairline)
	Kit.gradient(frame, (o.color or C.NavyRaised), (o.color or C.Navy))
	if o.padding then
		Kit.padding(frame, o.padding, o.padding, o.padding, o.padding)
	end
	return frame
end

-- A legibility scrim: a soft navy gradient that darkens the edge of the screen so
-- translucent panels always sit on a controlled background, even against a bright
-- sky. Degrades to nothing if NumberSequence is unavailable.
function Kit.scrim(parent, height, fromTop, options)
	local o = options or {}
	local frame = Kit.instance("Frame", {
		Name = o.name or (if fromTop then "ScrimTop" else "ScrimBottom"),
		Size = UDim2.new(1, 0, 0, height),
		Position = if fromTop then UDim2.fromOffset(0, 0) else UDim2.new(0, 0, 1, -height),
		BackgroundColor3 = o.color or C.Void,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = o.zIndex or 0,
	}, parent)
	if type(NumberSequence) ~= "table" or not NumberSequence.new then
		frame.BackgroundTransparency = o.fallback or .55
		return frame
	end
	-- Near the edge the wash is strong enough that `Muted` body text clears 4.5:1
	-- against it; it fades out before it reaches the play space.
	local strength = o.strength or .8
	local stops = if fromTop
		then { NumberSequenceKeypoint.new(0, 1 - strength), NumberSequenceKeypoint.new(.5, 1 - strength * .45), NumberSequenceKeypoint.new(1, 1) }
		else { NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(.5, 1 - strength * .45), NumberSequenceKeypoint.new(1, 1 - strength) }
	Kit.instance("UIGradient", {
		Color = ColorSequence.new(C.Void, C.Void),
		Transparency = NumberSequence.new(stops),
		Rotation = 90,
	}, frame)
	return frame
end

-- Text. `variant` picks the type scale + font pairing; never inline ad-hoc sizes.
function Kit.text(parent, name, content, variant, options)
	local o = options or {}
	local size = o.size or UDim2.new(1, 0, 0, Type[variant or "Body"] + 4)
	local label = Kit.instance("TextLabel", {
		Name = name,
		Text = content,
		Size = size,
		Position = o.position or UDim2.fromOffset(0, 0),
		AnchorPoint = o.anchor or Vector2.zero,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		TextColor3 = o.color or C.White,
		TextSize = Type[variant or "Body"],
		Font = o.font or Fonts[variant or "Body"],
		TextXAlignment = o.xAlign or Enum.TextXAlignment.Left,
		TextYAlignment = o.yAlign or Enum.TextYAlignment.Center,
		TextWrapped = o.wrapped == true,
		RichText = false,
		TextTransparency = o.transparency or 0,
		TextStrokeTransparency = if o.stroke then 0.55 else 1,
		LayoutOrder = o.order or 0,
		ZIndex = o.zIndex or 2,
	}, parent)
	if o.truncate then
		label.TextTruncate = Enum.TextTruncate.AtEnd
	end
	return label
end

function Kit.divider(parent, y, inset)
	return Kit.instance("Frame", {
		Name = "Divider",
		Size = UDim2.new(1, -(inset or Space.lg) * 2, 0, 1),
		Position = UDim2.new(0, inset or Space.lg, 0, y),
		BackgroundColor3 = C.NavyEdge,
		BackgroundTransparency = Alpha.Hairline,
		BorderSizePixel = 0,
		ZIndex = 2,
	}, parent)
end

-- A button that always does something: the caller must pass a handler, and the
-- handler is wired here. There is no such thing as a decorative button in this UI.
function Kit.button(parent, name, label, size, position, onClick, options)
	local o = options or {}
	local button = Kit.instance("TextButton", {
		Name = name,
		Text = "",
		Size = size,
		Position = position,
		AnchorPoint = o.anchor or Vector2.zero,
		BackgroundColor3 = o.color or C.NavyRaised,
		BackgroundTransparency = o.transparency or Alpha.PanelRaised,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		TextColor3 = C.White,
		ZIndex = o.zIndex or 3,
	}, parent)
	assert(type(onClick) == "function", "every button must be wired to a handler: " .. name)
	Kit.corner(button, o.radius or 12)
	Kit.stroke(button, o.edge or C.NavyEdge, Alpha.Hairline)
	Kit.gradient(button, (o.color or C.NavyRaised), C.Navy)
	local text = Kit.text(button, "Label", label, o.variant or "Label", {
		size = UDim2.fromScale(1, 1),
		color = o.textColor or C.White,
		xAlign = Enum.TextXAlignment.Center,
		zIndex = (o.zIndex or 3) + 1,
	})
	local accent = Kit.instance("Frame", {
		Name = "Accent",
		Size = UDim2.new(0, o.accentWidth or 3, 1, -10),
		Position = UDim2.new(0, 0, 0, 5),
		BackgroundColor3 = o.accent or C.Cyan,
		BorderSizePixel = 0,
		ZIndex = (o.zIndex or 3) + 1,
	}, button)
	Kit.corner(accent, 2)

	local scale = Kit.instance("UIScale", { Scale = 1 }, button)
	local hovered = false
	local function tween(property, value, duration)
		if o.reducedMotion and o.reducedMotion() then
			scale.Scale = value
			return
		end
		TweenService:Create(scale, TweenInfo.new(duration or Motion.Fast), { Scale = value }):Play()
	end
	button.MouseEnter:Connect(function()
		hovered = true
		tween("Scale", 1.03, Motion.Fast)
		text.TextColor3 = o.textColor or C.White
		accent.BackgroundColor3 = o.accent or C.Cyan
		button.BackgroundColor3 = o.hoverColor or C.NavyRaised
	end)
	button.MouseLeave:Connect(function()
		hovered = false
		tween("Scale", 1, Motion.Fast)
		button.BackgroundColor3 = o.color or C.NavyRaised
	end)
	button.Activated:Connect(function()
		if o.reducedMotion and o.reducedMotion() then
			onClick()
			return
		end
		tween("Scale", .96, Motion.Snap)
		task.delay(Motion.Snap, function()
			tween("Scale", 1, Motion.Fast)
		end)
		onClick()
	end)
	button.__hovered = function()
		return hovered
	end
	return button, text
end

-- Tween that respects reduced motion by snapping.
function Kit.animate(instance, properties, duration, style, reducedMotion)
	if reducedMotion then
		for key, value in properties do
			instance[key] = value
		end
		return nil
	end
	local tween = TweenService:Create(instance, TweenInfo.new(
		duration or Motion.Base,
		style or Enum.EasingStyle.Quad,
		Enum.EasingDirection.Out
	), properties)
	tween:Play()
	return tween
end

-- Fade + rise a panel in. Used for toasts, cards and the lobby banner.
function Kit.enter(frame, options)
	local o = options or {}
	local target = frame.Position
	frame.Position = UDim2.new(
		target.X.Scale,
		target.X.Offset,
		target.Y.Scale,
		target.Y.Offset + (o.rise or 12)
	)
	frame.Visible = true
	if o.reducedMotion then
		frame.Position = target
		return
	end
	local info = TweenInfo.new(o.duration or Motion.Base, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(frame, info, { Position = target }):Play()
end

return Kit
