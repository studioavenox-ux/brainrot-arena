		{-33.2597, 25, 13.7766},
		{-33.2597, 25, -13.7766},
		{-13.7766, 25, -33.2597},
		{13.7766, 25, -33.2597},
		{33.2597, 25, -13.7766},
	},
	LobbySpawns = {
		{5.5433, 25, 189.2961},
		{2.2961, 25, 192.5433},
		{-2.2961, 25, 192.5433},
		{-5.5433, 25, 189.2961},
		{-5.5433, 25, 184.7039},
		{-2.2961, 25, 181.4567},
