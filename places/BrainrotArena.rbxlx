			Color = {255, 200, 138},
			Brightness = 0.9,
			Range = 22.0,
			Shadows = false,
		},
		["Satellite_1_Lantern"] = {
			Name = "MastWarmth",
			Color = {255, 200, 138},
			Brightness = 0.9,
			Range = 22.0,
			Shadows = false,
		},
		["Satellite_2_Lantern"] = {
			Name = "MastWarmth",
			Color = {255, 200, 138},
			Brightness = 0.9,
			Range = 22.0,
			Shadows = false,
		},
		["Satellite_3_Lantern"] = {
			Name = "MastWarmth",
			Color = {255, 200, 138},
			Brightness = 0.9,
			Range = 22.0,
			Shadows = false,
		},
	},
	EventAccent = {168, 240, 255},
	EventLight = {255, 150, 224},
	EventRest = {
		ChaosAccent_BeaconRing = {255, 214, 116},
		ChaosAccent_BeaconTop = {255, 132, 214},
		ChaosAccent_QueueLeft = {255, 200, 138},
