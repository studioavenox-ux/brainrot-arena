        <Item class="ModuleScript" referent="RBX000896">
          <Properties>
            <string name="Name">Theme</string>
            <ProtectedString name="Source">--!nocheck
-- GENERATED by tools/build_place.py from tools/ui.py. Do not edit by hand.
-- Single source of truth for HUD colour, type scale and spacing.
return {
	Colors = {
		Void = Color3.fromRGB(10, 14, 26),
		Navy = Color3.fromRGB(16, 22, 38),
		NavyRaised = Color3.fromRGB(25, 33, 54),
		NavyEdge = Color3.fromRGB(44, 56, 86),
		White = Color3.fromRGB(238, 243, 255),
		Muted = Color3.fromRGB(160, 174, 202),
		Dim = Color3.fromRGB(112, 126, 154),
		Cyan = Color3.fromRGB(86, 224, 255),
		Violet = Color3.fromRGB(158, 120, 255),
		Amber = Color3.fromRGB(255, 199, 92),
		Danger = Color3.fromRGB(255, 108, 138),
		Success = Color3.fromRGB(118, 240, 178),
		PanelOnSand = Color3.fromRGB(30, 34, 46),
		ScrimOnSand = Color3.fromRGB(51, 50, 52),
	},
	Palette = {
		Void = {10, 14, 26},
		Navy = {16, 22, 38},
		NavyRaised = {25, 33, 54},
		NavyEdge = {44, 56, 86},
		White = {238, 243, 255},
		Muted = {160, 174, 202},
		Dim = {112, 126, 154},
		Cyan = {86, 224, 255},
		Violet = {158, 120, 255},
		Amber = {255, 199, 92},
		Danger = {255, 108, 138},
		Success = {118, 240, 178},
		PanelOnSand = {30, 34, 46},
		ScrimOnSand = {51, 50, 52},
	},
	Alpha = {
		Panel = 0.07,
		PanelRaised = 0.04,
		Scrim = 0.45,
		Hairline = 0.55,
		Ghost = 0.92,
	},
	Type = {
		Display = 34,
		Title = 22,
		Heading = 16,
		Body = 13,
		Label = 11,
		Micro = 9,
	},
	Space = {
		xs = 4,
		sm = 8,
		md = 12,
		lg = 16,
		xl = 24,
		xxl = 32,
	},
	Motion = {
		Snap = 0.08,
		Fast = 0.18,
		Base = 0.28,
		Slow = 0.45,
		Toast = 0.35,
		Notice = 3.6,
	},
	Radius = 14,
