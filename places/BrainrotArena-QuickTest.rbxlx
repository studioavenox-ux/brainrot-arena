      <Item class="ModuleScript" referent="RBX001066">
        <Properties>
          <string name="Name">AudioRules</string>
          <ProtectedString name="Source">--!strict
-- Pure audio decisions, shared by the client controller and the core tests.
-- No Roblox services are touched here, so every rule is testable headless.
local AudioRules = {}

export type PhaseState = {
	phase: string,
	eventActive: boolean?,
}

-- Which music track the current replicated state calls for.
--   Playing + Chaos Event  -&gt; "Chaos"  (the dramatic track)
--   Playing                -&gt; "Arena"
--   anything else          -&gt; "Lobby"  (Waiting, Intermission, Results)
function AudioRules.trackFor(state: PhaseState): string
	if state.phase == "Playing" then
		if state.eventActive == true then
			return "Chaos"
		end
		return "Arena"
	end
	return "Lobby"
end

-- Moves `current` toward `target` by at most fullVolume * dt / fadeSeconds, so a
-- full fade takes exactly `fadeSeconds`. The result always stays within [0, fullVolume].
function AudioRules.stepVolume(current: number, target: number, dt: number, fullVolume: number, fadeSeconds: number): number
	assert(fadeSeconds &gt; 0, "fade time must be positive")
	assert(dt &gt;= 0, "dt cannot be negative")
	local goal = math.clamp(target, 0, fullVolume)
	local maxStep = fullVolume * dt / fadeSeconds
	local nextValue = current
	if goal &gt; current then
		nextValue = math.min(goal, current + maxStep)
	elseif goal &lt; current then
		nextValue = math.max(goal, current - maxStep)
	end
	return math.clamp(nextValue, 0, fullVolume)
end

-- True for "" (deliberately silent) or a well-formed rbxassetid URL with digits only.
function AudioRules.validId(id: string): boolean
	if id == "" then
		return true
	end
	-- The scheme is joined at runtime so this source never embeds the literal URL form.
	local prefix = "rbxassetid:" .. "//"
	return string.sub(id, 1, #prefix) == prefix and string.match(string.sub(id, #prefix + 1), "^%d+$") ~= nil
end

-- Resolves a cue name to its configured asset ID, or nil when that cue is silent.
-- Unknown cue names are an error so a typo can never fail silently.
function AudioRules.cueId(cues: { [string]: string }, name: string): string?
	local id = cues[name]
	assert(id ~= nil, "unknown audio cue: " .. tostring(name))
	assert(AudioRules.validId(id), "malformed audio ID for cue " .. name)
	if id == "" then
		return nil
	end
	return id
end

return AudioRules
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX001067">
        <Properties>
          <string name="Name">Config</string>
          <ProtectedString name="Source">--!strict
-- All rewards and timings are read by the SERVER. There is no client scoring API.
local Config = {
	Version = "0.2.0",
	WorldVersion = 2,
	Brand = "BRAINROT ARENA",
	ArenaName = "SYNAPSE CIRCUIT",
	StudioFastMode = true, -- The generated QuickTest place changes ONLY this flag.

	Timing = {
		Intermission = 12,
		Round = 180,
		Results = 9,
		-- The single Chaos Event of a round: one window, exactly ChaosDuration long,
		-- starting inside the Chaos stage (105 s - 150 s). See Chaos below.
		ChaosStart = 105,
		ChaosDuration = 35,
		Warning = 6,
	},
	FastTiming = {
		Intermission = 4,
		-- Studio QuickTest. The round is longer than the 35 s event so the event is
		-- exercised exactly as in production, and it still fits with time to spare.
		Round = 50,
		Results = 5,
		ChaosStart = 8,
		ChaosDuration = 35,
		Warning = 3,
	},
	NormalGravity = 196.2,
	WalkSpeed = 22,
	JumpPower = 50,
	ServerStep = 0.1,
	SnapshotInterval = 0.25,
	RescueBelowY = 0,
	SpawnProtection = 0.65,
	PickupRadius = 4.5,
	PickupRespawn = 5,
	MaxHorizontalSpeed = 65,
	MovementSlack = 9,
	ParticipationCoins = 10,
	CoinsPerPoint = 2,
	WinnerCoins = 30,
	HaloCost = 100,
	SaveInterval = 60,

	-- ------------------------------------------------------------------ #
	-- Round stages. Elapsed seconds from the start of a Playing round.
	-- Each stage boundary banks every player's carried cells: what you have
	-- banked is safe, what you are carrying can be stolen. See RoundMachine.
	-- ------------------------------------------------------------------ #
	Stages = {
		{ Name = "Collect", At = 0, Label = "COLLECT" },
		{ Name = "Compete", At = 45, Label = "COMPETE" },
		{ Name = "Chaos", At = 105, Label = "CHAOS" },
		{ Name = "Final", At = 150, Label = "FINAL RUSH" },
	},
	FastStages = {
		{ Name = "Collect", At = 0, Label = "COLLECT" },
		{ Name = "Compete", At = 8, Label = "COMPETE" },
		{ Name = "Chaos", At = 18, Label = "CHAOS" },
		{ Name = "Final", At = 24, Label = "FINAL RUSH" },
	},

	-- ------------------------------------------------------------------ #
	-- Chaos Event. Exactly ONE per round, drawn uniformly by the server from
	-- `Kinds` when the round starts. The window never overlaps another event.
	-- Per-kind effects are defined in src/server/core/ChaosRules.luau.
	-- ------------------------------------------------------------------ #
	Chaos = {
		Kinds = { "LowGravity", "BouncyWorld", "SlipperyChaos", "BrainCellRush" },
		LowGravity = 62,         -- studs/s^2 (normal is 196.2)
		BouncyJumpScale = 1.8,   -- jump power multiplier while Bouncy World runs
		RushRarityScale = 3,     -- weight multiplier for Rare and Prismatic cells
	},

	-- ------------------------------------------------------------------ #
	-- Audio. Every sound ID is configured HERE. An empty string means "no sound":
	-- nothing is invented, and no uploaded or third-party asset is required to run.
	-- To enable a slot, paste an rbxassetid URL (the scheme, a colon, two slashes, then
	-- the number) for an audio asset you own or are licensed to use.
	-- docs/AUDIO.md lists every slot and its behaviour.
	-- ------------------------------------------------------------------ #
	Audio = {
		CrossfadeSeconds = 1.5,  -- time to fade one music track out and the next in
		MusicVolume = .35,       -- loudest level for a music track
		CueVolume = .6,          -- level for one-shot cues
		Tracks = {
			Lobby = "",          -- Waiting / Intermission / Results
			Arena = "",          -- Playing, no Chaos Event
			Chaos = "",          -- Playing, a Chaos Event is active
		},
		-- One-shot cues. Ability cues are added here, one key per ability, when the
		-- abilities exist (for example "Ability.Dash"). Playing an unlisted cue is an
		-- error, so a typo cannot fail silently.
		Cues = {
			RoundStart = "",
			RoundEnd = "",
			ChaosStart = "",
			ChaosEnd = "",
			Steal = "",
			Ability = "",
		},
	},

	-- ------------------------------------------------------------------ #
	-- Characters. Six playable characters, all free, one active at a time. Every
	-- character has one ability, and each ability has its own cooldown. Cooldowns are
	-- per player and per character, persist across switches within a round, and reset
	-- at the next round. Abilities never award, steal or move Brain Cells.
	-- Roster keys are the cell species keys in Creatures.luau.
	-- ------------------------------------------------------------------ #
	Characters = {
		-- Slot 1..6 is the order the client shows and the order the server accepts.
		Order = { "brain", "frog", "fish", "goose", "toast", "sock" },
		SwitchesNormal = 3,   -- switches usable at any time during Playing
		SwitchesBonus = 1,    -- one extra switch, usable only during the Chaos Event
		Roster = {
			brain = { Ability = "MindTrick", Title = "MIND TRICK", Cooldown = 20, Duration = 6, Offset = 6 },
			frog = { Ability = "BellyBounce", Title = "BELLY BOUNCE", Cooldown = 15, Radius = 10, Push = 55, Lift = 18 },
			fish = { Ability = "BubbleDash", Title = "BUBBLE DASH", Cooldown = 12, Speed = 70, Duration = .35 },
			goose = { Ability = "HonkWave", Title = "HONK WAVE", Cooldown = 18, Radius = 14, SlowFactor = .5, Duration = 2.5 },
			toast = { Ability = "ToastLaunch", Title = "TOAST LAUNCH", Cooldown = 16, Radius = 8, Lift = 60 },
			sock = { Ability = "SockSnare", Title = "SOCK SNARE", Cooldown = 14, Radius = 12, SlowFactor = .4, Duration = 4 },
		},
		-- Ability-driven movement gets a temporary speed allowance from MovementGuard.
		-- Margin is added on top of the expected speed, so ordinary rounding never trips it.
		MovementMargin = 8,
		GrantSeconds = .8,
	},

	-- ------------------------------------------------------------------ #
	-- Stealing. A short-range tag that moves ONE carried cell from the victim
	-- to the thief. Banked cells are never at risk, and nothing leaves the round.
	-- ------------------------------------------------------------------ #
	Steal = {
		Range = 13,          -- studs, centre-to-centre, checked on the server
		Cooldown = 8,        -- seconds, per thief, exactly as specified
		Protection = 3,      -- spawn / respawn immunity
		Immunity = 4,        -- post-steal immunity for the victim
		RepeatWindow = 12,   -- no re-tagging the same victim inside this window
	},

	-- Sticky floor while Slippery Chaos runs.
	SlipperyFriction = 0.06,
	-- Respawn seconds during Brain Cell Rush, and during the Final Rush.
	RushRespawn = 1.5,
	FinalRespawn = 2,

	Kinds = {
		{ Name = "Common", Value = 1, Weight = 78, Color = { 255, 94, 190 } },
		{ Name = "Rare", Value = 5, Weight = 18, Color = { 255, 213, 67 } },
		{ Name = "Prismatic", Value = 10, Weight = 4, Color = { 83, 238, 255 } },
	},
}

return table.freeze(Config)
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX001068">
        <Properties>
          <string name="Name">Creatures</string>
          <ProtectedString name="Source">--!nocheck
-- GENERATED by tools/build_place.py from tools/creatures.py. Do not edit by hand.
-- Gameplay manifest for the six characters: names, rarity, rewards, order.
-- The server owns which character a cell is; the client only renders it.
local Creatures = {}

Creatures.Family = {
	[1] = {"brain", "frog"},
	[5] = {"fish", "goose"},
	[10] = {"toast", "sock"},
}

Creatures.Order = {
	"brain",
	"frog",
	"fish",
	"goose",
	"toast",
	"sock",
}

Creatures.Rarity = {
	[1] = { Key = "Common", Label = "COMMON" },
	[5] = { Key = "Rare", Label = "RARE" },
	[10] = { Key = "Legendary", Label = "LEGENDARY" },
}

Creatures.Characters = {
	brain = { Name = "Brainy", Label = "BRAINY", Title = "The Overthinker", Rarity = "Common", Value = 1 },
	frog = { Name = "Blorbo", Label = "BLORBO", Title = "The Wide One", Rarity = "Common", Value = 1 },
	fish = { Name = "Glorp", Label = "GLORP", Title = "The Legally A Fish", Rarity = "Rare", Value = 5 },
	goose = { Name = "Hjonk", Label = "HJONK", Title = "The Unbothered", Rarity = "Rare", Value = 5 },
	toast = { Name = "Crusty", Label = "CRUSTY", Title = "The Breakfast", Rarity = "Legendary", Value = 10 },
	sock = { Name = "Whiffers", Label = "WHIFFERS", Title = "The Sentient Sock", Rarity = "Legendary", Value = 10 },
}

-- Deterministic species for a slot. The server calls this when it spawns
-- a cell, so the receipt names the character the player collected.
function Creatures.SpeciesOf(slotId: number, value: number): string
	local family = Creatures.Family[value] or Creatures.Family[1]
	return family[slotId % #family + 1]
end

function Creatures.IndexOf(name: string): number
	for index, entry in Creatures.Order do
		if entry == name then return index end
	end
	return 0
end

return table.freeze(Creatures)
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="RBX001069">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="RBX001070">
      <Properties>
        <string name="Name">BrainrotServer</string>
      </Properties>
      <Item class="ModuleScript" referent="RBX001071">
        <Properties>
          <string name="Name">AbilityService</string>
          <ProtectedString name="Source">--!strict
-- Roblox adapter for character abilities. Every decision comes from the pure modules
-- (AbilityRules for geometry and statuses, CharacterRules for cooldowns and switching).
-- This module only turns those decisions into parts, velocities and walk speeds.
--
-- Hard rules, all enforced here or by the caller:
--   * Nothing in this module touches Brain Cells, scores, coins or the round machine.
--   * The caster is never a target of their own ability.
--   * Ability-driven movement is granted to MovementGuard for its exact duration only.
--   * Every effect is removed on round end (reset) and when a player leaves (forget).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Config = require(ReplicatedStorage:WaitForChild("BrainrotShared"):WaitForChild("Config"))
local AbilityRules = require(script.Parent.core.AbilityRules)
local MovementGuard = require(script.Parent.core.MovementGuard)

local AbilityService = {}
AbilityService.__index = AbilityService

export type Candidate = { player: Player, root: BasePart, humanoid: Humanoid }
export type Service = typeof(setmetatable({} :: {
	movement: MovementGuard.Guard,
	statuses: AbilityRules.Statuses,
	decoys: { [number]: { model: Model, untilAt: number } },
	dashes: { [number]: { x: number, z: number, untilAt: number } },
}, AbilityService))

function AbilityService.new(movement: MovementGuard.Guard): Service
	return setmetatable({
		movement = movement,
		statuses = {},
		decoys = {},
		dashes = {},
	}, AbilityService) :: any
end

local function planar(position: Vector3): AbilityRules.Vec
	return { x = position.X, y = position.Y, z = position.Z }
end

local function toVector3(v: AbilityRules.Vec): Vector3
	return Vector3.new(v.x, v.y, v.z)
end

local function removeDecoy(self: Service, userId: number)
	local decoy = self.decoys[userId]
	if decoy then
		decoy.model:Destroy()
		self.decoys[userId] = nil
	end
end

-- A visual decoy: anchored, non-colliding copies of the caster's visible parts, shown a
-- few studs to the side. It is not a character, has no Humanoid, and is never targeted.
local function spawnDecoy(self: Service, caster: Player, character: Model, root: BasePart, entry: any, now: number)
	removeDecoy(self, caster.UserId)
	local model = Instance.new("Model")
	model.Name = "MindTrick_" .. tostring(caster.UserId)
	for _, part in character:GetDescendants() do
		if part:IsA("BasePart") then
			local copy = part:Clone()
			copy.Anchored = true
			copy.CanCollide = false
			copy.CanTouch = false
			copy.CanQuery = false
			copy.Transparency = math.max(copy.Transparency, .35)
			copy.Parent = model
		end
	end
	model.Parent = Workspace
	model:PivotTo(root.CFrame * CFrame.new(entry.Offset, 0, 0))
	self.decoys[caster.UserId] = { model = model, untilAt = now + entry.Duration }
end

-- Performs one ability for `caster`. `candidates` lists every participating player with a
-- live root (the caster may be among them; they are always excluded). Returns the players
-- who were actually affected, nearest first, so the caller can notify them.
function AbilityService.perform(self: Service, caster: Player, character: Model, root: BasePart,
	entry: any, candidates: { Candidate }, now: number): { Player }
	local casterPos = planar(root.Position)
	local look = planar(root.CFrame.LookVector)
	local lookFallback = { x = look.x, y = 0, z = look.z }
	local pool: { AbilityRules.Candidate } = {}
	local byId: { [number]: Candidate } = {}
	for _, candidate in candidates do
		table.insert(pool, { userId = candidate.player.UserId, position = planar(candidate.root.Position) })
		byId[candidate.player.UserId] = candidate
	end

	local affected: { Player } = {}
	local ability = entry.Ability
	if ability == "MindTrick" then
		spawnDecoy(self, caster, character, root, entry, now)
		return affected
	end

	if ability == "BubbleDash" then
		local velocity = AbilityRules.dashVelocity(look, entry.Speed)
		self.dashes[caster.UserId] = { x = velocity.x, z = velocity.z, untilAt = now + entry.Duration }
		self.movement:grant(caster.UserId, entry.Speed + Config.Characters.MovementMargin,
			now + entry.Duration + Config.Characters.GrantSeconds, now)
		table.insert(affected, caster)
		return affected
	end

	local hits = AbilityRules.targetsIn(casterPos, pool, entry.Radius, caster.UserId)
	for _, hit in hits do
		local victim = byId[hit.userId]
		if victim then
			local victimPos = planar(victim.root.Position)
			if ability == "BellyBounce" then
				local direction = AbilityRules.horizontalDirection(casterPos, victimPos, lookFallback)
				local velocity = AbilityRules.knockbackVelocity(direction, entry.Push, entry.Lift)
				victim.root.AssemblyLinearVelocity = toVector3(velocity)
				self.movement:grant(victim.player.UserId, entry.Push + Config.Characters.MovementMargin,
					now + Config.Characters.GrantSeconds, now)
			elseif ability == "ToastLaunch" then
				victim.root.AssemblyLinearVelocity = toVector3(AbilityRules.launchVelocity(entry.Lift))
			elseif ability == "HonkWave" or ability == "SockSnare" then
				AbilityRules.applySlow(self.statuses, victim.player.UserId, entry.SlowFactor, now + entry.Duration)
			end
			table.insert(affected, victim.player)
		end
	end
	return affected
end

-- Walk speed for a player right now: the base speed, scaled by any active slow.
function AbilityService.walkSpeed(self: Service, userId: number, now: number): number
	return Config.WalkSpeed * AbilityRules.speedFactor(self.statuses, userId, now)
end

-- Runs every frame: keeps dash velocity applied for its duration and keeps each walk speed
-- equal to the live value. Writes happen only on change.
function AbilityService.drive(self: Service, now: number, players: { Candidate })
	for _, candidate in players do
		local humanoid = candidate.humanoid
		local wanted = AbilityService.walkSpeed(self, candidate.player.UserId, now)
		if humanoid.WalkSpeed ~= wanted then
			humanoid.WalkSpeed = wanted
		end
		local dash = self.dashes[candidate.player.UserId]
		if dash and now &lt; dash.untilAt then
			local vy = candidate.root.AssemblyLinearVelocity.Y
			candidate.root.AssemblyLinearVelocity = Vector3.new(dash.x, vy, dash.z)
		end
	end
end

-- Ends expired effects. Called from the authority step.
function AbilityService.prune(self: Service, now: number)
	AbilityRules.prune(self.statuses, now)
	for userId, decoy in self.decoys do
		if now &gt;= decoy.untilAt then
			removeDecoy(self, userId)
		end
	end
	for userId, dash in self.dashes do
		if now &gt;= dash.untilAt then
			self.dashes[userId] = nil
		end
	end
end

-- Removes every effect at once. Called at the end of each round.
function AbilityService.reset(self: Service)
	for userId in self.decoys do
		removeDecoy(self, userId)
	end
	table.clear(self.statuses)
	table.clear(self.dashes)
end

-- Removes one player's effects. Called when they leave.
function AbilityService.forget(self: Service, userId: number)
	removeDecoy(self, userId)
	self.statuses[userId] = nil
	self.dashes[userId] = nil
end

function AbilityService.decoyCount(self: Service): number
	local count = 0
	for _ in self.decoys do
		count += 1
	end
	return count
end

return AbilityService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX001072">
        <Properties>
          <string name="Name">ArtService</string>
          <ProtectedString name="Source">--!nonstrict
-- Applies the art-direction lighting rig at runtime (Rojo workflow, or if the
-- baked Lighting children are ever missing). The exported place already contains
-- this exact rig; applying it twice is idempotent, so both workflows match.
--
-- Performance: a handful of singleton Lighting instances, no loops per frame and
-- no post-processing beyond the four cheap standard effects. Nothing here touches
-- gameplay, scoring, pickups, rounds or networking.
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ArtDirection = require(ReplicatedStorage:WaitForChild("BrainrotShared"):WaitForChild("ArtDirection"))

local ArtService = {}

local function rgb(values)
	return Color3.fromRGB(values[1], values[2], values[3])
end

local function applyProperties(instance, properties)
	for key, value in properties do
		instance[key] = if typeof(value) == "table" then rgb(value) else value
	end
end

-- Instances this module owns, so it never depends on children order.
local owned = {}

local function acquire(class, name)
	local existing = Lighting:FindFirstChild(name)
	if existing and existing.ClassName == class then
		return existing
	end
	if existing then
		existing:Destroy()
	end
	local instance = Instance.new(class)
	instance.Name = name
	instance.Parent = Lighting
	return instance
end

function ArtService.apply()
	-- Renderer technology is a place/Studio setting, not script authority; the rig
	-- below is authored for the default (shadowed) renderer.
	applyProperties(Lighting, ArtDirection.Lighting)
	for class, spec in ArtDirection.Effects do
		local instance = acquire(class, spec.Name)
		local properties = table.clone(spec.Properties)
		if class == "Sky" then
			for face, url in ArtDirection.Skybox do
				properties["Skybox" .. face] = url
			end
		end
		applyProperties(instance, properties)
		owned[class] = instance
	end
	-- Remove any legacy grade left in an older place so the look cannot drift.
	for _, child in Lighting:GetChildren() do
		if child:IsA("ColorCorrectionEffect") and child.Name ~= ArtDirection.Effects.ColorCorrectionEffect.Name then
			child:Destroy()
		end
	end
	return owned
end

return ArtService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX001073">
        <Properties>
          <string name="Name">EventDirector</string>
          <ProtectedString name="Source">-- Applies the physical side of the Chaos Event to the live world: gravity and
-- surface friction. Nothing here decides *when* or *which* event runs. The server
-- hands this module the complete modifier set from ChaosRules, every tick, and the
-- director makes the world match it.
--
-- Cleanup rules:
--   * Gravity is written only when it differs, and always returns to the normal value
--     from the neutral modifier set.
--   * Friction is applied by overriding each part's CustomPhysicalProperties. The
--     first override records every part's ORIGINAL value, and restoring writes those
--     exact values back (or nil where a part had none). Nothing is left behind.
--   * While friction is active, a DescendantAdded watcher adopts every new surface
--     (newly spawned or respawned characters, rebuilt pickups) so it gets the same
--     friction at once and is restored with everything else.
--   * Friction is written only when its value changes, never once per tick.
--   * Parts that were destroyed while a surface was altered are skipped on restore.
local ChaosRules = require(script.Parent.core.ChaosRules)

local EventDirector = {}
EventDirector.__index = EventDirector

export type Director = typeof(setmetatable({} :: {
	normalGravity: number,
	frictionOn: boolean,
	frictionValue: number?,
	saved: { [BasePart]: PhysicalProperties | boolean },
	watcher: RBXScriptConnection?,
}, EventDirector))

function EventDirector.new(normalGravity: number): Director
	assert(normalGravity == normalGravity and normalGravity &gt; 0, "Normal gravity must be positive")
	return setmetatable({
		normalGravity = normalGravity,
		frictionOn = false,
		frictionValue = nil,
		saved = {},
		watcher = nil,
	}, EventDirector) :: any
end

-- Pickups named BrainCell are not walkable surfaces and are excluded, as before.
local function isSurface(instance: Instance): boolean
	return instance:IsA("BasePart") and instance.Name ~= "BrainCell"
end

-- Records a part's authored properties once, then overrides them while friction is on.
local function adopt(self: Director, part: BasePart, props: PhysicalProperties)
	if self.saved[part] == nil then
		self.saved[part] = part.CustomPhysicalProperties or false
	end
	if part.Parent ~= nil then
		part.CustomPhysicalProperties = props
	end
end

local function setFriction(self: Director, value: number)
	if self.frictionOn and self.frictionValue == value then
		return -- already in force; nothing to write
	end
	local props = PhysicalProperties.new(.7, value, .5, 1, 1)
	self.frictionValue = value
	if not self.frictionOn then
		self.frictionOn = true
		for _, part in (workspace :: any):GetDescendants() do
			if isSurface(part) and self.saved[part] == nil then
				self.saved[part] = part.CustomPhysicalProperties or false
			end
		end
		self.watcher = (workspace :: any).DescendantAdded:Connect(function(instance: Instance)
			if self.frictionOn and isSurface(instance) then
				adopt(self, instance :: BasePart, PhysicalProperties.new(.7, self.frictionValue or value, .5, 1, 1))
			end
		end)
	end
	for part in self.saved do
		if part.Parent ~= nil then
			part.CustomPhysicalProperties = props
		end
	end
end

local function restoreFriction(self: Director)
	if not self.frictionOn then
		return
	end
	if self.watcher then
		self.watcher:Disconnect()
		self.watcher = nil
	end
	for part, original in self.saved do
		if part.Parent ~= nil then
			part.CustomPhysicalProperties = if original == false then nil else original :: PhysicalProperties
		end
	end
	table.clear(self.saved)
	self.frictionOn = false
	self.frictionValue = nil
end

-- Make the world match `mods`. Idempotent: calling it twice with the same modifiers
-- changes nothing the second time.
function EventDirector.apply(self: Director, mods: ChaosRules.Modifiers)
	local host: any = workspace
	if host.Gravity ~= mods.Gravity then
		host.Gravity = mods.Gravity
	end
	if mods.Friction ~= nil then
		setFriction(self, mods.Friction)
	else
		restoreFriction(self)
	end
end

-- Called on every phase change and when the server shuts an event down. Returns the
-- world to the state it had before any event touched it.
function EventDirector.reset(self: Director)
	local host: any = workspace
	host.Gravity = self.normalGravity
	restoreFriction(self)
end

-- Number of parts currently overridden. Exposed for tests and the invariant checks.
function EventDirector.adoptedCount(self: Director): number
	local count = 0
	for _ in self.saved do
		count += 1
	end
	return count
end

return EventDirector
</ProtectedString>
        </Properties>
      </Item>
      <Item class="Script" referent="RBX001074">
        <Properties>
          <string name="Name">Main</string>
          <ProtectedString name="Source">--!strict
-- Roblox adapter. Only this server script can award cells, pay coins, or unlock cosmetics.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
-- Publish the remotes before anything that can fail. A client waits for this folder; if
-- a later setup step throws, the client must still be able to receive state and show an error.
local remotes = Instance.new("Folder")
remotes.Name = "BrainrotRemotes"
local stateRemote = Instance.new("RemoteEvent")
stateRemote.Name = "State"
stateRemote.Parent = remotes
local pickupRemote = Instance.new("RemoteEvent")
pickupRemote.Name = "Pickup"
pickupRemote.Parent = remotes
local requestRemote = Instance.new("RemoteEvent")
requestRemote.Name = "Request"
requestRemote.Parent = remotes
-- Character verbs have their own remotes. Each one is validated on its own terms:
-- Ability takes no arguments; Character takes exactly one integer slot.
local abilityRemote = Instance.new("RemoteEvent")
abilityRemote.Name = "Ability"
abilityRemote.Parent = remotes
local characterRemote = Instance.new("RemoteEvent")
characterRemote.Name = "Character"
characterRemote.Parent = remotes
-- Server to one player only: their character view and the result of their last verb.
local characterStateRemote = Instance.new("RemoteEvent")
characterStateRemote.Name = "CharacterState"
characterStateRemote.Parent = remotes
remotes.Parent = ReplicatedStorage

local Shared = ReplicatedStorage:WaitForChild("BrainrotShared")
local Config = require(Shared:WaitForChild("Config"))
local CharacterManifest = require(Shared:WaitForChild("Creatures"))
local RoundMachine = require(script.Parent.core.RoundMachine)
local PickupLedger = require(script.Parent.core.PickupLedger)
local MovementGuard = require(script.Parent.core.MovementGuard)
local ArenaRoute = require(script.Parent.core.ArenaRoute)
local EventDirector = require(script.Parent.EventDirector)
local ChaosRules = require(script.Parent.core.ChaosRules)
local Persistence = require(script.Parent.Persistence)
local WorldService = require(script.Parent.WorldService)
local WorldData = require(script.Parent.WorldData)
local ArtService = require(script.Parent.ArtService)
local CharacterRules = require(script.Parent.core.CharacterRules)
local AbilityService = require(script.Parent.AbilityService)

local settings = table.clone(Config)
local fast = RunService:IsStudio() and Config.StudioFastMode
settings.Timing = if fast then Config.FastTiming else Config.Timing
local random = Random.new()
-- Chaos draws are server-side and uniform over the configured pool. Clamped so a
-- rounding edge can never index past the end of the list.
local machine = RoundMachine.new(settings, function(n: number): number
	return math.min(n, math.floor(random:NextNumber() * n) + 1)
end)
-- Species is rolled here, on the server, from the ledger's own slot id and rarity, so
-- the receipt a client animates names the character that player really collected.
local ledger = PickupLedger.new(WorldData.PickupPositions, Config.Kinds, Config.PickupRadius, Config.PickupRespawn, function()
	return random:NextNumber()
end, function(slotId: number, value: number): string
	return CharacterManifest.SpeciesOf(slotId, value)
end)
local movement = MovementGuard.new(Config.MaxHorizontalSpeed, Config.MovementSlack, Config.SpawnProtection)
-- Character state (switch quotas, per-character cooldowns) and ability effects. Both are
-- reset at round start; cooldowns never survive into the next round.
local characters = CharacterRules.new(Config.Characters)
local abilities = AbilityService.new(movement)
-- Arena access. Every rail trip goes through this router: it asserts a destination
-- and keeps asserting it until the character is measurably there.
local route = ArenaRoute.new()
local routeStep = 0
-- Appearance only. Idempotent with the lighting rig baked into the place file.
ArtService.apply()
local world = WorldService.new()
-- Animates the baked event geometry by name. Owns gravity/friction *inside* an
-- event window only; the round machine owns when a window opens.
local director = EventDirector.new(Config.NormalGravity)
-- The live Chaos modifiers. Only syncChaos() writes this, so every consumer (jump,
-- respawn, rarity, gravity, friction) agrees on the same snapshot of the event.
local appliedChaos = ""
local chaos: ChaosRules.Modifiers = ChaosRules.modifiers("", Config)
-- Coins, the specimen log, lifetime stats and cosmetics live here. Round score
-- does not: it is created and destroyed by the round.
local profiles = Persistence.new({})
Workspace.Gravity = Config.NormalGravity
Workspace.FallenPartsDestroyHeight = -160
Players.RespawnTime = 2


local pickupFolder = Instance.new("Folder")
pickupFolder.Name = "BrainrotPickups"
pickupFolder.Parent = Workspace
local pickupParts: { [number]: Part } = {}
type Record = {
	spawnIndex: number, connection: RBXScriptConnection?, requests: { [string]: number },
}
local records: { [number]: Record } = {}
local nextSpawn = 0
local dirty = true
local lastBroadcast = 0
local lastBoardSecond = -1

local function position(v: Vector3)
	return { x = v.X, y = v.Y, z = v.Z }
end

local function syncStats()
	for _, player in Players:GetPlayers() do
		local data = machine.players[player.UserId]
		local stats = player:FindFirstChild("leaderstats")
		if data and stats then
			local cells = stats:FindFirstChild("Brain Cells") :: IntValue
			local coins = stats:FindFirstChild("Coins") :: IntValue
			local wins = stats:FindFirstChild("Wins") :: IntValue
			cells.Value = data.score
			coins.Value = data.coins
			wins.Value = data.wins
		end
	end
end

local function snapshot()
	local state = machine:snapshot()
	-- Only plain serializable arrays / string-key dictionaries cross remotes.
	return {
		phase = state.phase, roundId = state.roundId, phaseEndsAt = state.phaseEndsAt,
		eventActive = state.eventActive, eventEndsAt = state.eventEndsAt,
		eventKind = state.eventKind, eventWarning = state.eventWarning,
		eventWarningEndsAt = state.eventWarningEndsAt, events = state.events,
		stage = state.stage, stageIndex = state.stageIndex, stageEndsAt = state.stageEndsAt,
		rows = state.rows, results = state.results,
		fastMode = fast, version = Config.Version,
	}
end

-- ---- characters: views, messages and the name tag -----------------------------
-- Player-facing wording for each refusal reason from CharacterRules.
local REFUSAL_NOTICES: { [string]: string } = {
	["phase"] = "CHARACTERS ARE LIVE DURING PLAY",
	["not-participating"] = "JOIN THE ROUND FIRST",
	["bad-slot"] = "NO SUCH CHARACTER",
	["same-character"] = "ALREADY YOUR CHARACTER",
	["no-switches"] = "NO SWITCHES LEFT THIS ROUND",
	["bonus-during-chaos-only"] = "BONUS SWITCH: CHAOS EVENT ONLY",
	["cooling"] = "ABILITY RECHARGING",
}

local function characterView(player: Player, notice: string?): { [string]: any }
	local view = CharacterRules.view(characters, player.UserId, machine.eventActive == true)
	view.notice = notice or ""
	view.phase = machine.phase
	view.now = Workspace:GetServerTimeNow()
	return view
end

local function sendCharacter(player: Player, notice: string?)
	characterStateRemote:FireClient(player, characterView(player, notice))
end

-- The name tag shows the active character. It is rebuilt on every switch and respawn.
local function applyCharacterTag(player: Player)
	local character = player.Character
	local head = if character then character:FindFirstChild("Head") else nil
	if not head or not head:IsA("BasePart") then
		return
	end
	local active = CharacterRules.ensure(characters, player.UserId).active
	local species = CharacterManifest.Characters[active]
	local gui = head:FindFirstChild("CharacterTag")
	if gui == nil then
		gui = Instance.new("BillboardGui")
		gui.Name = "CharacterTag"
		gui.Size = UDim2.fromOffset(150, 22)
		gui.StudsOffset = Vector3.new(0, 2.4, 0)
		gui.MaxDistance = 80
		gui.Parent = head
		local label = Instance.new("TextLabel")
		label.Name = "Label"
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamBlack
		label.TextScaled = true
		label.TextColor3 = Color3.fromRGB(238, 243, 255)
		label.TextStrokeTransparency = .5
		label.Parent = gui
	end
	local label = gui:FindFirstChild("Label")
	if label and label:IsA("TextLabel") then
		label.Text = species.Label
	end
end

local function applyHalo(player: Player)
	local character = player.Character
	local data = machine.players[player.UserId]
	if not character then
		return
	end
	local previous = character:FindFirstChild("PulseHalo")
	if previous then
		previous:Destroy()
	end
	local head = character:FindFirstChild("Head")
	if not data or not data.haloEquipped or not head or not head:IsA("BasePart") then
		return
	end
	local model = Instance.new("Model")
	model.Name = "PulseHalo"
	for i = 0, 7 do
		local angle = i * math.pi / 4
		local segment = Instance.new("Part")
		segment.Name = "Glow"
		segment.Size = Vector3.new(0.8, 0.16, 0.25)
		segment.Material = Enum.Material.Neon
		segment.Color = Color3.fromRGB(126, 226, 250)
		segment.CanCollide = false
		segment.CanTouch = false
		segment.CanQuery = false
		segment.Massless = true
		segment.CastShadow = false
		segment.CFrame = head.CFrame * CFrame.new(math.cos(angle)*1.3, 1.4, math.sin(angle)*1.3) * CFrame.Angles(0, -angle+math.pi/2, 0)
		segment.Parent = model
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = head
		weld.Part1 = segment
		weld.Parent = segment
	end
	model.Parent = character
end

local function characterReady(player: Player)
	local character = player.Character
	local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	if not character or not humanoid or not root or not root:IsA("BasePart") then
		return nil
	end
	if humanoid.Health &lt;= 0 then
		return nil
	end
	return character, humanoid, root
end

-- One rail move. Returns true only if the character was actually relocated.
local function movePlayer(player: Player, arena: boolean, now: number, escalate: boolean): boolean
	local record = records[player.UserId]
	local character, humanoid, root = characterReady(player)
	if not record or not character or not humanoid or not root then
		return false
	end
	local target = world:spawnCFrame(arena, record.spawnIndex)
	-- Fallback path: an unseated or seated humanoid will silently refuse a PivotTo.
	-- Detach it from the seat, stop physics, then pivot; the engine re-seats it.
	if escalate then
		-- An unseated or platform-standing humanoid silently refuses a PivotTo.
		-- Detach it, stop the assembly, then pivot twice: the second call lands after
		-- the engine has reset the root from the first.
		humanoid.Sit = false
		humanoid.PlatformStand = false
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		character:PivotTo(target)
		character:PivotTo(target)
	else
		character:PivotTo(target)
	end
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	humanoid.WalkSpeed = AbilityService.walkSpeed(abilities, player.UserId, now)
	humanoid.UseJumpPower = true
	humanoid.JumpPower = Config.JumpPower * chaos.JumpScale
	movement:teleport(player.UserId, position(target.Position), now)
	route:attempt(player.UserId, if arena then "arena" else "lobby", now)

	-- Verify, do not assume. A PivotTo can be silently ignored (seated humanoid,
	-- platform stand, a physics owner mid-step). If the character did not move, open
	-- the retry window immediately instead of waiting out the backoff.
	local landed = (root.Position - target.Position).Magnitude &lt;= 16
	if not landed then
		local track = route:track(player.UserId)
		track.lastAttempt = now - ArenaRoute.RETRY_DELAY + 0.02
		route.corrections += 1
	end
	return landed
end

-- One routing decision for one player. This is the only place that decides whether
-- a character belongs in the arena, and it retries until the character is there.
local function routePlayer(player: Player, now: number, force: boolean)
	local _, _, root = characterReady(player)
	local trackPosition = if root then position(root.Position) else nil
	if force then
		-- A phase flip should be acted on in this very step. Clearing the backoff is
		-- not a bypass of the verification: the move is still an ordinary attempt,
		-- and only repeated failures escalate to the fallback path.
		local track = route:track(player.UserId)
		track.cooldownUntil = -math.huge
		track.attempts = 0
	end
	local verdict, destination = route:evaluate(
		player.UserId,
		machine.phase,
		machine:isParticipating(player.UserId),
		trackPosition,
		root ~= nil,
		now
	)
	if verdict == "retry" and destination then
		local placed = movePlayer(player, destination == "arena", now, false)
		-- A refused pivot opens the retry window immediately (movePlayer already
		-- reset the backoff), so no extra bookkeeping is needed here.
	elseif verdict == "give-up" and destination then
		-- Escalation: re-seat the character. The router has already counted this as
		-- a fallback, so the log line below is evidence, not decoration.
		local escaped = (function()
			local _, humanoid = characterReady(player)
			return humanoid ~= nil and (humanoid.Sit == true or humanoid.PlatformStand == true)
		end)()
		movePlayer(player, destination == "arena", now, true)
		local fallbacks = (player:GetAttribute("ArenaRouteFallbacks") or 0) + 1
		player:SetAttribute("ArenaRouteFallbacks", fallbacks)
		print(string.format(
			"[Brainrot] route fallback #%d • %s -&gt; %s%s",
			fallbacks, player.Name, destination,
			if escaped then " (detached from seat)" else " (re-seat + pivot)"))
	elseif force and destination then
		-- Character just loaded, or the phase just flipped: assert the destination
		-- now. Still the ordinary attempt, so a failure is visible and escalates.
		movePlayer(player, destination == "arena", now, false)
	end
end

local function updatePickup(slotId: number)
	local slot = ledger.slots[slotId]
	local part = pickupParts[slotId]
	if not part then
		return
	end
	local kind = Config.Kinds[slot.kindIndex]
	part.Color = Color3.fromRGB(kind.Color[1], kind.Color[2], kind.Color[3])
	part.Transparency = if slot.available then 0 else 1
	part:SetAttribute("Kind", kind.Name)
	part:SetAttribute("Value", kind.Value)
	-- A display id that changes with every generation, so the client can tell "the
	-- same cell respawned" from "a different character took its place" and animate
	-- the swap instead of silently recolouring.
	part:SetAttribute("Species", slot.species)
	part:SetAttribute("DisplayId", slot.species .. ":" .. slot.generation)
	part:SetAttribute("Generation", slot.generation)
	part:SetAttribute("Active", slot.available)
end

local function spawnPickups()
	pickupFolder:ClearAllChildren()
	table.clear(pickupParts)
	for _, slot in ledger.slots do
		local part = Instance.new("Part")
		part.Name = "BrainCell_" .. slot.id
		part.Shape = Enum.PartType.Ball
		part.Size = Vector3.new(1.7, 1.7, 1.7)
		part.Position = Vector3.new(slot.position.x, slot.position.y, slot.position.z)
		part.Anchored = true
		part.CanCollide = false
		part.CanTouch = false
		part.CanQuery = false
		part.CastShadow = false
		part.Material = Enum.Material.Neon
		part:SetAttribute("SlotId", slot.id)
		pickupParts[slot.id] = part
		updatePickup(slot.id)
		part.Parent = pickupFolder
	end
end

-- --------------------------------------------------------------------------- #
-- Stealing. The client sends ONE word and no arguments. Everything that decides
-- the outcome — who is nearest, how far away they are, whether this thief is on
-- cooldown, whether the victim was just hit — is resolved here, from server state.
-- --------------------------------------------------------------------------- #
local STEAL_MESSAGES = {
	ok = "Steal",
	["empty"] = "Nothing carried",
	["out-of-range"] = "No rival in reach",
	["cooldown"] = "Steal recharging",
	["protected"] = "Spawn protection",
	["immune"] = "They just got hit",
	["repeat"] = "Same target too soon",
	["self"] = "That is you",
	["inactive-round"] = "Round not live",
	["missing-player"] = "No rival in reach",
	["invalid-player"] = "No rival in reach",
}

local function resolveSteal(thief: Player, now: number): (string, number, Player?)
	local thiefCharacter, thiefHumanoid, thiefRoot = characterReady(thief)
	if not thiefCharacter or not thiefHumanoid or not thiefRoot then
		return "invalid-player", 0, nil
	end
	if not machine:isParticipating(thief.UserId) then
		return "inactive-round", 0, nil
	end
	-- Short range, measured on the server from the same parts the engine moves.
	local bestDistance: number = math.huge
	local bestVictim: Player? = nil
	for _, other in Players:GetPlayers() do
		if other ~= thief then
			local _, otherHumanoid, otherRoot = characterReady(other)
			if otherRoot and otherHumanoid and machine:isParticipating(other.UserId) then
				local distance = (otherRoot.Position - thiefRoot.Position).Magnitude
				if distance &lt; bestDistance then
					bestDistance, bestVictim = distance, other
				end
			end
		end
	end
	if not bestVictim then
		return "out-of-range", 0, nil
	end
	local outcome, value = machine:trySteal(thief.UserId, bestVictim.UserId, bestDistance, now, machine.roundId)
	return outcome, value, bestVictim
end

local function checkInvariants()
	if not RunService:IsStudio() then
		return
	end
	assert(ledger.running == (machine.phase == "Playing"), "Pickup lifecycle diverged")
	-- Gravity is normal unless the *low gravity* Chaos Event is the live one. Other
	-- kinds leave it alone, so the assertion names the only cause.
	local low = machine.eventActive and machine.eventKind == "LowGravity"
	assert(math.abs(Workspace.Gravity - (if low then Config.Chaos.LowGravity else Config.NormalGravity)) &lt; 0.01, "Gravity failed to reset")
	-- Nothing can be negative, and carried values always sum to the round score.
	for _, player in machine.players do
		assert(player.carriedValue &gt;= 0, "Negative carried value")
		assert(player.score &gt;= player.carriedValue, "Score below the carried stack")
	end
	local previous = math.huge
	for _, row in machine:rows() do
		assert(row.score &gt;= 0 and row.score % 1 == 0 and row.score &lt;= previous, "Invalid score ordering")
		assert(row.coins &gt;= 0 and row.coins % 1 == 0, "Invalid coin balance")
		previous = row.score
	end
	if ledger.running then
		assert(#pickupFolder:GetChildren() == #WorldData.PickupPositions, "Missing pickup replicas")
	else
		assert(#pickupFolder:GetChildren() == 0, "Pickups leaked outside round")
	end
end

-- Make the world match the live Chaos Event. Runs every step, so a missed effect can
-- never leave gravity, friction, jump power or rarity stuck after the window closes.
local function syncChaos()
	local kind = if machine.eventActive then machine.eventKind else ""
	if kind == appliedChaos then
		return
	end
	appliedChaos = kind
	chaos = ChaosRules.modifiers(kind, Config)
	director:apply(chaos)
	world:setLowGravity(kind == "LowGravity")
	ledger:setRareScale(chaos.RareScale)
	-- The bonus switch depends on the Chaos Event, so every player is told at once.
	for _, player in Players:GetPlayers() do
		sendCharacter(player)
	end
end

local function handleEffects(effects, now: number)
	for _, effect in effects do
		dirty = true
		if effect.kind == "event" then
			-- The world itself is changed by syncChaos(), which reconciles on every step.
			if effect.active then
				print(string.format("[Brainrot] chaos ON • %s", tostring(effect.event)))
			else
				print("[Brainrot] chaos OFF")
			end
		elseif effect.kind == "warning" then
			print(string.format("[Brainrot] event warning • %s in %.0fs", tostring(effect.event),
				math.max(0, (effect.at or now) - now)))
		elseif effect.kind == "stage" then
			print(string.format("[Brainrot] stage • %s (banked all carried cells)", tostring(effect.stage)))
		elseif effect.kind == "phase" then
			if machine.phase == "Results" and machine.lastResults then
				-- Pay the round into each profile once, from the machine's own result.
				local winners = {}
				for _, row in machine.lastResults.winners do
					winners[row.id] = true
				end
				for _, row in machine:rows() do
					local profile = profiles:profile(row.id)
					if profile then
						local paid = (machine.lastResults.rewards[tostring(row.id)] or 0)
						Persistence.applyRound(profile, {
							score = row.score, steals = row.steals, lost = row.lost,
							pickups = row.pickups, coins = paid, won = winners[row.id] == true,
							collection = row.collection,
						})
						-- The machine owns live coins; keep them in step with the profile.
						profiles:save(row.id)
					end
				end
			end
			if machine.phase == "Playing" then
				ledger:beginRound(machine.roundId)
				-- Fresh quotas and cooldowns for every player, once per round.
				local ids: { number } = {}
				for _, player in Players:GetPlayers() do
					table.insert(ids, player.UserId)
				end
				CharacterRules.beginRound(characters, ids)
				AbilityService.reset(abilities)
				spawnPickups()
				-- Route every player (including a player whose character is still
				-- loading: routePlayer re-asserts on the next sweep and on
				-- CharacterAdded). Never yields, never blocks the authority loop.
				for _, player in Players:GetPlayers() do
					routePlayer(player, now, true)
				end
			else
				ledger:clear()
				pickupFolder:ClearAllChildren()
				table.clear(pickupParts)
				director:reset()
				AbilityService.reset(abilities)
				if machine.phase == "Intermission" or machine.phase == "Results" or machine.phase == "Waiting" then
					for _, player in Players:GetPlayers() do
						routePlayer(player, now, true)
					end
				end
			end
			for _, player in Players:GetPlayers() do
				applyCharacterTag(player)
				sendCharacter(player)
			end
			print(string.format("[Brainrot] %s • round %d", machine.phase, machine.roundId))
		end
	end
end

local function characterAdded(player: Player, character: Model)
	-- Do not yield the authority loop. Character preparation runs independently.
	task.spawn(function()
		local root = character:WaitForChild("HumanoidRootPart", 10)
		local humanoid = character:WaitForChild("Humanoid", 10)
		if not root or not humanoid or player.Parent ~= Players or player.Character ~= character then
			return
		end
		-- Characters spawn in the lobby; the router decides where they belong and
		-- keeps asserting it. This covers respawns mid-round and joins mid-round.
		route:remove(player.UserId)
		local now = Workspace:GetServerTimeNow()
		-- Spawn protection is real: the machine's clock, not a client's.
		machine:spawnProtect(player.UserId, now)
		routePlayer(player, now, true)
		applyHalo(player)
		AbilityService.forget(abilities, player.UserId)
		applyCharacterTag(player)
		sendCharacter(player)
	end)
end

local function playerAdded(player: Player)
	if records[player.UserId] then
		return
	end
	local accepted = machine:addPlayer(player.UserId, player.DisplayName)
	assert(accepted, "Could not register Roblox player")
	-- Seed the session from the saved profile as soon as it is available. The
	-- machine's numbers stay authoritative for the round; the profile is what
	-- survives it.
	profiles:load(player.UserId, function(profile)
		if machine.players[player.UserId] then
			machine:seedProfile(player.UserId, profile.Coins, profile.Halo)
			applyHalo(player)
			syncStats()
			dirty = true
		end
	end)
	nextSpawn += 1
	local record: Record = { spawnIndex = nextSpawn, connection = nil, requests = {} }
	records[player.UserId] = record
	player.RespawnLocation = world.lobbySpawn
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	for _, name in { "Brain Cells", "Coins", "Wins" } do
		local value = Instance.new("IntValue")
		value.Name = name
		value.Parent = stats
	end
	stats.Parent = player
	record.connection = player.CharacterAdded:Connect(function(character)
		characterAdded(player, character)
	end)
	if player.Character then
		characterAdded(player, player.Character)
	end
	dirty = true
end

Players.PlayerAdded:Connect(playerAdded)
Players.PlayerRemoving:Connect(function(player)
	local record = records[player.UserId]
	if record and record.connection then
		record.connection:Disconnect()
	end
	-- Persist what this session earned before the machine forgets the player.
	local data = machine.players[player.UserId]
	local profile = profiles:profile(player.UserId)
	if data and profile then
		local coins, halo = machine:cosmetics(player.UserId)
		profile.Coins = math.max(profile.Coins, coins)
		profile.Halo = halo
		for species, amount in data.collection do
			profile.Specimens[species] = math.max(profile.Specimens[species] or 0, amount)
		end
		profiles:save(player.UserId)
	end
	records[player.UserId] = nil
	movement:remove(player.UserId)
	route:remove(player.UserId)
	machine:removePlayer(player.UserId)
	CharacterRules.clear(characters, player.UserId)
	AbilityService.forget(abilities, player.UserId)
	dirty = true
end)
for _, player in Players:GetPlayers() do
	playerAdded(player)
end

requestRemote.OnServerEvent:Connect(function(player: Player, action: any, ...: any)
	-- Whitelist small verbs, reject extra arguments, and rate-limit per player/action.
	-- There is intentionally NO score, pickup ID, position, price, or coin amount API.
	if typeof(action) ~= "string" or (action ~= "Snapshot" and action ~= "Halo" and action ~= "Steal") or select("#", ...) ~= 0 then
		return
	end
	local record = records[player.UserId]
	if not record then
		return
	end
	local now = Workspace:GetServerTimeNow()
	local last = record.requests[action] or -math.huge
	if now - last &lt; (if action == "Snapshot" then 1 else 0.75) then
		return
	end
	record.requests[action] = now
	if action == "Steal" then
		-- Mirrors the server's own 8-second rule; the machine enforces it again.
		if now - (record.requests.StealSent or -math.huge) &lt; Config.Steal.Cooldown then
			stateRemote:FireClient(player, snapshot(), STEAL_MESSAGES["cooldown"])
			return
		end
		record.requests.StealSent = now
		local outcome, value, victim = resolveSteal(player, now)
		print(string.format("[Brainrot] steal %s • %s -&gt; %s (+%d)", outcome, player.Name,
			if victim then victim.Name else "nobody", value))
		-- A steal moves score between two players: refresh leaderstats immediately
		-- so the board never shows the old owner for even one frame.
		if outcome == "ok" then
			syncStats()
		end
		if outcome == "ok" and victim then
			-- The victim sees exactly what they lost, from the server's own answer.
			stateRemote:FireClient(victim, snapshot(),
				string.format("STEAL: %s took %d from you", player.DisplayName, value))
			dirty = true
		end
		stateRemote:FireClient(player, snapshot(), STEAL_MESSAGES[outcome] or "Steal refused")
		return
	end
	if action == "Halo" then
		local ok, message = machine:haloAction(player.UserId)
		if ok then
			-- Coins are spent inside the round, then written to the profile: one
			-- transition, one save. A client never sends the price.
			local coins, halo = machine:cosmetics(player.UserId)
			local profile = profiles:profile(player.UserId)
			if profile then
				profile.Coins = coins
				profile.Halo = halo
				profiles:save(player.UserId)
			end
			applyHalo(player)
			syncStats()
			dirty = true
		end
		stateRemote:FireClient(player, snapshot(), message)
	else
		stateRemote:FireClient(player, snapshot())
		sendCharacter(player)
	end
end)

-- ---- character verbs ------------------------------------------------------------
-- Separate, strictly validated remotes. Neither carries an effect, a target or a cell.
abilityRemote.OnServerEvent:Connect(function(player: Player, ...: any)
	if select("#", ...) ~= 0 then
		return
	end
	local record = records[player.UserId]
	if not record then
		return
	end
	local now = Workspace:GetServerTimeNow()
	if now - (record.requests.Ability or -math.huge) &lt; .25 then
		return
	end
	record.requests.Ability = now
	local character, humanoid, root = characterReady(player)
	if not character or not humanoid or not root then
		sendCharacter(player, "ABILITY NEEDS A LIVE CHARACTER")
		return
	end
	local uid = player.UserId
	local active = CharacterRules.ensure(characters, uid).active
	local entry = Config.Characters.Roster[active]
	local ok, reason = CharacterRules.ability(characters, uid, now, {
		phase = machine.phase, participating = machine:isParticipating(uid),
	})
	if not ok then
		sendCharacter(player, REFUSAL_NOTICES[reason] or "ABILITY REFUSED")
		return
	end
	-- Every live participant is a candidate. The caster is excluded inside AbilityRules.
	local candidates: { { player: Player, root: BasePart, humanoid: Humanoid } } = {}
	for _, other in Players:GetPlayers() do
		local _, otherHumanoid, otherRoot = characterReady(other)
		if otherRoot and otherHumanoid and machine:isParticipating(other.UserId) then
			table.insert(candidates, { player = other, root = otherRoot, humanoid = otherHumanoid })
		end
	end
	local affected = AbilityService.perform(abilities, player, character, root, entry, candidates, now)
	for _, victim in affected do
		if victim ~= player then
			sendCharacter(victim, string.format("%s HIT YOU", entry.Title))
		end
	end
	local message
	if entry.Ability == "MindTrick" then
		message = string.format("%s • DECOY LIVE", entry.Title)
	elseif entry.Ability == "BubbleDash" then
		message = entry.Title
	elseif #affected &gt; 0 then
		message = string.format("%s • %d HIT", entry.Title, #affected)
	else
		message = string.format("%s • NOTHING IN RANGE", entry.Title)
	end
	sendCharacter(player, message)
end)

characterRemote.OnServerEvent:Connect(function(player: Player, ...: any)
	if select("#", ...) ~= 1 then
		return
	end
	local slot = ...
	local record = records[player.UserId]
	if not record then
		return
	end
	local now = Workspace:GetServerTimeNow()
	if now - (record.requests.Character or -math.huge) &lt; .25 then
		return
	end
	record.requests.Character = now
	local ok, reason = CharacterRules.switch(characters, player.UserId, slot, {
		phase = machine.phase,
		participating = machine:isParticipating(player.UserId),
		chaos = machine.eventActive == true,
	})
	if ok then
		applyCharacterTag(player)
		local name = Config.Characters.Roster[CharacterRules.ensure(characters, player.UserId).active].Title
		sendCharacter(player, "NOW: " .. name)
	else
		sendCharacter(player, REFUSAL_NOTICES[reason] or "SWITCH REFUSED")
	end
end)

-- Every frame: keeps dashes moving for their duration and walk speeds equal to the live value.
RunService.Heartbeat:Connect(function()
	local now = Workspace:GetServerTimeNow()
	local list: { { player: Player, root: BasePart, humanoid: Humanoid } } = {}
	for _, player in Players:GetPlayers() do
		local _, humanoid, root = characterReady(player)
		if humanoid and root then
			table.insert(list, { player = player, root = root, humanoid = humanoid })
		end
	end
	AbilityService.drive(abilities, now, list)
end)

local accumulator = 0
RunService.Heartbeat:Connect(function(dt: number)
	accumulator += dt
	if accumulator &lt; Config.ServerStep then
		return
	end
	-- Carry the remainder forward so the authority step keeps its 0.1 s cadence and does not
	-- drift with frame timing. The carry is capped at one step, so a long stall cannot cause a
	-- burst of catch-up steps.
	accumulator = math.min(accumulator - Config.ServerStep, Config.ServerStep)
	local now = Workspace:GetServerTimeNow()
	local effects = machine:step(now)
	handleEffects(effects, now)
	syncChaos()
	AbilityService.prune(abilities, now)
	if #effects &gt; 0 then
		-- Checked after the world has been reconciled, so the invariant sees the result.
		checkInvariants()
	end

	if machine.phase == "Playing" then
		for _, id in ledger:step(now) do
			updatePickup(id)
		end
		ledger.respawn = if chaos.Respawn then chaos.Respawn
			elseif machine.stage == "Final" then Config.FinalRespawn
			else Config.PickupRespawn
	else
		ledger.respawn = Config.PickupRespawn
	end
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
		local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
		-- Bouncy World: the jump scale follows the live event. Written only on change.
		if humanoid and humanoid.JumpPower ~= Config.JumpPower * chaos.JumpScale then
			humanoid.JumpPower = Config.JumpPower * chaos.JumpScale
		end
		if not root or not root:IsA("BasePart") or not humanoid or humanoid.Health &lt;= 0 then
			continue
		end
		local p = root.Position
		if p.Y &lt; Config.RescueBelowY then
			route:remove(player.UserId)
			routePlayer(player, now, true)
			continue
		end
		local allowed, correction = movement:observe(player.UserId, position(p), now)
		if correction then
			root.CFrame = CFrame.new(correction.x, correction.y, correction.z)
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
			movement:teleport(player.UserId, correction, now)
			continue
		end
		if not allowed or not machine:isParticipating(player.UserId) then
			continue
		end
		local context = { userId = player.UserId, roundId = machine.roundId, active = true, alive = true, position = position(p) }
		for _, slot in ledger.slots do
			if slot.available then
				local receipt = ledger:tryClaim(slot.id, slot.generation, context, now)
				if receipt then
					assert(machine:award(receipt.userId, receipt.value, receipt.roundId, receipt.species),
						"Atomic award rejected")
					updatePickup(slot.id)
					pickupRemote:FireAllClients(receipt)
					dirty = true
				end
			end
		end
	end

	-- On-demand fallback: a light round-robin sweep proves everyone's destination
	-- every step, so a failed transition self-heals within a fraction of a second
	-- even if the phase effect was missed entirely.
	if machine.phase == "Playing" or machine.phase == "Results" or machine.phase == "Intermission" then
		routeStep += 1
		local ids: { number } = {}
		local byId: { [number]: Player } = {}
		for _, player in Players:GetPlayers() do
			table.insert(ids, player.UserId)
			byId[player.UserId] = player
		end
		for _, id in ArenaRoute.slice(ids, routeStep) do
			local player = byId[id]
			if player then
				routePlayer(player, now, false)
			end
		end
	end

	local second = math.ceil(now)
	if second ~= lastBoardSecond then
		lastBoardSecond = second
		world:setStatus(machine.phase, math.max(0, math.ceil(machine.phaseEndsAt - now)))
	end
	if (dirty and now - lastBroadcast &gt;= Config.SnapshotInterval) or now - lastBroadcast &gt;= 1 then
		syncStats()
		stateRemote:FireAllClients(snapshot())
		dirty = false
		lastBroadcast = now
	end
end)

print(string.format("[Brainrot] v%s ready • %s • %d pickup slots • %ds rounds", Config.Version, if fast then "STUDIO QUICK TEST" else "STANDARD", #ledger.slots, settings.Timing.Round))
</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX001075">
        <Properties>
          <string name="Name">Persistence</string>
          <ProtectedString name="Source">--!nonstrict
-- Persistence for the things that survive a round: coins, the specimen log,
-- lifetime stats and cosmetic choices. Round score never lands here.
--
-- Design rules:
--   * The server is the only writer. The client can *ask* for a cosmetic change
--     (a halo, a colour) and the server validates and stores it; the client can
--     never write a number.
--   * Loading is lazy and cached. A player who joins while a round is live gets
--     their saved state the moment the round ends, never mid-round.
--   * Every write is schema-checked before it is saved, and every read is
--     repaired field by field, so one corrupt key cannot break a profile.
--   * DataStore calls are all pcall-protected with bounded retries. If the service
--     is unavailable the session continues in memory; nothing is lost that the
--     player did this session, it simply is not durable, and we say so in the log.
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")

local Persistence = {}

local VERSION = 1
local STORE_NAME = "BrainrotArenaProfiles"
local MAX_RETRIES = 3
local RETRY_DELAY = 1.5

-- The one definition of a valid profile. `sanitise` is the only way a profile is
-- built, so a hostile or corrupted table cannot reach gameplay code.
local DEFAULTS = {
	Version = VERSION,
	Coins = 0,
	Halo = "None",
	Specimens = {},      -- species -&gt; count (session-persistent)
	Rounds = 0,
	Wins = 0,
	BestScore = 0,
	TotalScore = 0,
	Steals = 0,
	Lost = 0,
	Picked = 0,          -- lifetime pickups
}

local HALOS = { None = true, Cyan = true, Violet = true, Gold = true }

local function clampInt(value, low, high)
	if type(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then
		return low
	end
	return math.clamp(math.floor(value), low, high)
end

function Persistence.sanitise(raw)
	local profile = table.clone(DEFAULTS)
	profile.Specimens = {}
	if type(raw) ~= "table" then
		return profile
	end
	profile.Coins = clampInt(raw.Coins, 0, 1000000000)
	profile.Halo = if type(raw.Halo) == "string" and HALOS[raw.Halo] then raw.Halo else "None"
	profile.Rounds = clampInt(raw.Rounds, 0, 1000000000)
	profile.Wins = clampInt(raw.Wins, 0, 1000000000)
	profile.BestScore = clampInt(raw.BestScore, 0, 1000000)
	profile.TotalScore = clampInt(raw.TotalScore, 0, 1000000000)
	profile.Steals = clampInt(raw.Steals, 0, 1000000000)
	profile.Lost = clampInt(raw.Lost, 0, 1000000000)
	profile.Picked = clampInt(raw.Picked, 0, 1000000000)
	-- Only the six known species, and only plausible counts.
	if type(raw.Specimens) == "table" then
		for species, count in raw.Specimens do
			if type(species) == "string" and #species &lt;= 16 and (count :: any) &gt; 0 then
				profile.Specimens[species] = clampInt(count, 0, 100000)
			end
		end
	end
	-- Wins can never exceed rounds played.
	if profile.Wins &gt; profile.Rounds then
		profile.Wins = profile.Rounds
	end
	return profile
end

-- Apply a round's outcome to a profile. This is the ONLY place that adds coins or
-- stats, and it takes the machine's own result, never a number from a client.
function Persistence.applyRound(profile, result)
	if type(profile) ~= "table" or type(result) ~= "table" then
		return profile
	end
	profile.Rounds += 1
	profile.TotalScore += clampInt(result.score, 0, 1000000)
	profile.Steals += clampInt(result.steals, 0, 1000000)
	profile.Lost += clampInt(result.lost, 0, 1000000)
	profile.Picked += clampInt(result.pickups, 0, 1000000)
	if result.score &gt; profile.BestScore then
		profile.BestScore = clampInt(result.score, 0, 1000000)
	end
	if result.won then
		profile.Wins += 1
	end
	profile.Coins += clampInt(result.coins, 0, 100000)
	if type(result.collection) == "table" then
		for species, count in result.collection do
			if type(species) == "string" then
				profile.Specimens[species] = (profile.Specimens[species] or 0) + clampInt(count, 0, 1000)
			end
		end
	end
	return profile
end

-- --------------------------------------------------------------------------- #
-- Store
-- --------------------------------------------------------------------------- #

local Store = {}
Store.__index = Persistence

function Persistence.new(options)
	local o = options or {}
	local self = setmetatable({}, Store)
	-- Tests can force the degraded path (an unavailable DataStore) without
	-- needing to break the service itself.
	local forcedFailure = o.storeFail == true
	self.available = false
	self.store = nil
	self.profiles = {}       -- userId -&gt; profile (cache: the session's truth)
	self.loaded = {}         -- userId -&gt; true once the durable copy was read
	self.failed = {}         -- userId -&gt; true if the read failed (retry later)
	self.savedAt = {}
	self.memoryOnly = o.memoryOnly ~= false or RunService:IsStudio() and o.persistInStudio ~= true
	self.writes = 0
	self.reads = 0
	self.errors = 0

	if not self.memoryOnly then
		local ok, result = pcall(function()
			if forcedFailure then
				error("DataStore forced unavailable")
			end
			return DataStoreService:GetDataStore(STORE_NAME)
		end)
		if ok and result then
			self.store = result
			self.available = true
		else
			self.errors += 1
			warn("[Brainrot] DataStore unavailable; this server runs in memory only")
		end
	end
	return self
end

function Persistence.key(userId)
	return "p_" .. tostring(userId)
end

function Persistence.profile(self, userId)
	return self.profiles[userId]
end

-- Read one profile. Returns the cached copy immediately and refreshes it in the
-- background; the caller never yields on a DataStore.
function Persistence.load(self, userId, callback)
	if self.profiles[userId] then
		if callback then callback(self.profiles[userId]) end
		return self.profiles[userId]
	end
	self.profiles[userId] = table.clone(DEFAULTS)
	self.profiles[userId].Specimens = {}
	if not self.store then
		self.loaded[userId] = true
		if callback then callback(self.profiles[userId]) end
		return self.profiles[userId]
	end
	task.spawn(function()
		local key = Persistence.key(userId)
		local data = nil
		for attempt = 1, MAX_RETRIES do
			local ok, result = pcall(function()
				return self.store:GetAsync(key)
			end)
			if ok then
				data = result
				self.reads += 1
				break
			end
			self.errors += 1
			warn(string.format("[Brainrot] profile read failed (attempt %d/%d)", attempt, MAX_RETRIES))
			if attempt &lt; MAX_RETRIES then
				task.wait(RETRY_DELAY * attempt)
			end
		end
		self.loaded[userId] = true
		self.failed[userId] = data == nil and false or false
		-- Merge, never replace: anything earned between join and load is kept.
		local merged = Persistence.sanitise(data)
		merged = Persistence.merge(merged, self.profiles[userId])
		self.profiles[userId] = merged
		if callback then callback(merged) end
	end)
	return self.profiles[userId]
end

-- Keep the larger of two values for monotonic counters and the union of the
-- specimen log, so a slow load can never erase a session's progress.
function Persistence.merge(older, newer)
	if type(older) ~= "table" then
		return Persistence.sanitise(newer)
	end
	if type(newer) ~= "table" then
		return Persistence.sanitise(older)
	end
	local out = Persistence.sanitise(older)
	out.Coins = math.max(out.Coins, clampInt(newer.Coins, 0, 1000000000))
	for _, field in { "Rounds", "Wins", "BestScore", "TotalScore", "Steals", "Lost", "Picked" } do
		out[field] = math.max(out[field], clampInt(newer[field], 0, 1000000000))
	end
	if type(newer.Specimens) == "table" then
		for species, count in newer.Specimens do
			if type(species) == "string" then
				out.Specimens[species] = math.max(out.Specimens[species] or 0, clampInt(count, 0, 100000))
			end
		end
	end
	if out.Halo == "None" and type(newer.Halo) == "string" and HALOS[newer.Halo] then
		out.Halo = newer.Halo
	end
	return out
end

-- Save one profile. Schema-checked, retried, and never raises into a gameplay
-- loop: a failed save is logged and retried on the next save point.
function Persistence.save(self, userId, callback)
	local profile = self.profiles[userId]
	if not profile then
		return false
	end
	local payload = Persistence.sanitise(profile)
	if not self.store then
		self.savedAt[userId] = os.time()
		if callback then callback(true) end
		return true
	end
	task.spawn(function()
		local key = Persistence.key(userId)
		for attempt = 1, MAX_RETRIES do
			local ok, result = pcall(function()
				return self.store:SetAsync(key, payload)
			end)
			if ok then
				self.writes += 1
				self.savedAt[userId] = os.time()
				if callback then callback(true, result) end
				return
			end
			self.errors += 1
			warn(string.format("[Brainrot] profile write failed (attempt %d/%d)", attempt, MAX_RETRIES))
			if attempt &lt; MAX_RETRIES then
				task.wait(RETRY_DELAY * attempt)
			end
		end
		if callback then callback(false) end
	end)
	return true
end

-- A cosmetic purchase. `cost` is a server constant, never a client argument.
function Persistence.buyHalo(self, userId, halo, cost)
	local profile = self.profiles[userId]
	if not profile then
		return false, "no-profile"
	end
	if not HALOS[halo] or halo == "None" then
		return false, "unknown-halo"
	end
	if profile.Halo == halo then
		return false, "already-owned"
	end
	if profile.Coins &lt; cost then
		return false, "poor"
	end
	profile.Coins -= cost
	profile.Halo = halo
	return true, "ok"
end

function Persistence.stats(self)
	return {
		available = self.available, memoryOnly = self.memoryOnly,
		reads = self.reads, writes = self.writes, errors = self.errors,
		tracked = (function()
			local count = 0
			for _ in self.profiles do count += 1 end
			return count
		end)(),
	}
end

return Persistence
