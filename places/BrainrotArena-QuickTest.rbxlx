				{ Name = "EyeTurretR", Kind = "ball", Size = {0.36, 0.36, 0.34}, At = {0.4, 0.52, 0.16}, Rot = {0, 0, 0}, Role = "body_light", Material = "SmoothPlastic", Join = "head" },
				{ Name = "EyeL", Kind = "ball", Size = {0.17, 0.17, 0.14}, At = {-0.4, 0.56, 0.32}, Rot = {0, 0, 0}, Role = "ink", Material = "SmoothPlastic", Join = "head" },
				{ Name = "EyeR", Kind = "ball", Size = {0.17, 0.17, 0.14}, At = {0.4, 0.56, 0.32}, Rot = {0, 0, 0}, Role = "ink", Material = "SmoothPlastic", Join = "head" },
				{ Name = "Mouth", Kind = "box", Size = {0.62, 0.07, 0.12}, At = {0, -0.14, 0.58}, Rot = {0, 0, 3}, Role = "ink", Material = "SmoothPlastic" },
