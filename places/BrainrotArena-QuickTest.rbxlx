				{ Name = "Cuff", Kind = "box", Size = {0.7, 0.26, 0.64}, At = {-0.1, 0.74, -0.18}, Rot = {-6, 0, 4}, Role = "cream", Material = "SmoothPlastic" },
				{ Name = "Stripe", Kind = "box", Size = {0.56, 0.1, 0.52}, At = {-0.1, 0.46, -0.16}, Rot = {-6, 0, 4}, Role = "cream", Material = "SmoothPlastic" },
