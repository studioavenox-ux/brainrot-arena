			Idle = { Bob = 0.14, Sway = 0.1, Rate = 1.9, Spin = 0.3 },
			Collect = { Spin = 2.4, Pop = 1.32 },
			Parts = {
				{ Name = "Slice", Kind = "box", Size = {0.86, 1.0, 0.26}, At = {0, 0.04, 0}, Rot = {0, 0, -3}, Role = "body", Material = "SmoothPlastic" },
				{ Name = "ShoulderL", Kind = "ball", Size = {0.34, 0.34, 0.26}, At = {-0.28, 0.5, 0}, Rot = {0, 0, 0}, Role = "body", Material = "SmoothPlastic" },
				{ Name = "ShoulderR", Kind = "ball", Size = {0.34, 0.34, 0.26}, At = {0.28, 0.5, 0}, Rot = {0, 0, 0}, Role = "body", Material = "SmoothPlastic" },
				{ Name = "Crust", Kind = "box", Size = {0.16, 0.96, 0.3}, At = {-0.42, 0.02, 0}, Rot = {0, 0, -3}, Role = "body_dark", Material = "SmoothPlastic" },
				{ Name = "SliceBack", Kind = "box", Size = {0.88, 0.94, 0.24}, At = {0.04, 0.0, -0.24}, Rot = {0, 0, 5}, Role = "body_dark", Material = "SmoothPlastic" },
