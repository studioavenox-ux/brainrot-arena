			Lore = "Knows what you did with the other one.",
			LabelHeight = 1.49,
			Height = 1.42,
			Idle = { Bob = 0.18, Sway = 0.14, Rate = 2.0, Spin = 0.34 },
			Collect = { Spin = 3.0, Pop = 1.28 },
			Parts = {
				{ Name = "Leg", Kind = "box", Size = {0.52, 0.92, 0.5}, At = {-0.1, 0.3, -0.16}, Rot = {-6, 0, 4}, Role = "body", Material = "SmoothPlastic" },
				{ Name = "Foot", Kind = "box", Size = {0.56, 0.4, 0.86}, At = {-0.1, -0.26, 0.16}, Rot = {0, 0, 4}, Role = "body", Material = "SmoothPlastic" },
