        <Item class="ModuleScript" referent="RBX001092">
          <Properties>
            <string name="Name">Creatures</string>
            <ProtectedString name="Source">--!nonstrict
-- The cast — six original characters, built as real Roblox Models.
--
-- One table (tools/creatures.py → CreatureData) drives everything here: geometry,
-- rarity colouring, the animation joints, the floating name card and the collection
-- card art. Nothing is an uploaded asset; every character is primitives, so it is
-- cheap on mobile and identical in the place export and at runtime.
--
-- Rarity colouring: a character's body is tinted from the CELL's rarity colour, which
-- the server owns. Shape carries the identity, colour carries the value, and the
-- floating label names both.
local Shared = require(game:GetService("ReplicatedStorage"):WaitForChild("BrainrotShared"):WaitForChild("Creatures"))
local CreatureData = require(script.Parent.CreatureData)

local Creatures = {}

Creatures.Data = CreatureData
Creatures.Shared = Shared

local FIXED = {}
for role, rgb in CreatureData.Fixed do
	FIXED[role] = Color3.fromRGB(rgb[1], rgb[2], rgb[3])
end

-- Mirror of tools/preview.py:tint, so plates and the game agree.
function Creatures.tint(base, role)
	if role == "body" or role == "neon" then
		return base
	elseif role == "body_light" then
		return base:Lerp(Color3.new(1, 1, 1), .26)
	elseif role == "body_dark" then
		return base:Lerp(Color3.fromRGB(34, 40, 50), .42)
	elseif role == "blush" then
		return base:Lerp(Color3.fromRGB(255, 150, 190), .55)
	end
	return FIXED[role] or base
end

-- Rarity colours are the server's contract (Config.Kinds). Kept here only as a
-- rendering fallback when a caller has no kind colour to hand.
local RARITY_FALLBACK = {
	[1] = Color3.fromRGB(255, 94, 190),
	[5] = Color3.fromRGB(255, 213, 67),
	[10] = Color3.fromRGB(83, 238, 255),
}

function Creatures.colorFor(value)
	return RARITY_FALLBACK[value] or RARITY_FALLBACK[1]
end

local SHAPE = {
	box = Enum.PartType.Block,
	ball = Enum.PartType.Ball,
	cyl = Enum.PartType.Cylinder,
}

local function makePart(spec, base, parent)
	local part = Instance.new("Part")
	part.Name = spec.Name
	part.Shape = SHAPE[spec.Kind] or Enum.PartType.Block
	part.Size = Vector3.new(spec.Size[1], spec.Size[2], spec.Size[3])
	part.Material = Enum.Material[spec.Material] or Enum.Material.SmoothPlastic
	part.Color = Creatures.tint(base, spec.Role)
	part.Anchored = true
	part.CanCollide, part.CanTouch, part.CanQuery, part.CastShadow = false, false, false, false
	part.Massless = true
	part.Transparency = 0
	part.Locked = true
	part.CFrame = CFrame.new(spec.At[1], spec.At[2], spec.At[3])
		* CFrame.Angles(math.rad(spec.Rot[1]), math.rad(spec.Rot[2]), math.rad(spec.Rot[3]))
	part.Parent = parent
	return part
end

-- --------------------------------------------------------------------------- #
-- Label: the floating name + rarity card every character carries
-- --------------------------------------------------------------------------- #
local RARITY_COLOR = {
	Common = Color3.fromRGB(255, 118, 196),
	Rare = Color3.fromRGB(255, 213, 67),
	Legendary = Color3.fromRGB(83, 238, 255),
}

function Creatures.attachLabel(model, name, value, options)
	local o = options or {}
	local spec = CreatureData.Creatures[name]
	if not spec then
		return nil
	end
	local anchor = Instance.new("Part")
	anchor.Name = "LabelAnchor"
	anchor.Size = Vector3.new(.1, .1, .1)
	anchor.Transparency = 1
	anchor.Anchored = true
	anchor.CanCollide, anchor.CanTouch, anchor.CanQuery, anchor.CastShadow = false, false, false, false
	anchor.Massless = true
	anchor.CFrame = CFrame.new(0, spec.LabelHeight, 0)
	anchor.Parent = model

	local gui = Instance.new("BillboardGui")
	gui.Name = "NameTag"
	gui.Size = UDim2.fromOffset(o.width or 132, o.height or 40)
	gui.StudsOffset = Vector3.new(0, 0, 0)
	gui.AlwaysOnTop = o.alwaysOnTop ~= false
	gui.MaxDistance = o.maxDistance or 120
	gui.LightInfluence = 0
	gui.Parent = anchor

	local title = Instance.new("TextLabel")
	title.Name = "Name"
	title.Size = UDim2.new(1, 0, 0, 24)
	title.Position = UDim2.fromOffset(0, 0)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.GothamBlack
	title.TextSize = 18
	title.TextColor3 = Color3.fromRGB(255, 255, 255)
	title.TextStrokeTransparency = .35
	title.Text = spec.Label
	title.Parent = gui

	local rarity = Instance.new("TextLabel")
	rarity.Name = "Rarity"
	rarity.Size = UDim2.new(1, 0, 0, 14)
	rarity.Position = UDim2.fromOffset(0, 23)
	rarity.BackgroundTransparency = 1
	rarity.Font = Enum.Font.GothamBold
	rarity.TextSize = 12
	rarity.TextColor3 = RARITY_COLOR[spec.Rarity] or RARITY_COLOR.Common
	rarity.TextStrokeTransparency = .45
	rarity.Text = string.upper(spec.Rarity) .. "  •  +" .. spec.Value
	rarity.Parent = gui

	return { anchor = anchor, gui = gui, name = title, rarity = rarity }
end

-- --------------------------------------------------------------------------- #
-- Build one character as a Model named after its label.
--   Build(parent, "sock", value, baseColor) -&gt; view
--   view = { model, name, value, parts, joints, idle, collect, label }
-- --------------------------------------------------------------------------- #
function Creatures.Build(parent, name, value, base, options)
	local o = options or {}
	local spec = CreatureData.Creatures[name]
	assert(spec, "Unknown character: " .. tostring(name))
	local tint = base or Creatures.colorFor(value)

	local model = Instance.new("Model")
	model.Name = spec.Label
	model:SetAttribute("Character", name)
	model:SetAttribute("Rarity", spec.Rarity)
	model:SetAttribute("Value", spec.Value)

	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(.4, .4, .4)
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide, root.CanTouch, root.CanQuery, root.CastShadow = false, false, false, false
	root.Massless = true
	root.CFrame = CFrame.new(0, 0, 0)
	root.Parent = model
	model.PrimaryPart = root

	local parts = {}
	local joints = { head = {}, jaw = {}, armL = {}, armR = {}, tail = {} }
	for _, partSpec in spec.Parts do
		local part = makePart(partSpec, tint, model)
		local entry = {
			part = part, home = part.CFrame, joint = partSpec.Join, spec = partSpec,
			homeSize = Vector3.new(partSpec.Size[1], partSpec.Size[2], partSpec.Size[3]),
		}
		table.insert(parts, entry)
		if partSpec.Join and joints[partSpec.Join] then
			table.insert(joints[partSpec.Join], entry)
		end
	end

	local view = {
		model = model,
		root = root,
		name = name,
		value = value,
		base = tint,
		spec = spec,
		parts = parts,
		joints = joints,
		idle = spec.Idle,
		collect = spec.Collect,
		phase = o.phase or 0,
		label = nil,
	}
	if o.label ~= false then
		view.label = Creatures.attachLabel(model, name, value, o)
	end
	model.Parent = parent
	return view
end

-- Recolour in place: the rarity colour can change without rebuilding geometry.
-- Each part remembers its own role, so this can never drift out of order.
function Creatures.SetColor(view, base)
	if not view then
		return
	end
	view.base = base
	for _, entry in view.parts do
		entry.part.Color = Creatures.tint(base, entry.spec.Role)
	end
end

-- --------------------------------------------------------------------------- #
-- Motion. Everything is driven from one clock so a cell never desyncs from its
-- neighbours, and every amplitude collapses to zero under reduced motion.
-- --------------------------------------------------------------------------- #
function Creatures.Idle(view, now, reduced)
	if not view then
		return
	end
	local idle = view.idle
	local t = now * idle.Rate + view.phase
	if reduced then
		view.model:PivotTo(view.root.CFrame)
		return
	end
	local bob = math.sin(t * 1.6) * idle.Bob
	local sway = math.sin(t) * idle.Sway
	local tilt = math.sin(t * .7) * idle.Sway * .5
	-- Torso lean, applied around the model's own pivot.
	local pivot = CFrame.new(0, bob, 0) * CFrame.Angles(0, sway, tilt)
	-- Joints: head sway, jaw chatter, arm swing, tail wag.
	for _, entry in view.joints.head do
		entry.part.CFrame = pivot * entry.home
			* CFrame.Angles(math.sin(t * .9) * .06, math.sin(t * 1.3) * .10, 0)
	end
	for _, entry in view.joints.jaw do
		entry.part.CFrame = pivot * entry.home * CFrame.Angles(math.max(0, math.sin(t * 2.4)) * .10, 0, 0)
	end
	for _, entry in view.joints.armL do
		entry.part.CFrame = pivot * entry.home * CFrame.Angles(0, 0, math.sin(t * 1.7) * .18)
	end
	for _, entry in view.joints.armR do
		entry.part.CFrame = pivot * entry.home * CFrame.Angles(0, 0, -math.sin(t * 1.7 + .6) * .18)
	end
	for _, entry in view.joints.tail do
		entry.part.CFrame = pivot * entry.home * CFrame.Angles(0, math.sin(t * 2.1) * .20, 0)
	end
	for _, entry in view.parts do
		if not entry.joint then
			entry.part.CFrame = pivot * entry.home
		end
	end
	-- The invisible root carries the whole model's placement.
	view.root.CFrame = view.model:GetPivot()
end

-- Spin + pop used at pickup (and by the collection card preview).
function Creatures.Collect(view, progress, reduced)
	if not view or not view.model.Parent then
		return
	end
	if reduced then
		return
	end
	local clamped = math.clamp(progress, 0, 1)
	local pop = 1 + math.sin(clamped * math.pi) * (view.collect.Pop - 1)
	local spin = clamped * view.collect.Spin * math.pi * 2
	local rise = clamped * .9
	-- Pop by scaling each part about its own centre, then spin + lift the model.
	for _, entry in view.parts do
		entry.part.Size = entry.homeSize * pop
	end
	view.model:PivotTo(CFrame.new(0, rise, 0) * CFrame.Angles(0, spin, 0))
end

-- --------------------------------------------------------------------------- #
-- Small helpers used by Effects and the collection UI
-- --------------------------------------------------------------------------- #
function Creatures.variantFor(slotId, value)
	return Shared.SpeciesOf(slotId or 0, value)
end

function Creatures.label(value)
	local family = Shared.Family[value] or Shared.Family[1]
	local spec = Shared.Characters[family[1]]
	return spec and spec.Label or "BRAINY"
end

function Creatures.nameOf(name)
	local spec = Shared.Characters[name]
	return spec and spec.Label or "BRAINY"
end

function Creatures.rarityOf(name)
	local spec = Shared.Characters[name]
	return spec and spec.Rarity or "Common"
end

-- Shared hover ring: the one part every cell keeps, whatever its rarity.
function Creatures.halo(model)
	local spec = CreatureData.Halo
	local part = Instance.new("Part")
	part.Name = spec.Name
	part.Size = Vector3.new(spec.Size[1], spec.Size[2], spec.Size[3])
	part.Shape = Enum.PartType.Cylinder
	part.Material = Enum.Material[spec.Material] or Enum.Material.SmoothPlastic
	part.Color = Color3.new(1, 1, 1)
	part.Transparency = 1
	part.Anchored = true
	part.CanCollide, part.CanTouch, part.CanQuery, part.CastShadow = false, false, false, false
	part.Massless = true
	part.CFrame = CFrame.Angles(0, 0, math.pi / 2)
	part.Parent = model
	return part
end

-- The six collection entries, in display order.
function Creatures.catalogue()
	local out = {}
	for index, name in Shared.Order do
		local spec = Shared.Characters[name]
		local data = CreatureData.Creatures[name]
		table.insert(out, {
			index = index,
			name = name,
			label = spec.Label,
			title = spec.Title,
			rarity = spec.Rarity,
			value = spec.Value,
			blurb = spec.Blurb,
			lore = spec.Lore,
			height = data.Height,
			color = RARITY_FALLBACK[spec.Value],
			rarityColor = RARITY_COLOR[spec.Rarity],
		})
	end
	return out
end

return Creatures
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX001093">
          <Properties>
            <string name="Name">Effects</string>
            <ProtectedString name="Source">--!nonstrict
-- Lightweight local cosmetics. The server's invisible pickup positions never move.
--
-- Each server cell gets one real character Model (src/client/Creatures.luau) with a
-- floating name + rarity card, an idle animation, a shared hover ring and a pickup
-- burst. Everything is built from the generated part tables, so what a client draws
-- is exactly what the server says that cell is.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Iconography = require(script.Parent.Iconography)
local Creatures = require(script.Parent.Creatures)
local Effects = {}
Effects.__index = Effects

local RARITY_COLOR = {
	Common = Color3.fromRGB(255, 118, 196),
	Rare = Color3.fromRGB(255, 213, 67),
	Legendary = Color3.fromRGB(83, 238, 255),
}

local function fxPart(parent, name, size, color)
	local p = Instance.new("Part")
	p.Name, p.Size, p.Color = name, size, color
	p.Anchored = true
	p.CanCollide, p.CanTouch, p.CanQuery, p.CastShadow = false, false, false, false
	p.Material = Enum.Material.SmoothPlastic
	p.Parent = parent
	return p
end

function Effects.new(hud, config)
	local self = setmetatable({
		hud = hud, config = config, visuals = {}, connections = {}, accumulator = 0,
		eventActive = false, lastTone = 0, bursts = {},
	}, Effects)
	self.folder = Instance.new("Folder")
	self.folder.Name = "BrainrotClientFX"
	self.folder.Parent = Workspace
	-- Owned by the client so the low-gravity pulse is purely local feedback.
	-- Saturation stays near neutral: the environment must never look washed out.
	self.tint = Instance.new("ColorCorrectionEffect")
	self.tint.Name = "BrainrotEventTint"
	self.tint.Parent = Lighting
	local pickups = Workspace:WaitForChild("BrainrotPickups")
	for _, child in pickups:GetChildren() do self:add(child) end
	table.insert(self.connections, pickups.ChildAdded:Connect(function(child) self:add(child) end))
	table.insert(self.connections, pickups.ChildRemoved:Connect(function(child) self:remove(child) end))
	table.insert(self.connections, RunService.RenderStepped:Connect(function(dt) self:step(dt) end))
	return self
end

local function kindColor(config, value)
	for _, kind in config.Kinds do
		if kind.Value == value then
			return Color3.fromRGB(kind.Color[1], kind.Color[2], kind.Color[3])
		end
	end
	return Color3.new(1, 1, 1)
end

function Effects:refresh(part)
	local view = self.visuals[part]
	if not view then
		return
	end
	view.active = part:GetAttribute("Active") == true
	view.value = part:GetAttribute("Value") or 1
	view.species = part:GetAttribute("Species") or view.species
	view.displayId = part:GetAttribute("DisplayId") or view.displayId
	self:syncCharacter(view)
	local shown = view.active and view.near
	for _, entry in view.character.parts do
		entry.part.Transparency = if shown then 0 else 1
	end
	if view.character.label then
		view.character.label.gui.Enabled = shown
	end
	-- One neutral self-lit ring per cell: guarantees separation from pale sand and
	-- stone without tinting the character itself.
	view.halo.Transparency = if shown then .34 else 1
	view.halo.Color = Color3.new(1, 1, 1)
	Iconography.apply(view.marks, view.value, view.base, shown)
end

function Effects:add(part)
	if not part:IsA("BasePart") or self.visuals[part] then
		return
	end
	part.LocalTransparencyModifier = 1
	local slotId = part:GetAttribute("SlotId") or 0
	local model = Instance.new("Model")
	model.Name = "CellVisual_" .. tostring(slotId)
	local pivot = fxPart(model, "Pivot", Vector3.new(.1, .1, .1), part.Color)
	pivot.Transparency = 1
	pivot.CFrame = CFrame.new(part.Position)
	model.PrimaryPart = pivot
	local halo = Creatures.halo(model)
	local view = {
		model = model, pivot = pivot, halo = halo, slotId = slotId,
		character = nil, species = nil, displayId = nil, value = 0, base = part.Color,
		marks = nil, active = true, near = true, phase = slotId * .77,
		previous = nil,
	}
	model.Parent = self.folder
	self.visuals[part] = view
	view.connection = part.AttributeChanged:Connect(function()
		self:refresh(part)
	end)
	self:refresh(part)
end

-- Build (or rebuild) the character model for a cell. A rebuild only happens when the
-- server says a different character now occupies the slot — a respawn of the same
-- character just resets it, and a rarity change swaps it with a small pop.
function Effects:syncCharacter(view)
	local value = view.value
	local species = view.species or Creatures.variantFor(view.slotId, value)
	local base = kindColor(self.config, value)
	view.base = base
	local stale = view.character and (view.character.name ~= species
		or view.character.value ~= value
		or (view.displayId ~= nil and view.character.displayId ~= view.displayId))
	if not stale then
		if view.character then
			-- Same character: only the rarity tint can have changed.
			Creatures.SetColor(view.character, base)
			return
		end
	end
	if view.character then
		view.previous = { model = view.character.model, at = os.clock() }
		local previous = view.previous
		task.delay(.32, function()
			-- Retire the outgoing model a beat later so a swap never pops.
			if previous.model and previous.model.Parent then
				previous.model:Destroy()
			end
		end)
	end
	if view.marks then
		for _, item in view.marks.parts do
			item:Destroy()
		end
	end
	local character = Creatures.Build(view.model, species, value, base, { phase = view.phase })
	character.displayId = view.displayId
	view.character = character
	-- Rarity mark in world space, so shape reads value before the label is legible.
	view.marks = Iconography.marks(view.model, base,
		if value == 5 then "crown" elseif value == 10 then "arms" else "none")
	Iconography.apply(view.marks, value, base, view.active and view.near)
	-- Placement: the model's parts are authored around a local origin, so the whole
	-- cell is positioned by moving the pivot (the Model primary part).
	character.model:PivotTo(CFrame.new(view.pivot.Position))
end

function Effects:remove(part)
	local view = self.visuals[part]
	if not view then
		return
	end
	view.connection:Disconnect()
	view.model:Destroy()
	self.visuals[part] = nil
end

function Effects:step(dt)
	self.accumulator += dt
	if self.accumulator &lt; 1 / 30 then
		return
	end
	self.accumulator = 0
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local now = Workspace:GetServerTimeNow()
	local reduced = self.hud.reducedMotion
	local eye = camera.CFrame.Position
	for part, view in self.visuals do
		local near = (part.Position - eye).Magnitude &lt; 150
		if view.near ~= near then
			view.near = near
			self:refresh(part)
		end
		if view.active and near and view.character then
			local character = view.character
			local hover = if reduced then 0
				else math.sin((now + view.phase) * character.idle.Rate * 1.6) * character.idle.Bob
			local spin = if reduced then 0 else ((now + view.phase) * character.idle.Spin) % (math.pi * 2)
			-- Rare and legendary characters breathe a little more, so value reads
			-- before the player is close enough for the name card.
			if view.value &gt; 1 and not reduced then
				view.halo.Transparency = .24 + math.sin((now + view.phase) * 3.1) * .1
			end
			-- Idle animations (bob, sway, jaw, arm swing, tail wag) run per character.
			Creatures.Idle(character, now + view.phase, reduced)
			character.model:PivotTo(
				CFrame.new(part.Position + Vector3.new(0, hover, 0))
					* CFrame.Angles(0, spin, 0)
			)
		end
	end
end

function Effects:update(state)
	if state.eventActive == self.eventActive then
		return
	end
	self.eventActive = state.eventActive
	local properties = {
		TintColor = if state.eventActive then Color3.fromRGB(236, 246, 255) else Color3.new(1, 1, 1),
		Saturation = if state.eventActive then .05 else 0,
		Brightness = if state.eventActive then .02 else 0,
	}
	if self.hud.reducedMotion then
		for key, value in properties do
			self.tint[key] = value
		end
	else
		TweenService:Create(self.tint, TweenInfo.new(.6), properties):Play()
	end
end

-- The pickup effect: a collect animation on the character that was just taken, a
-- burst of the rarity colour, and the score popup.
function Effects:pickup(receipt)
	local own = receipt.userId == Players.LocalPlayer.UserId
	local pos = Vector3.new(receipt.position.x, receipt.position.y, receipt.position.z)
	local tint = kindColor(self.config, receipt.value)
	if receipt.kindIndex and self.config.Kinds[receipt.kindIndex] then
		local kind = self.config.Kinds[receipt.kindIndex]
		tint = Color3.fromRGB(kind.Color[1], kind.Color[2], kind.Color[3])
	end
	local species = receipt.species
	-- Collect animation: the collected character spins, pops and lifts away.
	if species then
		local model = Creatures.Build(self.folder, species, receipt.value, tint,
			{ label = false, phase = 0 })
		model.root.Transparency = 1
		local label = Creatures.attachLabel(model.model, species, receipt.value,
			{ width = 140, height = 44 })
		if label then
			label.name.Text = "+" .. tostring(receipt.value)
			label.rarity.Text = string.upper(Creatures.rarityOf(species))
		end
		self:collectAnimation(model, pos, tint)
	end
	if own then
		self.hud:pulse()
		local now = os.clock()
		if self.hud.soundOn and now - self.lastTone &gt; .07 then
			self.lastTone = now
			local sound = Instance.new("Sound")
			sound.Name = "CellChime"
			-- Roblox's bundled short tone; no uploaded or third-party sound assets required.
			sound.SoundId = "rbxasset://sounds/electronicpingshort.wav"
			sound.Volume = .2
			sound.PlaybackSpeed = .95 + (receipt.kindIndex or 1) * .12
			sound.Parent = SoundService
			sound:Play()
			Debris:AddItem(sound, 3)
		end
		local anchor = fxPart(self.folder, "ScorePopup", Vector3.new(.1, .1, .1), tint)
		anchor.Position, anchor.Transparency = pos + Vector3.new(0, 2, 0), 1
		local gui = Instance.new("BillboardGui")
		gui.Size, gui.AlwaysOnTop, gui.MaxDistance = UDim2.fromOffset(100, 50), true, 100
		gui.Parent = anchor
		local label = Instance.new("TextLabel")
		label.Size, label.BackgroundTransparency = UDim2.fromScale(1, 1), 1
		label.Text, label.TextColor3 = "+" .. receipt.value, tint
		label.Font, label.TextSize, label.TextStrokeTransparency = Enum.Font.GothamBlack, 32, .6
		label.Parent = gui
		TweenService:Create(anchor, TweenInfo.new(.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = anchor.Position + Vector3.new(0, 2.8, 0) }):Play()
		TweenService:Create(label, TweenInfo.new(.7), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		Debris:AddItem(anchor, .8)
	end
	local camera = Workspace.CurrentCamera
	if self.hud.reducedMotion or not camera or (camera.CFrame.Position - pos).Magnitude &gt; 100 then
		return
	end
	-- Burst: a ring of neon sparks in the rarity colour, plus a rising halo ring that
	-- expands and fades. Deliberately cheap: 8 parts, all recycled by Debris.
	for i = 1, 7 do
		local spark = fxPart(self.folder, "Spark", Vector3.new(.3, .3, .3), tint)
		spark.Shape, spark.Material, spark.Position = Enum.PartType.Ball, Enum.Material.Neon, pos
		local angle = i * math.pi * 2 / 7
		local target = pos + Vector3.new(math.cos(angle) * 2.2, 1.5 + (i % 3) * .6, math.sin(angle) * 2.2)
		TweenService:Create(spark, TweenInfo.new(.42, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = target, Size = Vector3.new(.05, .05, .05), Transparency = 1 }):Play()
		Debris:AddItem(spark, .5)
	end
	local ring = fxPart(self.folder, "BurstRing", Vector3.new(.06, .8, .8), tint)
	ring.Shape, ring.Material, ring.Position = Enum.PartType.Cylinder, Enum.Material.Neon, pos
	ring.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.pi / 2)
	TweenService:Create(ring, TweenInfo.new(.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Size = Vector3.new(.06, 3.4, 3.4), Transparency = 1 }):Play()
	Debris:AddItem(ring, .55)
end

-- 0.5 s collect flourish on a throwaway model, then it is destroyed.
function Effects:collectAnimation(view, pos, tint)
	local start = os.clock()
	view.model:PivotTo(CFrame.new(pos))
	local connection
	connection = RunService.RenderStepped:Connect(function()
		local progress = (os.clock() - start) / .5
		if progress &gt;= 1 or not view.model.Parent then
			connection:Disconnect()
			view.model:Destroy()
			return
		end
		if self.hud.reducedMotion then
			return
		end
		Creatures.Collect(view, progress, false)
		-- The character itself lifts to the player's eye line as it flies away.
		local lifted = pos + Vector3.new(0, 1.2 + progress * 2.4, 0)
			+ Vector3.new(math.sin(progress * 6) * .3, 0, 0)
		view.model:PivotTo(CFrame.new(lifted) * CFrame.Angles(0, progress * math.pi * 2, 0))
		for _, entry in view.parts do
			entry.part.Transparency = math.max(0, (progress - .55) / .45)
		end
		if view.label then
			view.label.name.TextTransparency = math.max(0, (progress - .4) / .4)
			view.label.rarity.TextTransparency = view.label.name.TextTransparency
		end
	end)
	table.insert(self.connections, connection)
end

function Effects:destroy()
	for _, connection in self.connections do
		connection:Disconnect()
	end
	local parts = {}
	for part in self.visuals do
		table.insert(parts, part)
	end
	for _, part in parts do
		self:remove(part)
	end
	self.folder:Destroy()
	self.tint:Destroy()
end

return Effects
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX001094">
          <Properties>
            <string name="Name">Hud</string>
            <ProtectedString name="Source">--!nonstrict
-- The interface. Every value shown here arrives in a server snapshot; nothing is
-- invented locally. Layout is responsive (desktop / tablet / phone portrait and
-- landscape) and every button opens a real panel or sends a whitelisted request.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Species = require(ReplicatedStorage:WaitForChild("BrainrotShared"):WaitForChild("Creatures"))
local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)
local Panels = require(script.Parent.Panels)
local Iconography = require(script.Parent.Iconography)
local Collection = require(script.Parent.Collection)
local CreatureData = require(script.Parent.CreatureData)
local Hud = {}
Hud.__index = Hud

-- Number keys 1-6 select the character in that slot.
local KEY_SLOTS = {
	[Enum.KeyCode.One] = 1, [Enum.KeyCode.Two] = 2, [Enum.KeyCode.Three] = 3,
	[Enum.KeyCode.Four] = 4, [Enum.KeyCode.Five] = 5, [Enum.KeyCode.Six] = 6,
}

local C, Type, Space, Motion, Copy = Theme.Colors, Theme.Type, Theme.Space, Theme.Motion, Theme.Copy

local function timeString(remaining)
	local seconds = math.max(0, math.ceil(remaining))
	return string.format("%02d:%02d", math.floor(seconds / 60), seconds % 60)
end

local function phaseWord(phase, fastMode)
	if phase == "Playing" then
		return Copy.PlayingStatus
	elseif phase == "Intermission" then
		return Copy.IntermissionStatus
	elseif phase == "Results" then
		return Copy.ResultsStatus
	end
	return Copy.WaitingStatus
end

-- Chaos Event kinds -&gt; the words the player reads. Mirrors RoundMachine's LABEL, which
-- the server also sends in the snapshot schedule.
local EVENT_LABEL = {
	LowGravity = "LOW GRAVITY",
	BouncyWorld = "BOUNCY WORLD",
	SlipperyChaos = "SLIPPERY CHAOS",
	BrainCellRush = "BRAIN CELL RUSH",
}

local function eventLabel(kind)
	if type(kind) ~= "string" or kind == "" then
		return Copy.EventBanner
	end
	return EVENT_LABEL[kind] or string.upper(kind)
end

function Hud.new(config, request, actions)
	local self = setmetatable({}, Hud)
	self.config, self.request = config, request
	self.soundOn, self.reducedMotion = true, false
	self.state, self.rows, self.connections = nil, {}, {}
	self.noticeToken, self.noticeSerial = 0, 0
	self.lastPhase, self.lastEvent = "", false
	self.modalKind = nil
	self.userId = Players.LocalPlayer.UserId

	-- ScreenInsets is missing from older Studio builds. Without it the HUD still builds;
	-- it only loses the core-UI safe-area inset.
	local screenProperties = {
		Name = "BrainrotHUD",
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 10,
	}
	if Enum.ScreenInsets then
		screenProperties.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
	end
	self.screen = Kit.instance("ScreenGui", screenProperties, Players.LocalPlayer:WaitForChild("PlayerGui"))
	self.root = Kit.instance("Frame", {
		Name = "SafeArea", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
	}, self.screen)
	-- Scrims are built after `root` exists; declared here so resize() can see them.

	-- ---- legibility scrims (never interactive) ------------------------------
	-- The world is bright; a soft navy wash at the top and bottom keeps translucent
	-- panels readable without dimming the play space in the middle of the screen.
	self.scrimTop = Kit.scrim(self.root, 170, true, { zIndex = 0 })
	self.scrimBottom = Kit.scrim(self.root, 130, false, { zIndex = 0 })

	-- ---- top HUD: brand, brain cells, round timer, coins --------------------
	self.top = Panels.topHud(self.root, {
		Specimens = function() self:showCollection() end,
	})

	-- ---- leaderboard (right) ----------------------------------------------
	self.board = Panels.leaderboard(self.root)
	self.boardVisible = true
	self.ranksTouched = false

	-- ---- bottom action bar: shop / inventory / settings --------------------
	self.actions = Panels.actionBar(self.root, {
		Shop = function() self:showModal("Shop") end,
		Inventory = function() self:showCollection() end,
		Settings = function() self:showModal("Settings") end,
	})

	-- ---- steal action (right, above the bottom edge) -----------------------
	-- The only offensive verb in the game. It sends a whitelisted request with no
	-- arguments; the server decides who is in range and what (if anything) moves.
	self.steal = Panels.stealPanel(self.root, function() self:requestSteal() end)

	-- ---- characters: ability button and the six-slot strip ------------------
	-- Each verb sends its own validated remote. The server owns every answer; the client
	-- only shows the view it was last sent.
	self.verbs = actions or {}
	self.character = nil
	self.ability = Panels.abilityPanel(self.root, function() self:requestAbility() end)
	self.strip = Panels.characterStrip(self.root, function(slot) self:requestSwitch(slot) end,
		#config.Characters.Order)

	-- ---- stage chip (left, under the cells) --------------------------------
	self.stageChip = Kit.panel(self.root, "StageChip", UDim2.fromOffset(196, 28), UDim2.fromOffset(Space.xl, 136), {
		zIndex = 2, radius = 10, color = C.NavyRaised, visible = false,
	})
	self.stageText = Kit.text(self.stageChip, "Stage", "", "Label", {
		size = UDim2.new(1, -16, 1, 0), position = UDim2.fromOffset(8, 0),
		color = C.Amber, zIndex = 3, truncate = true,
	})

	-- ---- centre messaging --------------------------------------------------
	self.toast = Panels.toast(self.root)
	self.event = Panels.eventBanner(self.root)
	self.lobby = Panels.lobbyBanner(self.root)

	-- ---- rarity key above the action bar -----------------------------------
	self.legend = Kit.panel(self.root, "RarityKey", UDim2.fromOffset(368, 26), UDim2.new(.5, 0, 1, -Space.lg - 52 - 32), {
		anchor = Vector2.new(.5, 0), radius = 10, transparency = .3, zIndex = 2,
	})
	for index, entry in { { "+1  BRAIN / FROG", C.Cyan, 1 }, { "+5  FISH / GOOSE", C.Amber, 5 }, { "+10  TOAST / SOCK", C.Violet, 10 } } do
		local slot = Kit.instance("Frame", {
			Name = "Rarity" .. index,
			Size = UDim2.fromOffset(120, 26),
			Position = UDim2.fromOffset(6 + (index - 1) * 120, 0),
			BackgroundTransparency = 1,
			ZIndex = 3,
		}, self.legend)
		local label = Kit.text(slot, "Label", entry[1], "Micro", {
			size = UDim2.new(1, -24, 1, 0), position = UDim2.fromOffset(22, 0),
			color = entry[2], truncate = true, zIndex = 4,
		})
		label.Font = Enum.Font.GothamMedium
		Iconography.glyph(slot, entry[3], entry[2]).Position = UDim2.fromOffset(3, 5)
	end

	-- ---- results card ------------------------------------------------------
	self.results = Kit.panel(self.root, "Results", UDim2.fromOffset(468, 268), UDim2.fromScale(.5, .44), {
		anchor = Vector2.new(.5, .5), zIndex = 8, visible = false, padding = Space.xl,
	})
	Kit.text(self.results, "Eyebrow", Copy.ResultsStatus, "Label", {
		size = UDim2.new(1, 0, 0, 16), color = C.Cyan, xAlign = Enum.TextXAlignment.Center,
	})
	self.resultTitle = Kit.text(self.results, "Title", Copy.WinBanner, "Display", {
		size = UDim2.new(1, 0, 0, 44), position = UDim2.fromOffset(0, 22),
		color = C.Amber, xAlign = Enum.TextXAlignment.Center, truncate = true,
	})
	self.resultName = Kit.text(self.results, "Winner", "", "Heading", {
		size = UDim2.new(1, 0, 0, 52), position = UDim2.fromOffset(0, 70),
		color = C.White, xAlign = Enum.TextXAlignment.Center, wrapped = true,
	})
	self.resultCast = Kit.text(self.results, "Cast", "", "Micro", {
		size = UDim2.new(1, 0, 0, 14), position = UDim2.fromOffset(0, 124),
		color = C.Dim, xAlign = Enum.TextXAlignment.Center, truncate = true,
	})
	Kit.divider(self.results, 146, Space.xl)
	self.resultReward = Kit.text(self.results, "Reward", "", "Title", {
		size = UDim2.new(1, 0, 0, 30), position = UDim2.fromOffset(0, 158),
		color = C.Amber, xAlign = Enum.TextXAlignment.Center,
	})
	self.resultNext = Kit.text(self.results, "Next", "", "Micro", {
		size = UDim2.new(1, 0, 0, 30), position = UDim2.fromOffset(0, 196),
		color = C.Muted, xAlign = Enum.TextXAlignment.Center, wrapped = true,
	})

	-- ---- modal: shop / inventory / settings / help --------------------------
	self.modal = Kit.instance("Frame", {
		Name = "ModalLayer", Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.Void,
		BackgroundTransparency = .35, Visible = false, ZIndex = 20, Active = true,
	}, self.root)
	self.modalCard = Kit.panel(self.modal, "Card", UDim2.fromOffset(468, 348), UDim2.fromScale(.5, .5), {
		anchor = Vector2.new(.5, .5), zIndex = 21, padding = Space.xl,
	})
	self.modalTitle = Kit.text(self.modalCard, "Title", Copy.ShopTitle, "Title", {
		size = UDim2.new(1, -60, 0, 26), color = C.Amber, zIndex = 22,
	})
	self.modalBody = Kit.text(self.modalCard, "Body", "", "Body", {
		size = UDim2.new(1, 0, 1, -120), position = UDim2.fromOffset(0, 34),
		color = C.White, wrapped = true, zIndex = 22,
	})
	self.modalBody.TextYAlignment = Enum.TextYAlignment.Top
	self.modalFocus = nil
	self.modalPrimary = Kit.button(self.modalCard, "Action", "UNLOCK", UDim2.new(1, -56, 0, 44),
		UDim2.new(0, 0, 1, -44), function() self:activateModal() end,
		{ accent = C.Amber, zIndex = 22 })
	self.modalSound = Kit.button(self.modalCard, "ModalSound", "SFX ON", UDim2.fromOffset(110, 34),
		UDim2.new(0, 0, 1, -88), function() self:toggleSound() end, { accent = C.Cyan, zIndex = 22 })
	self.modalMotion = Kit.button(self.modalCard, "ModalMotion", "MOTION: FULL", UDim2.fromOffset(132, 34),
		UDim2.new(0, 118, 1, -88), function() self:toggleMotion() end, { accent = C.Violet, zIndex = 22 })
	self.modalClose = Kit.button(self.modalCard, "Close", "X", UDim2.fromOffset(36, 36),
		UDim2.new(1, -36, 0, 0), function() self:closeModal() end, { accent = C.NavyEdge, zIndex = 22 })
	self.modalClose.Label.TextSize = Type.Body

	-- ---- collection screen (six 3D specimen cards) --------------------------
	self.collection = Collection.new(self.root, self.config)

	-- ---- persistent secondary buttons -------------------------------------
	self.helpButton = Kit.button(self.root, "Help", "?", UDim2.fromOffset(36, 36),
		UDim2.fromOffset(Space.xl, 148), function() self:showModal("Help") end,
		{ accent = C.Cyan, zIndex = 3 })
	-- AnchorPoint (1,0) so every Position below is measured from the right edge.
	self.ranksButton = Kit.button(self.root, "Ranks", "RANKS", UDim2.fromOffset(84, 32),
		UDim2.new(1, -Space.lg - 84, 0, 128), function() self:toggleBoard() end,
		{ accent = C.Violet, zIndex = 3, anchor = Vector2.new(1, 0) })

	-- ---- input -------------------------------------------------------------
	self.modal.Parent = self.root
	self.ranksButton.Activated:Connect(function() self.ranksTouched = true end)
	table.insert(self.connections, UserInputService.InputBegan:Connect(function(input, processed)
		if processed or UserInputService:GetFocusedTextBox() then return end
		if input.KeyCode == Enum.KeyCode.Tab then
			self:toggleBoard()
			self.ranksTouched = true
		elseif input.KeyCode == Enum.KeyCode.H then
			if self.modal.Visible then self:closeModal() else self:showModal("Help") end
		elseif input.KeyCode == Enum.KeyCode.Escape and self.collection:isVisible() then
			self:hideCollection()
		elseif input.KeyCode == Enum.KeyCode.Escape and self.modal.Visible then
			self:closeModal()
		elseif input.KeyCode == Enum.KeyCode.C then
			if self.collection:isVisible() then self:hideCollection() else self:showCollection() end
		elseif input.KeyCode == Enum.KeyCode.B then
			self:showModal("Shop")
		elseif input.KeyCode == Enum.KeyCode.E then
			self:requestSteal()
		elseif input.KeyCode == Enum.KeyCode.Q then
			self:requestAbility()
		elseif KEY_SLOTS[input.KeyCode] then
			self:requestSwitch(KEY_SLOTS[input.KeyCode])
		end
	end))
	table.insert(self.connections, self.root:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		self:resize()
	end))
	self:resize()
	return self
end

-- --------------------------------------------------------------------------- #
-- Layout
-- --------------------------------------------------------------------------- #
function Hud:resize()
	local size = self.root.AbsoluteSize
	local width, height = size.X, size.Y
	if width &lt; 1 or height &lt; 1 then return end
	local compact = width &lt; 780
	local short = height &lt; 520
	local portrait = width &lt; height
	self.compact, self.short, self.portrait = compact, short, portrait

	local top = self.top
	self.scrimTop.Size = UDim2.new(1, 0, 0, math.min(190, math.max(120, height * .26)))
	self.scrimBottom.Size = UDim2.new(1, 0, 0, math.min(150, math.max(100, height * .2)))
	self.scrimBottom.Position = UDim2.new(0, 0, 1, -self.scrimBottom.Size.Y.Offset)
	-- Brand lockup: desktop only. Phones hide the whole cluster (wordmark AND
	-- tagline) because the cell counter already carries the identity up there and
	-- a stray tagline was showing through behind the coin panel.
	top.brand.Visible = not compact and not short
	top.brand.Position = UDim2.fromOffset(Space.xl, Space.lg)
	if top.brandTag then
		top.brandTag.Visible = top.brand.Visible
	end

	-- brain-cell counter: under the brand on desktop, top-left on compact
	-- Narrow phones cannot fit a 128px cell chip, a 96px clock and a 112px coin
	-- chip side by side (they summed to 336 on a 320pt screen), so the two end
	-- chips give way first.
	local narrow = compact and width &lt; 380
	top.cells.Size = UDim2.fromOffset(if narrow then 92 elseif compact then 128 else 196,
		if short then 44 else 52)
	top.cells.Position = if compact then UDim2.fromOffset(Space.md, Space.md)
		else UDim2.fromOffset(Space.xl, 78)

	-- coin counter: top-right, never overlapping the clock. Sized before the clock
	-- because the clock's phone width is derived from the space it leaves.
	local coinWidth = if narrow then 96 elseif compact then 112 else 152
	top.coins.Size = UDim2.fromOffset(coinWidth, if short then 44 else 52)
	top.coins.Position = UDim2.new(1, -Space.md, 0, if compact then Space.sm else Space.lg)

	-- round clock: always centred at the top, shrinks on phones
	-- The clock keeps its centre line and narrows to whatever the two chips leave,
	-- so all three chips stay in one band. 88px is the floor where "00:00" reads.
	local clockWidth = math.clamp(width - 340, 150, 212)
	if compact then
		local cellChipRight = Space.md + top.cells.Size.X.Offset
		local coinChipLeft = width - Space.md - coinWidth
		clockWidth = math.clamp(coinChipLeft - cellChipRight - Space.lg, 88, 190)
	end
	top.clock.Size = UDim2.fromOffset(clockWidth, if short then 62 else 76)
	top.clock.Position = UDim2.new(.5, 0, 0, if short then Space.sm else Space.lg)
	top.time.TextSize = if short then 26 elseif compact then 30 else Type.Display
	top.roundLabel.Visible = not short
	top.divider.Visible = not short
	top.coinValue.TextSize = if compact then 18 else Type.Title
	top.coinValue.Size = UDim2.new(1, -40, 0, 24)
	-- Specimen chip sits under the coin counter, same width, so the right column
	-- reads as one stack.
	top.specimens.Size = UDim2.fromOffset(if compact then coinWidth else 152, 30)
	-- Phones: the coin chip is 112 wide and right-anchored, so it eats into the
	-- centre. The specimen chip tucks under it and clears the clock in both
	-- directions — it used to sit at y=66, straight through a 76px-tall clock.
	local clockRightHalf = (clockWidth * .5) + Space.xs
	local specimenX = if compact then clockRightHalf + Space.md + 4 else Space.md
	-- The clock sits at Space.sm from the top on short screens and Space.lg otherwise.
	local specimenY = (if short then Space.sm else Space.lg) + top.clock.Size.Y.Offset + Space.xs
	top.specimens.Position = UDim2.new(1, -specimenX, 0,
		if compact then specimenY else (Space.lg + 60))

	-- leaderboard
	local board = self.board
	board.board.Visible = self:boardShown()
	board.board.Size = UDim2.fromOffset(if compact then 196 else 232,
		math.clamp(height - (if short then 232 elseif compact then 190 else 230),
			if short then 96 else 150, 320))
	board.board.Position = UDim2.new(1, -Space.md, 0, if short then 118 elseif compact then 118 else 162)
	-- The RANKS chip sits below the specimen chip on phones (they used to overlap)
	-- and hides itself while the board is open, because then it would be a button
	-- for the thing already on screen.
	self.ranksButton.Visible = (compact or short) and not ((compact or short) and self:boardShown())
	-- Right-aligned with the coin/specimen stack, and on short landscape it sits in
	-- the 54..96 gap between the coin chip and the specimen chip. It used to tuck up
	-- to y=40, which put it straight through the bottom of the coin chip.
	local ranksWidth = if compact then 68 else 84
	local ranksTop = if compact then top.specimens.Position.Y.Offset + top.specimens.Size.Y.Offset + Space.xs
		else 128
	self.ranksButton.Size = UDim2.fromOffset(ranksWidth, 32)
	self.ranksButton.Position = UDim2.new(1, -Space.md - ranksWidth, 0, ranksTop)

	-- Action bar. On phones it sits above the thumbstick and jump zones so a tap on
	-- the shop never registers as a jump; on desktop it hugs the bottom edge.
	local barLift = if compact then 118 else Space.lg
	self.actions.bar.Position = UDim2.new(.5, 0, 1, -barLift - 52)
	self.actions.bar.Visible = true
	for _, name in { "Shop", "Inventory", "Settings" } do
		local button = self.actions.buttons[name]
		button.Size = UDim2.fromOffset(if compact then 76 else 84, 52)
		button.Position = UDim2.fromOffset(
			(if name == "Shop" then 0 elseif name == "Inventory" then (if compact then 84 else 92) else (if compact then 168 else 184)),
			0)
	end
	self.actions.bar.Size = UDim2.fromOffset(if compact then 252 else 268, 52)
	self.legend.Visible = not compact and not short
	self.legend.Position = UDim2.new(.5, 0, 1, -barLift - 52 - 32)

	-- help button sits under the stage chip on desktop, beside the cell counter on
	-- phones; either way it is clear of every other control.
	self.helpButton.Position = if compact then UDim2.new(0, Space.md, 0, 74) else UDim2.fromOffset(Space.xl, 172)

	-- toasts and banners. Two placements, decided by the width actually free at the
	-- top: a wide-short landscape phone keeps them in the corridor between the cell
	-- chip and the right-hand column, while a portrait phone has no corridor at all
	-- and stacks them under the whole top block. Pinning them at a fixed 112/174
	-- used to run the toast straight through the specimen chip.
	local corridor = (width - Space.md - coinWidth) - (Space.md + top.cells.Size.X.Offset)
		- Space.md * 2
	local stacked = corridor &lt; 360
	local bandTop = if stacked
		then math.max(top.specimens.Position.Y.Offset + top.specimens.Size.Y.Offset,
			ranksTop + self.ranksButton.Size.Y.Offset) + Space.sm
		else (if short then 84 else 112)
	local toastWidth = math.min(width - 32, 432, if stacked then width - 32 else corridor)
	self.toast.frame.Size = UDim2.fromOffset(toastWidth, 56)
	self.toast.frame.Position = UDim2.new(.5, 0, 0, bandTop)
	local eventTop = bandTop + self.toast.frame.Size.Y.Offset + Space.sm
	self.event.frame.Size = UDim2.fromOffset(math.min(width - 40, 320), 34)
	self.event.frame.Position = UDim2.new(.5, 0, 0, eventTop)
	local lobbyTop = eventTop + self.event.frame.Size.Y.Offset + Space.sm
	self.lobby.frame.Size = UDim2.fromOffset(math.min(width - 32, 420), 92)
	self.lobby.frame.Position = UDim2.new(.5, 0, 0, lobbyTop)

	-- Steal action. Portrait/desktop: bottom-right. Short landscape: bottom-LEFT,
	-- above the thumbstick, so it cannot sit under the leaderboard or the jump pad.
	local stealLift = if compact then 118 else Space.lg
	if short then
		self.steal.root.Position = UDim2.fromOffset(Space.md, height - stealLift - 52)
	else
		self.steal.root.Position = UDim2.new(1, -Space.md, 1, -stealLift - 52)
	end
	self.steal.root.Size = UDim2.fromOffset(if compact then 150 else 186, 52)
	self.steal.button.Size = self.steal.root.Size
	self.steal.readout.Size = UDim2.fromOffset(if compact then 150 else 186, 30)
	self.steal.readout.Position = UDim2.fromOffset(0, -38)
	self.steal.label.TextSize = if compact then 13 else Type.Heading
	self.steal.caption.TextSize = Type.Micro
	self.steal.carried.TextSize = if compact then Type.Micro else Type.Label
	self.steal.banked.Visible = not compact

	-- Ability button sits beside the steal button, on the side away from the screen edge
	-- the steal button is not on. The strip sits above the steal readout.
	local stealWidth = if compact then 150 else 186
	local abilityWidth = if compact then 118 else 150
	if short then
		self.ability.root.AnchorPoint = Vector2.new(0, 0)
		self.ability.root.Position = UDim2.fromOffset(Space.md + stealWidth + Space.sm, height - stealLift - 52)
	else
		self.ability.root.AnchorPoint = Vector2.new(1, 0)
		self.ability.root.Position = UDim2.new(1, -Space.md - stealWidth - Space.sm, 1, -stealLift - 52)
	end
	self.ability.root.Size = UDim2.fromOffset(abilityWidth, 52)
	self.ability.button.Size = self.ability.root.Size
	self.ability.label.TextSize = if compact then 12 else Type.Heading
	self.ability.caption.TextSize = Type.Micro

	local stripTop = -stealLift - 52 - 74
	self.strip.root.Size = UDim2.fromOffset(6 * 32 + 5 * 4, 46)
	if short then
		self.strip.root.AnchorPoint = Vector2.new(0, 0)
		self.strip.root.Position = UDim2.fromOffset(Space.md, height + stripTop)
	else
		self.strip.root.AnchorPoint = Vector2.new(1, 0)
		self.strip.root.Position = UDim2.new(1, -Space.md, 1, stripTop)
	end

	-- Stage chip: desktop only, under the cell counter and above the help chip. On
	-- phones the stage is named by the clock header instead, which keeps the top of
	-- a small screen uncrowded and still answers "how long until the next bank?".
	self.stageChip.Visible = not compact and not short
		and self.state ~= nil and (self.state.stage or "") ~= ""
	self.stageChip.Size = UDim2.fromOffset(196, 26)
	self.stageChip.Position = UDim2.fromOffset(Space.xl, 136)

	-- cards
	self.results.Size = UDim2.fromOffset(math.min(width - 32, 468), math.min(height - 32, 268))
	self.resultTitle.TextSize = if compact then 24 else Type.Display
	self.modalCard.Size = UDim2.fromOffset(math.min(width - 28, 468), math.min(height - 24, 348))
	self.modalPrimary.Size = UDim2.new(1, -56, 0, 44)
	self.modalBody.TextSize = if short then 12 elseif compact then 13 else Type.Body
	self.modalTitle.TextSize = if compact then 18 else Type.Title
	self.collection:resize(width, height)

	if self.state then self:updateLocalValues() end
end

-- True when the leaderboard is actually on screen for this viewport. On phones and
-- on short landscape screens the board is opt-in (RANKS), because at 354 px of
-- height it would otherwise sit under the action bar and the steal panel.
function Hud:boardShown()
	return self.boardVisible and not ((self.compact or self.short) and not self.ranksTouched)
end

function Hud:toggleBoard()
	self.boardVisible = not self.boardVisible
	self.board.board.Visible = self.boardVisible
	-- The RANKS chip and the board are mutually exclusive on phones.
	self:resize()
end

-- --------------------------------------------------------------------------- #
-- Server state
-- --------------------------------------------------------------------------- #
function Hud:update(state)
	self.state = state
	self.localRow = nil
	-- The server sends rows in rank order; sort defensively so a stale snapshot can
	-- never show a lower score above a higher one.
	local ordered = table.clone(state.rows)
	table.sort(ordered, function(a, b)
		if a.score ~= b.score then return a.score &gt; b.score end
		return a.name &lt; b.name
	end)
	local found = {}
	for index, row in ordered do
		found[row.id] = true
		if row.id == self.userId then self.localRow = row end
		local view = self.rows[row.id]
		if not view then
			view = Panels.row(self.board.roster, row.id, index)
			self.rows[row.id] = view
		end
		local mine = row.id == self.userId
		view.frame.LayoutOrder = index
		view.frame.BackgroundColor3 = if mine then C.NavyRaised else C.Navy
		view.frame.BackgroundTransparency = if mine then .05 else .4
		view.accent.BackgroundColor3 = if index == 1 then C.Amber else (if mine then C.Cyan else C.NavyEdge)
		view.accent.BackgroundTransparency = if index == 1 or mine then 0 else .5
		view.rank.Text = string.format("%02d", index)
		view.rank.TextColor3 = if index == 1 then C.Amber else C.Dim
		view.name.Text = row.name .. (if mine then "  • you" else "")
		view.score.Text = tostring(row.score)
		view.score.TextColor3 = if index == 1 then C.Amber else C.Cyan
	end
	for id, view in self.rows do
		if not found[id] then
			view.frame:Destroy()
			self.rows[id] = nil
		end
	end
	-- Stage chip: the server names the stage; the copy explains what is at risk.
	local stage = state.stage or ""
	local stageCopy = {
		Collect = Copy.StageCollect, Compete = Copy.StageCompete,
		Chaos = Copy.StageChaos, Final = Copy.StageFinal,
	}
	self.stageChip.Visible = stage ~= "" and not self.short and not self.compact
	self.stageText.Text = stageCopy[stage] or string.upper(stage)
	self.stageText.TextColor3 = if stage == "Final" then C.Danger
		elseif stage == "Chaos" then C.Violet else C.Amber
	self:updateLocalValues()
	self:updateResults(state)
	self:updateBanners(state)
	self.collection:update(self.localRow)
	self:tick()
end

-- Every steal control reads the server's own cooldown / protection timestamps, so
-- the button never promises something the server would refuse.
function Hud:refreshSteal()
	local row = self.localRow
	local now = Workspace:GetServerTimeNow()
	local playing = self.state and self.state.phase == "Playing"
	local readyAt = if row then (row.stealReadyAt or 0) else 0
	local cooldown = math.max(0, readyAt - now)
	local protected = if row then math.max(0, (row.protectedUntil or 0) - now) else 0
	local carried = if row then (row.carriedValue or 0) else 0
	local carriedCount = if row then (row.carried or 0) else 0
	self.stealCooldown = cooldown

	local label, caption, color = Copy.StealReady, "8s COOLDOWN", C.White
	if not playing then
		label, caption, color = Copy.StealBar, "COLLECT PHASE", C.Muted
	elseif protected &gt; 0 then
		label, caption, color = Copy.StealProtected, string.format("%.0fs", math.ceil(protected)), C.Cyan
	elseif cooldown &gt; 0 then
		label = string.format("%.1fs", cooldown)
		caption, color = Copy.StealCooldown, C.Muted
	end
	self.steal.label.Text = label
	self.steal.label.TextColor3 = color
	self.steal.caption.Text = caption
	-- Veil drains left-to-right as the cooldown expires.
	local span = self.config and self.config.Steal and self.config.Steal.Cooldown or 8
	self.steal.veil.Size = UDim2.fromScale(math.clamp(cooldown / span, 0, 1), 1)
	self.steal.carried.Text = tostring(carried)
	self.steal.carried.TextColor3 = if carried &gt; 0 then C.Amber else C.Muted
	self.steal.banked.Text = string.format("%d IN %d CELLS", carried, carriedCount)
end

function Hud:updateLocalValues()
	local row = self.localRow
	local cells = if row then row.score else 0
	local coins = if row then row.coins else 0
	self.top.cellValue.Text = tostring(cells)
	self.top.coinValue.Text = tostring(coins)
	local collected = if row then row.collected else 0
	self.top.specimenText.Text = if self.compact
		then "SPECS  " .. collected .. "/6"
		else "SPECIMENS  " .. collected .. " / 6"
	self.top.specimenText.TextColor3 = if collected &gt;= 6 then C.Amber else C.Cyan
	if self.state then
		-- On phones the clock is narrow: the round number alone still fits.
		local round = string.format("ROUND %02d", self.state.roundId or 0)
		self.top.roundLabel.Text = if self.compact then round
			else round .. "  •  " .. (if self.state.fastMode then "QUICK TEST" else self.config.ArenaName)
	end
	if self.modal.Visible then
		self:refreshModal()
	end
end

function Hud:updateResults(state)
	local showing = state.phase == "Results" and state.results ~= nil
	if showing ~= self.results.Visible then
		self.results.Visible = showing
		if showing then
			Kit.enter(self.results, { reducedMotion = self.reducedMotion, rise = 16 })
		end
	end
	if not showing then
		return
	end
	local results = state.results
	local winners = results.winners
	if #winners == 0 then
		self.resultTitle.Text = Copy.NoScoreBanner
		self.resultName.Text = "No cells collected this time.\nThe next round is yours."
	elseif #winners == 1 then
		self.resultTitle.Text = Copy.WinBanner
		self.resultName.Text = winners[1].name .. " wins!\n" .. results.topScore .. " brain cells"
	else
		self.resultTitle.Text = Copy.TieBanner
		local names = {}
		for index, row in winners do
			if index &lt;= 3 then table.insert(names, row.name) end
		end
		self.resultName.Text = table.concat(names, ", ") .. (if #winners &gt; 3 then " + more" else "")
			.. "\nTied at " .. results.topScore .. " cells"
	end
	-- Phase 5 results now name the steal stat, because stealing is how a round is won.
	local me = self.localRow
	if me then
		self.resultCast.Text = string.format("%s  •  %d %s  •  %d %s",
			self:castLine(results.roundId), me.steals or 0, Copy.ResultsSteals, me.lost or 0, Copy.ResultsLost)
	else
		self.resultCast.Text = self:castLine(results.roundId)
	end
	local reward = results.rewards[tostring(self.userId)] or 0
	self.resultReward.Text = if reward &gt; 0 then "+" .. reward .. " COINS" else "NEXT ROUND SOON"
end

function Hud:updateBanners(state)
	self.lobby.frame.Visible = state.phase ~= "Playing"
	if self.lobby.frame.Visible then
		local remaining = math.max(0, (state.phaseEndsAt or 0) - Workspace:GetServerTimeNow())
		self.lobby.status.Text = phaseWord(state.phase, state.fastMode)
		self.lobby.status.TextColor3 = if state.phase == "Results" then C.Amber else C.Cyan
		if state.phase == "Intermission" then
			self.lobby.countdown.Text = "ARENA OPENS IN " .. timeString(remaining)
		elseif state.phase == "Results" then
			self.lobby.countdown.Text = "NEXT ROUND IN " .. timeString(remaining)
		else
			self.lobby.countdown.Text = "WAITING FOR THE FIRST PLAYER"
		end
	end
	-- Event banner: shows the incoming warning first, then the live window, both
	-- straight from the server's own schedule.
	local now = Workspace:GetServerTimeNow()
	local warning = state.eventWarning or ""
	if state.eventActive then
		self.event.frame.Visible = true
		self.event.label.Text = string.upper(eventLabel(state.eventKind))
			.. "  •  " .. Copy.EventLive .. "  " .. timeString(state.eventEndsAt - now)
		self.event.label.TextColor3 = C.Cyan
		self.event.dot.BackgroundColor3 = C.Cyan
	elseif warning ~= "" then
		self.event.frame.Visible = true
		self.event.label.Text = Copy.EventIncoming .. ": " .. string.upper(eventLabel(warning))
			.. "  •  " .. timeString((state.eventWarningEndsAt or 0) - now)
		self.event.label.TextColor3 = C.Amber
		self.event.dot.BackgroundColor3 = C.Amber
	else
		self.event.frame.Visible = false
	end
end

function Hud:tick()
	local state = self.state
	if not state then return end
	local now = Workspace:GetServerTimeNow()
	local remaining = math.max(0, (state.phaseEndsAt or 0) - now)
	self.top.time.Text = if state.phase == "Waiting" then "--:--" else timeString(remaining)
	self.top.time.TextColor3 = if state.phase == "Playing" and remaining &lt;= 15 then C.Danger else C.White
	-- While a round is live the clock's header names the STAGE, so the one number
	-- that matters most (time until the next bank) reads first. Phases keep their
	-- own words; the stage chip is the long form.
	local stageWord = self.stageText and self.stageText.Text or ""
	self.top.phase.Text = if state.phase == "Playing" and stageWord ~= ""
		then string.upper(string.match(stageWord, "^%S+") or Copy.PlayingStatus)
		else phaseWord(state.phase, state.fastMode)
	self.top.phase.TextColor3 = if state.phase == "Playing" then C.Cyan
		elseif state.phase == "Results" then C.Amber else C.Violet
	self:updateBanners(state)
	if self.lobby.frame.Visible then
		if state.phase == "Intermission" then
			self.lobby.countdown.Text = "ARENA OPENS IN " .. timeString(remaining)
		elseif state.phase == "Results" then
			self.lobby.countdown.Text = "NEXT ROUND IN " .. timeString(remaining)
		end
	end
	if state.eventActive then
		self.event.label.Text = string.upper(eventLabel(state.eventKind)) .. "  •  " .. Copy.EventLive
			.. "  " .. timeString(state.eventEndsAt - now)
	elseif (state.eventWarning or "") ~= "" then
		self.event.label.Text = Copy.EventIncoming .. ": " .. string.upper(eventLabel(state.eventWarning))
			.. "  •  " .. timeString((state.eventWarningEndsAt or 0) - now)
	end
	if self.results.Visible then
		self.resultNext.Text = "INTERMISSION IN " .. timeString(remaining)
	end
	self.collection:step(now, self.reducedMotion)
	self:refreshSteal()
	self:refreshCharacters()
end

-- --------------------------------------------------------------------------- #
-- Toast
-- --------------------------------------------------------------------------- #
function Hud:notice(message, accent)
	self.noticeToken += 1
	local token = self.noticeToken
	self.toast.label.Text = message
	self.toast.accent.BackgroundColor3 = accent or C.Cyan
	self.toast.frame.Visible = true
	Kit.enter(self.toast.frame, { reducedMotion = self.reducedMotion, rise = 10, duration = Motion.Toast })
	task.delay(Motion.Notice, function()
		if self.noticeToken == token then
			self.toast.frame.Visible = false
		end
	end)
end

function Hud:pulse()
	if self.reducedMotion then return end
	self.top.cellScale.Scale = 1.14
	TweenService:Create(self.top.cellScale, TweenInfo.new(Motion.Fast, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Scale = 1,
	}):Play()
end

-- --------------------------------------------------------------------------- #
-- Shop / inventory / settings / help
-- --------------------------------------------------------------------------- #
function Hud:showModal(kind)
	self.modalKind = kind
	self.modal.Visible = true
	self:refreshModal()
end

function Hud:closeModal()
	self.modal.Visible = false
	self.modalKind = nil
end

-- The steal request carries no target, no distance and no value: the server
-- resolves everything from its own state.
-- Server view for this player's characters. A notice from the server is shown as a toast.
function Hud:setCharacters(view)
	self.character = view
	if view.notice and view.notice ~= "" then
		self:notice(view.notice, C.Cyan)
	end
	self:refreshCharacters()
end

function Hud:refreshCharacters()
	local view = self.character
	if not view or not self.config or not self.config.Characters then return end
	local now = Workspace:GetServerTimeNow()
	local active = view.active
	local entry = self.config.Characters.Roster[active]
	local ready = (view.readyAt and view.readyAt[active]) or 0
	local remaining = math.max(0, ready - now)
	local span = entry.Cooldown

	local playing = self.state ~= nil and self.state.phase == "Playing"
	self.ability.label.Text = entry.Title
	if remaining &gt; 0 then
		self.ability.caption.Text = string.format("RECHARGING %ds", math.ceil(remaining))
		self.ability.caption.TextColor3 = C.Muted
	elseif playing then
		self.ability.caption.Text = "Q • READY"
		self.ability.caption.TextColor3 = C.Cyan
	else
		self.ability.caption.Text = "WAITING FOR PLAY"
		self.ability.caption.TextColor3 = C.Muted
	end
	self.ability.veil.Size = UDim2.fromScale(math.clamp(remaining / span, 0, 1), 1)

	local left = (view.normalLeft or 0) + (view.bonusLeft or 0)
	self.strip.readout.Text = string.format("%s • %d SWITCH%s LEFT", Species.Characters[active].Label,
		left, if left == 1 then "" else "ES")
	for slot, chip in self.strip.chips do
		local isActive = self.config.Characters.Order[slot] == active
		chip.BackgroundColor3 = if isActive then C.Cyan else C.NavyRaised
		chip.Label.TextColor3 = if isActive then C.Void else C.White
	end
end

function Hud:requestAbility()
	if self.modal.Visible or self.collection:isVisible() then return end
	local view = self.character
	if not self.state or self.state.phase ~= "Playing" then
		self:notice("ABILITIES ARE LIVE DURING PLAY", C.Muted)
		return
	end
	if view then
		local ready = (view.readyAt and view.readyAt[view.active]) or 0
		local remaining = ready - Workspace:GetServerTimeNow()
		if remaining &gt; 0 then
			self:notice(string.format("RECHARGING %ds", math.ceil(remaining)), C.Muted)
			return
		end
	end
	if self.verbs.ability then self.verbs.ability() end
end

function Hud:requestSwitch(slot)
	if self.modal.Visible or self.collection:isVisible() then return end
	if not self.state or self.state.phase ~= "Playing" then
		self:notice("CHARACTERS ARE LIVE DURING PLAY", C.Muted)
		return
	end
	if self.character and self.config.Characters.Order[slot] == self.character.active then return end
	if self.verbs.switch then self.verbs.switch(slot) end
end

function Hud:requestSteal()
	if self.modal.Visible or self.collection:isVisible() then
		return
	end
	if not self.state or self.state.phase ~= "Playing" then
		self:notice(Copy.StealBar .. " • " .. Copy.IntermissionStatus, C.Muted)
		return
	end
	if (self.stealCooldown or 0) &gt; 0 then
		return
	end
	self.request("Steal")
	-- Optimistic veil only: the visible countdown still comes from the server row.
	self.stealCooldown = self.config.Steal.Cooldown
	self.steal.label.TextColor3 = C.Muted
end

-- The server's verdict, shown as a short toast. A refusal always explains itself.
function Hud:stealResult(result, value)
	local messages = {
		ok = { "STEAL!  +" .. tostring(value), C.Success },
		empty = { Copy.StealEmpty, C.Muted },
		["out-of-range"] = { Copy.StealOutOfRange, C.Muted },
		["cooldown"] = { Copy.StealCooldown, C.Muted },
		["protected"] = { Copy.StealProtected, C.Muted },
		["immune"] = { Copy.StealImmune, C.Muted },
		["repeat"] = { Copy.StealRepeat, C.Muted },
		["self"] = { Copy.StealEmpty, C.Muted },
		["inactive-round"] = { Copy.StealBar, C.Muted },
	}
	local entry = messages[result] or { Copy.StealOutOfRange, C.Muted }
	self:notice(entry[1], entry[2])
	if result == "ok" then
		self:pulse()
	end
end

function Hud:showCollection()
	self.collection:show()
	self.collection:update(self.localRow)
end

function Hud:hideCollection()
	self.collection:hide()
end

function Hud:refreshModal()
	local kind = self.modalKind
	local row = self.localRow
	local owned = row and row.haloOwned
	local equipped = row and row.haloEquipped
	local coins = if row then row.coins else 0
	if kind == "Shop" then
		self.modalTitle.Text = Copy.ShopTitle
		self.modalTitle.TextColor3 = C.Amber
		self.modalBody.Text = Copy.ShopBody .. "\n\nPULSE HALO — " .. self.config.HaloCost .. " session coins."
			.. "\n\nBalance: " .. coins .. " coins."
			.. (if owned then "\n\nYou already own this glow for the session." else "")
		self.modalPrimary.Label.Text = if owned then (if equipped then "UNEQUIP" else "EQUIP") else "UNLOCK  •  " .. self.config.HaloCost
		self.modalPrimary.Visible = true
	elseif kind == "Inventory" then
		self.modalTitle.Text = Copy.InventoryTitle
		self.modalTitle.TextColor3 = C.Cyan
		local lines = {}
		if row then
			table.insert(lines, string.format("ROUND SCORE      %d", row.score))
			table.insert(lines, string.format("ROUNDS WON      %d", row.wins))
			table.insert(lines, string.format("CELLS CLAIMED   %d", row.pickups))
			table.insert(lines, string.format("SESSION COINS   %d", row.coins))
			table.insert(lines, "")
			if owned then
				table.insert(lines, "PULSE HALO      " .. (if equipped then "EQUIPPED" else "OWNED"))
			else
				table.insert(lines, "PULSE HALO      NOT OWNED")
			end
		else
			table.insert(lines, Copy.InventoryEmpty)
		end
		self.modalBody.Text = table.concat(lines, "\n")
		self.modalPrimary.Visible = owned
		self.modalPrimary.Label.Text = if equipped then "UNEQUIP" else "EQUIP"
	elseif kind == "Settings" then
		self.modalTitle.Text = Copy.SettingsTitle
		self.modalTitle.TextColor3 = C.Violet
		self.modalBody.Text = "Sound and music: " .. (if self.soundOn then "ON" else "OFF")
			.. "\nMotion: " .. (if self.reducedMotion then "REDUCED" else "FULL")
			.. "\n\nREDUCED MOTION turns off camera-shaking effects, halo breathing and\npanel transitions. It never changes gameplay."
		self.modalPrimary.Visible = false
	else
		self.modalTitle.Text = "HOW TO PLAY"
		self.modalTitle.TextColor3 = C.Cyan
		self.modalBody.Text = "01   COLLECT THE CAST\nBrain or frog +1  •  fish or goose +5  •  toast or sock +10"
			.. "\n\n02   BANK, THEN STEAL\nEach stage banks what you carry. Between banks, tap STEAL (or E) beside a rival to take one cell they are carrying."
			.. "\n\n03   SURVIVE THE CHAOS\nOne Chaos Event per round, 35 seconds: low gravity, bouncy jumps, slippery stone or Brain Cell Rush. Each one warns you first."
			.. "\n\n04   BE THE BIGGEST BRAIN\nMost cells after the Final Rush wins. Ties share the crown."
		self.modalPrimary.Visible = false
	end
	self.modalSound.Label.Text = if self.soundOn then "SFX ON" else "SFX OFF"
	self.modalMotion.Label.Text = if self.reducedMotion then "REDUCED MOTION: ON" else "MOTION: FULL"
end

function Hud:activateModal()
	local kind = self.modalKind
	if kind == "Shop" or kind == "Inventory" then
		-- The only cosmetic verb the server accepts. Ownership is decided server-side.
		self.request("Halo")
	end
end

function Hud:toggleSound()
	self.soundOn = not self.soundOn
	self:refreshModal()
end

function Hud:toggleMotion()
	self.reducedMotion = not self.reducedMotion
	self:refreshModal()
end

-- Deterministic flavour line, chosen from the round id only. No gameplay meaning.
function Hud:castLine(roundId)
	local round = math.max(1, math.floor(tonumber(roundId) or 1))
	local value = if round % 3 == 0 then 10 elseif round % 3 == 1 then 1 else 5
	local family = CreatureData.Family[value]
	local spec = CreatureData.Creatures[family[(round % 2) + 1]]
	return spec.Label .. "  •  " .. spec.Blurb
end

function Hud:destroy()
	for _, connection in self.connections do connection:Disconnect() end
	self.collection:destroy()
	self.screen:Destroy()
end

return Hud
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX001095">
          <Properties>
            <string name="Name">Iconography</string>
            <ProtectedString name="Source">--!nonstrict
-- Procedural recognisability layer.
--
-- Every gameplay object keeps a unique silhouette *in addition to* its colour, so
-- the redesign stays readable for colour-blind players and on washed-out phone
-- screens:
--   pink  +1  -&gt; critter only (no extra parts)
--   gold  +5  -&gt; critter plus one floating ring
--   prism +10 -&gt; critter plus two crossed arms
-- Built from part/UI primitives only; no images, decals or asset IDs.
local Iconography = {}

local KIND_ORDER = { 1, 5, 10 }        -- value -&gt; silhouette index

local KINDS = {}
for index, value in KIND_ORDER do
	KINDS[value] = index
end

-- Rarity marks sit *outside* the creature silhouette so the critter stays legible:
--   gold  +5  -&gt; one floating ring above the head (single part, Neon)
--   prism +10 -&gt; two crossed arms in front of the chest (two parts, Neon)
-- Only rarer cells pay for these parts; +1 cells cost nothing.
local MARK_LAYOUT = {
	Crown = { Size = Vector3.new(.10, .74, .74), Node = Vector3.new(0, 1.12, 0), Pitch = 0,
		Name = "MarkCrown", Shape = Enum.PartType.Cylinder },
	ArmX = { Size = Vector3.new(.12, .12, .92), Node = Vector3.new(0, -.06, .62), Pitch = math.rad(38),
		Name = "MarkArm", Shape = Enum.PartType.Block },
	ArmZ = { Size = Vector3.new(.92, .12, .12), Node = Vector3.new(0, -.06, .62), Pitch = -math.rad(38),
		Name = "MarkArm", Shape = Enum.PartType.Block },
}

-- A mark handle. No parts are created here; `apply` allocates on demand.
function Iconography.marks(model, color, kind)
	return { model = model, color = color, kind = kind or "none", parts = {} }
end

local function ensure(marks, key, color)
	local existing = marks.parts[key]
	if existing then
		existing.Color = color
		return existing
	end
	local layout = MARK_LAYOUT[key]
	local part = Instance.new("Part")
	part.Name, part.Size, part.Shape = layout.Name, layout.Size, layout.Shape
	part.Material = Enum.Material.Neon
	part.Color = color
	part.CFrame = CFrame.new(layout.Node) * CFrame.Angles(0, 0, layout.Pitch)
	if key == "Crown" then
		-- Roblox cylinders are X-axis; lay it flat so it reads as a ring.
		part.CFrame = CFrame.new(layout.Node) * CFrame.Angles(0, 0, math.pi / 2)
	end
	part.Anchored = true
	part.CanCollide, part.CanTouch, part.CanQuery, part.CastShadow = false, false, false, false
	part.Massless = true
	part.Transparency = 1
	part.Parent = marks.model
	marks.parts[key] = part
	return part
end

-- Show only the marks belonging to `value`.
function Iconography.apply(marks, value, color, visible)
	if not marks then
		return
	end
	local kind = marks.kind or "none"
	local shown = visible == true
	if kind == "crown" then
		ensure(marks, "Crown", color)
	elseif kind == "arms" then
		ensure(marks, "ArmX", color)
		ensure(marks, "ArmZ", color)
	end
	for key, part in marks.parts do
		local active = (kind == "crown" and key == "Crown")
			or (kind == "arms" and (key == "ArmX" or key == "ArmZ"))
		part.Transparency = if shown and active then 0 else 1
	end
end

-- ---------------------------------------------------------------------------
-- HUD helper: a small glyph mirroring the in-world silhouette, for the rarity key
-- and reward rows. Parent must be a Frame.
-- ---------------------------------------------------------------------------
function Iconography.glyph(parent, value, color)
	local index = KINDS[value] or 1
	local box = Instance.new("Frame")
	box.Name = "Glyph_" .. tostring(value)
	box.Size = UDim2.fromOffset(18, 18)
	box.BackgroundTransparency = 1
	box.Parent = parent

	local function square(name, size, position, hex)
		local frame = Instance.new("Frame")
		frame.Name = name
		frame.Size = UDim2.fromOffset(size, size)
		frame.Position = UDim2.fromOffset(position[1], position[2])
		frame.BackgroundColor3 = color
		frame.BorderSizePixel = 0
		frame.Parent = box
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, hex and 0 or size)
		corner.Parent = frame
		return frame
	end

	-- All three glyphs share a round base dot; the extra mark disambiguates them.
	square("Base", 8, { 5, 5 }, false)
	if index == 2 then
		square("TipTop", 5, { 6, -1 }, true)
		square("TipBottom", 5, { 6, 14 }, true)
	elseif index == 3 then
		square("ArmUp", 4, { 7, -1 }, true)
		square("ArmDown", 4, { 7, 15 }, true)
		square("ArmLeft", 4, { -1, 7 }, true)
		square("ArmRight", 4, { 15, 7 }, true)
	end
	return box
end

return Iconography
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX001096">
          <Properties>
            <string name="Name">Kit</string>
            <ProtectedString name="Source">--!nonstrict
-- UI kit: the only place that constructs HUD primitives.
--
-- Every panel in the interface comes from `Kit.panel`, `Kit.button`, `Kit.text`
-- and friends, so the design system in `Theme` (generated from tools/ui.py) is
-- actually enforced instead of being a suggestion. No images, no asset ids, no
-- uploaded fonts: corners, strokes, gradients and glyph frames only.
--
-- Everything here is presentation. It reads no gameplay state and writes none.
local TweenService = game:GetService("TweenService")
local Theme = require(script.Parent.Theme)

local Kit = {}

local C = Theme.Colors
local Alpha = Theme.Alpha
local Type = Theme.Type
local Space = Theme.Space
local Motion = Theme.Motion
local Fonts = Theme.Fonts

Kit.Colors = C
Kit.Theme = Theme

-- --------------------------------------------------------------------------- #
-- primitives
-- --------------------------------------------------------------------------- #

-- Kinds that never take input. Screenshot-only framing or decoration, so a click
-- passes through to whatever is underneath.
local PASSIVE = {
	Frame = true,
	TextLabel = true,
	ImageLabel = true,
}

function Kit.instance(className, properties, parent)
	local object = Instance.new(className)
	if PASSIVE[className] then
		object.Active = false
		object.Interactable = false
	end
	for key, value in properties do
		object[key] = value
	end
	if parent then
		object.Parent = parent
	end
	return object
end

function Kit.corner(parent, radius)
	return Kit.instance("UICorner", { CornerRadius = UDim.new(0, radius or Theme.Radius) }, parent)
end

function Kit.stroke(parent, color, transparency, thickness)
	return Kit.instance("UIStroke", {
		Color = color or C.NavyEdge,
		Thickness = thickness or 1,
		Transparency = transparency or Alpha.Hairline,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, parent)
end

function Kit.padding(parent, left, top, right, bottom)
	return Kit.instance("UIPadding", {
		PaddingLeft = UDim.new(0, left or Space.md),
		PaddingTop = UDim.new(0, top or Space.md),
		PaddingRight = UDim.new(0, right or left or Space.md),
		PaddingBottom = UDim.new(0, bottom or top or Space.md),
	}, parent)
end

-- Vertical gradient. Degrades to a flat fill if the client cannot build one.
function Kit.gradient(parent, top, bottom, rotation)
	if type(ColorSequence) ~= "table" or not ColorSequence.new then
		return nil
	end
	return Kit.instance("UIGradient", {
		Color = ColorSequence.new(top, bottom),
		Rotation = rotation or 90,
	}, parent)
end

-- A panel: navy, translucent, rounded, hairline edge, gentle top-light gradient.
function Kit.panel(parent, name, size, position, options)
	local o = options or {}
	local frame = Kit.instance("Frame", {
		Name = name,
		Size = size,
		Position = position,
		AnchorPoint = o.anchor or Vector2.zero,
		BackgroundColor3 = o.color or C.Navy,
		BackgroundTransparency = o.transparency or Alpha.Panel,
		BorderSizePixel = 0,
		ClipsDescendants = o.clip == true,
		Visible = if o.visible == nil then true else o.visible,
		ZIndex = o.zIndex or 1,
	}, parent)
	Kit.corner(frame, o.radius or Theme.Radius)
	Kit.stroke(frame, o.edge or C.NavyEdge, o.edgeTransparency or Alpha.Hairline)
	Kit.gradient(frame, (o.color or C.NavyRaised), (o.color or C.Navy))
	if o.padding then
		Kit.padding(frame, o.padding, o.padding, o.padding, o.padding)
	end
	return frame
end

-- A legibility scrim: a soft navy gradient that darkens the edge of the screen so
-- translucent panels always sit on a controlled background, even against a bright
-- sky. Degrades to nothing if NumberSequence is unavailable.
function Kit.scrim(parent, height, fromTop, options)
	local o = options or {}
	local frame = Kit.instance("Frame", {
		Name = o.name or (if fromTop then "ScrimTop" else "ScrimBottom"),
		Size = UDim2.new(1, 0, 0, height),
		Position = if fromTop then UDim2.fromOffset(0, 0) else UDim2.new(0, 0, 1, -height),
		BackgroundColor3 = o.color or C.Void,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = o.zIndex or 0,
	}, parent)
	if type(NumberSequence) ~= "table" or not NumberSequence.new then
		frame.BackgroundTransparency = o.fallback or .55
		return frame
	end
	-- Near the edge the wash is strong enough that `Muted` body text clears 4.5:1
	-- against it; it fades out before it reaches the play space.
	local strength = o.strength or .8
	local stops = if fromTop
		then { NumberSequenceKeypoint.new(0, 1 - strength), NumberSequenceKeypoint.new(.5, 1 - strength * .45), NumberSequenceKeypoint.new(1, 1) }
		else { NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(.5, 1 - strength * .45), NumberSequenceKeypoint.new(1, 1 - strength) }
	Kit.instance("UIGradient", {
		Color = ColorSequence.new(C.Void, C.Void),
		Transparency = NumberSequence.new(stops),
		Rotation = 90,
	}, frame)
	return frame
end

-- Text. `variant` picks the type scale + font pairing; never inline ad-hoc sizes.
function Kit.text(parent, name, content, variant, options)
	local o = options or {}
	local size = o.size or UDim2.new(1, 0, 0, Type[variant or "Body"] + 4)
	local label = Kit.instance("TextLabel", {
		Name = name,
		Text = content,
		Size = size,
		Position = o.position or UDim2.fromOffset(0, 0),
		AnchorPoint = o.anchor or Vector2.zero,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		TextColor3 = o.color or C.White,
		TextSize = Type[variant or "Body"],
		Font = o.font or Fonts[variant or "Body"],
		TextXAlignment = o.xAlign or Enum.TextXAlignment.Left,
		TextYAlignment = o.yAlign or Enum.TextYAlignment.Center,
		TextWrapped = o.wrapped == true,
		RichText = false,
		TextTransparency = o.transparency or 0,
		TextStrokeTransparency = if o.stroke then 0.55 else 1,
		LayoutOrder = o.order or 0,
		ZIndex = o.zIndex or 2,
	}, parent)
	if o.truncate then
		label.TextTruncate = Enum.TextTruncate.AtEnd
	end
	return label
end

function Kit.divider(parent, y, inset)
	return Kit.instance("Frame", {
		Name = "Divider",
		Size = UDim2.new(1, -(inset or Space.lg) * 2, 0, 1),
		Position = UDim2.new(0, inset or Space.lg, 0, y),
		BackgroundColor3 = C.NavyEdge,
		BackgroundTransparency = Alpha.Hairline,
		BorderSizePixel = 0,
		ZIndex = 2,
	}, parent)
end

-- A button that always does something: the caller must pass a handler, and the
-- handler is wired here. There is no such thing as a decorative button in this UI.
function Kit.button(parent, name, label, size, position, onClick, options)
	local o = options or {}
	local button = Kit.instance("TextButton", {
		Name = name,
		Text = "",
		Size = size,
		Position = position,
		AnchorPoint = o.anchor or Vector2.zero,
		BackgroundColor3 = o.color or C.NavyRaised,
		BackgroundTransparency = o.transparency or Alpha.PanelRaised,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		TextColor3 = C.White,
		ZIndex = o.zIndex or 3,
	}, parent)
	assert(type(onClick) == "function", "every button must be wired to a handler: " .. name)
	Kit.corner(button, o.radius or 12)
	Kit.stroke(button, o.edge or C.NavyEdge, Alpha.Hairline)
	Kit.gradient(button, (o.color or C.NavyRaised), C.Navy)
	local text = Kit.text(button, "Label", label, o.variant or "Label", {
		size = UDim2.fromScale(1, 1),
		color = o.textColor or C.White,
		xAlign = Enum.TextXAlignment.Center,
		zIndex = (o.zIndex or 3) + 1,
	})
	local accent = Kit.instance("Frame", {
		Name = "Accent",
		Size = UDim2.new(0, o.accentWidth or 3, 1, -10),
		Position = UDim2.new(0, 0, 0, 5),
		BackgroundColor3 = o.accent or C.Cyan,
		BorderSizePixel = 0,
		ZIndex = (o.zIndex or 3) + 1,
	}, button)
	Kit.corner(accent, 2)

	local scale = Kit.instance("UIScale", { Scale = 1 }, button)
	local hovered = false
	local function tween(property, value, duration)
		if o.reducedMotion and o.reducedMotion() then
			scale.Scale = value
			return
		end
		TweenService:Create(scale, TweenInfo.new(duration or Motion.Fast), { Scale = value }):Play()
	end
	button.MouseEnter:Connect(function()
		hovered = true
		tween("Scale", 1.03, Motion.Fast)
		text.TextColor3 = o.textColor or C.White
		accent.BackgroundColor3 = o.accent or C.Cyan
		button.BackgroundColor3 = o.hoverColor or C.NavyRaised
	end)
	button.MouseLeave:Connect(function()
		hovered = false
		tween("Scale", 1, Motion.Fast)
		button.BackgroundColor3 = o.color or C.NavyRaised
	end)
	button.Activated:Connect(function()
		if o.reducedMotion and o.reducedMotion() then
			onClick()
			return
		end
		tween("Scale", .96, Motion.Snap)
		task.delay(Motion.Snap, function()
			tween("Scale", 1, Motion.Fast)
		end)
		onClick()
	end)
	button.__hovered = function()
		return hovered
	end
	return button, text
end

-- Tween that respects reduced motion by snapping.
function Kit.animate(instance, properties, duration, style, reducedMotion)
	if reducedMotion then
		for key, value in properties do
			instance[key] = value
		end
		return nil
	end
	local tween = TweenService:Create(instance, TweenInfo.new(
		duration or Motion.Base,
		style or Enum.EasingStyle.Quad,
		Enum.EasingDirection.Out
	), properties)
	tween:Play()
	return tween
end

-- Fade + rise a panel in. Used for toasts, cards and the lobby banner.
function Kit.enter(frame, options)
	local o = options or {}
	local target = frame.Position
	frame.Position = UDim2.new(
		target.X.Scale,
		target.X.Offset,
		target.Y.Scale,
		target.Y.Offset + (o.rise or 12)
	)
	frame.Visible = true
	if o.reducedMotion then
		frame.Position = target
		return
	end
	local info = TweenInfo.new(o.duration or Motion.Base, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(frame, info, { Position = target }):Play()
end

return Kit
</ProtectedString>
