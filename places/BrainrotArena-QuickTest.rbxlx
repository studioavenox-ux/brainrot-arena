		{Part = "RewardsBoard", Face = "Front", Lines = {{Text = "PLAY FOR YOUR GLOW", Color = {255, 206, 120}, Weight = 1.0, Fraction = 1.15, Font = "GothamBold"}, {Text = "EARN COINS EVERY ROUND", Color = {247, 240, 226}, Weight = 0.95, Fraction = 1.05, Font = "GothamBold"}, {Text = "PULSE HALO • 100 COINS", Color = {150, 226, 245}, Weight = 0.95, Fraction = 1.0, Font = "GothamBold"}, {Text = "OPEN REWARDS IN YOUR HUD", Color = {247, 240, 226}, Weight = 0.95, Fraction = 1.0, Font = "GothamBold"}, {Text = "COINS LAST THIS SESSION", Color = {247, 240, 226}, Weight = 0.95, Fraction = 1.0, Font = "GothamBold"}}},
