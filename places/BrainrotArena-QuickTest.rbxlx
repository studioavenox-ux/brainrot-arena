				{ Name = "Brow", Kind = "box", Size = {0.3, 0.06, 0.09}, At = {0.28, 0.44, 0.41}, Rot = {0, 0, 16}, Role = "ink", Material = "SmoothPlastic" },
				{ Name = "Mouth", Kind = "box", Size = {0.36, 0.08, 0.1}, At = {-0.08, 0.04, 0.42}, Rot = {0, 0, -9}, Role = "ink", Material = "SmoothPlastic" },
