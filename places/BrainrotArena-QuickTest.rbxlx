				{ Name = "Jaw", Kind = "ball", Size = {0.98, 0.42, 0.78}, At = {0, -0.28, 0.24}, Rot = {0, 0, 0}, Role = "body_light", Material = "SmoothPlastic", Join = "jaw" },
				{ Name = "Belly", Kind = "ball", Size = {0.78, 0.52, 0.58}, At = {0, -0.34, 0.3}, Rot = {0, 0, 0}, Role = "body_dark", Material = "SmoothPlastic" },
