		},
		fish = {
			Name = "Glorp",
			Label = "GLORP",
			Title = "The Legally A Fish",
			Rarity = "Rare",
			Value = 5,
			Blurb = "Cannot swim. Will not discuss it.",
			Lore = "Holds its breath on land out of politeness.",
			LabelHeight = 1.29,
			Height = 1.23,
			Idle = { Bob = 0.2, Sway = 0.12, Rate = 1.5, Spin = 0.4 },
			Collect = { Spin = 2.8, Pop = 1.3 },
			Parts = {
				{ Name = "Body", Kind = "ball", Size = {1.46, 0.96, 0.92}, At = {0, 0, 0}, Rot = {0, 0, 0}, Role = "body", Material = "SmoothPlastic" },
				{ Name = "Belly", Kind = "ball", Size = {1.0, 0.52, 0.8}, At = {0, -0.3, 0}, Rot = {0, 0, 0}, Role = "body_light", Material = "SmoothPlastic" },
				{ Name = "LipTop", Kind = "ball", Size = {0.56, 0.17, 0.22}, At = {0, 0.02, 0.46}, Rot = {0, 0, 0}, Role = "body_dark", Material = "SmoothPlastic", Join = "jaw" },
				{ Name = "LipBottom", Kind = "ball", Size = {0.52, 0.16, 0.2}, At = {0, -0.16, 0.44}, Rot = {0, 0, 0}, Role = "body_light", Material = "SmoothPlastic", Join = "jaw" },
				{ Name = "EyeL", Kind = "ball", Size = {0.28, 0.28, 0.22}, At = {-0.3, 0.28, 0.3}, Rot = {0, 0, 0}, Role = "ink", Material = "SmoothPlastic", Join = "head" },
				{ Name = "EyeR", Kind = "ball", Size = {0.28, 0.28, 0.22}, At = {0.3, 0.28, 0.3}, Rot = {0, 0, 0}, Role = "ink", Material = "SmoothPlastic", Join = "head" },
				{ Name = "GlintL", Kind = "ball", Size = {0.1, 0.1, 0.08}, At = {-0.32, 0.34, 0.42}, Rot = {0, 0, 0}, Role = "glint", Material = "SmoothPlastic", Join = "head" },
				{ Name = "GlintR", Kind = "ball", Size = {0.1, 0.1, 0.08}, At = {0.28, 0.34, 0.42}, Rot = {0, 0, 0}, Role = "glint", Material = "SmoothPlastic", Join = "head" },
