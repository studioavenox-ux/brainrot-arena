      <Item class="ModuleScript" referent="RBX001077">
        <Properties>
          <string name="Name">WorldService</string>
          <ProtectedString name="Source">--!strict
-- The downloadable place already contains the map. Rojo users get this exact map at runtime.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Data = require(script.Parent.WorldData)
local ArtDirection = require(ReplicatedStorage:WaitForChild("BrainrotShared"):WaitForChild("ArtDirection"))
local WorldService = {}
WorldService.__index = WorldService

local function rgb(values: { number }): Color3
	return Color3.fromRGB(values[1], values[2], values[3])
end
local function vector(values: { number }): Vector3
	return Vector3.new(values[1], values[2], values[3])
end

local function makeSign(parent: BasePart, lines)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Sign"
	gui.Face = Enum.NormalId.Front
	gui.CanvasSize = Vector2.new(1200, math.max(100, math.floor(1200 * parent.Size.Y / parent.Size.X)))
	gui.LightInfluence = 0
	gui.Parent = parent
	local total = 0
	for _, line in lines do
		total += line.Fraction
	end
	local y = 0.04
	for index, line in lines do
		local label = Instance.new("TextLabel")
		label.Name = "Line" .. index
		local height = 0.92 * line.Fraction / total
		label.Position = UDim2.fromScale(0.04, y)
		label.Size = UDim2.fromScale(0.92, height)
		label.BackgroundTransparency = 1
		label.Text = line.Text
		label.TextColor3 = rgb(line.Color)
		label.TextScaled = true
		label.TextWrapped = true
		label.Font = Enum.Font[line.Font or "GothamBold"]
		-- A warm, low-contrast stroke keeps signage legible against bright sand.
		label.TextStrokeColor3 = Color3.fromRGB(28, 34, 40)
		label.TextStrokeTransparency = 0.55
		label.Parent = gui
		y += height
	end
end

function WorldService.new()
	local root = Workspace:FindFirstChild("BrainrotWorld")
	if not root then
		local model = Instance.new("Model")
		model.Name = "BrainrotWorld"
		local lookup: { [string]: BasePart } = {}
		for _, spec in Data.Parts do
			local part = Instance.new(spec.Class) :: BasePart
			part.Name = spec.Name
			part.Size = vector(spec.Size)
			part.CFrame = CFrame.new(vector(spec.Position)) * CFrame.Angles(
				math.rad(spec.Rotation[1]), math.rad(spec.Rotation[2]), math.rad(spec.Rotation[3])
			)
			part.Color = rgb(spec.Color)
			part.Material = Enum.Material[spec.Material]
			part.Anchored = true
			part.CanCollide = spec.Collide
			part.CanTouch = spec.Class == "SpawnLocation"
			part.CanQuery = spec.Collide
			-- Neon never casts shadows; the exporter marks every other surface.
			part.CastShadow = spec.CastShadow == true and spec.Material ~= "Neon"
			part.Transparency = spec.Transparency
			part.TopSurface = Enum.SurfaceType.Smooth
			part.BottomSurface = Enum.SurfaceType.Smooth
			if part:IsA("Part") then
				part.Shape = Enum.PartType[spec.Shape]
			end
			if part:IsA("SpawnLocation") then
				part.Neutral = true
				part.Duration = 0
				part.AllowTeamChangeOnTouch = false
			end
			local lightSpec = ArtDirection.Lights[spec.Name]
			if lightSpec then
				local light = Instance.new("PointLight")
				light.Name = lightSpec.Name
				light.Color = rgb(lightSpec.Color)
				light.Brightness = lightSpec.Brightness
				light.Range = lightSpec.Range
				light.Shadows = lightSpec.Shadows
				light.Parent = part
			end
			part.Parent = model
			lookup[spec.Name] = part
		end
		for _, sign in Data.Signs do
			makeSign(lookup[sign.Part], sign.Lines)
		end
		model.Parent = Workspace
		root = model
	end
	local spawn = root:FindFirstChild("LobbySpawn")
	assert(spawn and spawn:IsA("SpawnLocation"), "BrainrotWorld is missing LobbySpawn")
	local queueBoard = root:FindFirstChild("QueueStatusBoard")
	assert(queueBoard, "Missing queue board")
	local status = queueBoard:FindFirstChild("Line1", true) :: TextLabel?
	local accents: { BasePart } = {}
	for _, child in root:GetChildren() do
		if child:IsA("BasePart") and string.sub(child.Name, 1, 12) == "ChaosAccent_" then
			table.insert(accents, child)
			child:SetAttribute("RestColor", child.Color)
		end
	end
	return setmetatable({ root = root, lobbySpawn = spawn, status = status, accents = accents }, WorldService)
end

function WorldService.spawnCFrame(_self, arena: boolean, index: number): CFrame
	local positions = if arena then Data.ArenaSpawns else Data.LobbySpawns
	local position = vector(positions[(index - 1) % #positions + 1])
	local target = if arena then Vector3.new(0, position.Y, 0) else Vector3.new(0, position.Y, 155)
	return CFrame.lookAt(position, target)
end

-- Low-gravity feedback: the beacon ring and gate rails pulse prismatic. Only the
-- reserved gameplay accents change, so the natural environment stays stable.
function WorldService.setLowGravity(self, active: boolean)
	for _, part in self.accents do
		part.Color = if active then rgb(ArtDirection.EventAccent) else part:GetAttribute("RestColor")
	end
end

function WorldService.setStatus(self, phase: string, remaining: number)
	if not self.status then
		return
	end
	if phase == "Playing" then
		self.status.Text = "ROUND LIVE • AUTO JOIN"
	elseif phase == "Intermission" then
		self.status.Text = string.format("AUTO JOIN IN %02d:%02d", math.floor(remaining / 60), remaining % 60)
	elseif phase == "Results" then
		self.status.Text = "NICE BRAIN. NEXT ROUND SOON."
	else
		self.status.Text = "AUTO JOIN • EVERY ROUND"
	end
end

return WorldService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="Folder" referent="RBX001078">
        <Properties>
          <string name="Name">core</string>
        </Properties>
        <Item class="ModuleScript" referent="RBX001079">
          <Properties>
            <string name="Name">AbilityRules</string>
            <ProtectedString name="Source">--!strict
-- Pure ability geometry and status bookkeeping. No Roblox services, no cells, no score.
-- Positions are plain {x, y, z} tables, the same convention as ArenaRoute and MovementGuard.
local AbilityRules = {}

export type Vec = { x: number, y: number, z: number }
export type Candidate = { userId: number, position: Vec }
export type Hit = { userId: number, distance: number }
export type Statuses = { [number]: { factor: number, untilAt: number } }

local function distance(a: Vec, b: Vec): number
	local dx, dy, dz = b.x - a.x, b.y - a.y, b.z - a.z
	return math.sqrt(dx * dx + dy * dy + dz * dz)
end

-- Every eligible opponent inside `radius` of the caster, nearest first. The caster is
-- always excluded, so an ability can never hit its own user.
function AbilityRules.targetsIn(origin: Vec, candidates: { Candidate }, radius: number, casterId: number): { Hit }
	assert(radius &gt; 0, "radius must be positive")
	local hits: { Hit } = {}
	for _, candidate in candidates do
		if candidate.userId ~= casterId then
			local d = distance(origin, candidate.position)
			if d &lt;= radius then
				table.insert(hits, { userId = candidate.userId, distance = d })
			end
		end
	end
	table.sort(hits, function(a: Hit, b: Hit): boolean
		if a.distance == b.distance then
			return a.userId &lt; b.userId
		end
		return a.distance &lt; b.distance
	end)
	return hits
end

-- Unit horizontal direction from `from` to `to`. Falls back to `fallback` when the two
-- points coincide, so a launch always has a defined direction.
function AbilityRules.horizontalDirection(from: Vec, to: Vec, fallback: Vec): Vec
	local dx, dz = to.x - from.x, to.z - from.z
	local length = math.sqrt(dx * dx + dz * dz)
	if length &lt; 1e-6 then
		dx, dz = fallback.x, fallback.z
		length = math.sqrt(dx * dx + dz * dz)
		if length &lt; 1e-6 then
			return { x = 0, y = 0, z = 1 }
		end
	end
	return { x = dx / length, y = 0, z = dz / length }
end

-- Knockback: a horizontal push away from the caster plus a small lift.
function AbilityRules.knockbackVelocity(direction: Vec, push: number, lift: number): Vec
	return { x = direction.x * push, y = lift, z = direction.z * push }
end

-- Upward launch with no horizontal component.
function AbilityRules.launchVelocity(lift: number): Vec
	return { x = 0, y = lift, z = 0 }
end

-- Bubble Dash: horizontal only, along the caster's facing, so it cannot be used to fly.
function AbilityRules.dashVelocity(look: Vec, speed: number): Vec
	local dx, dz = look.x, look.z
	local length = math.sqrt(dx * dx + dz * dz)
	if length &lt; 1e-6 then
		return { x = 0, y = 0, z = 0 }
	end
	return { x = dx / length * speed, y = 0, z = dz / length * speed }
end

-- Keeps the strongest slow on a player: the lowest factor wins, and the longest expiry wins.
-- Re-applying an ability never weakens a slow that is already stronger.
function AbilityRules.applySlow(statuses: Statuses, userId: number, factor: number, untilAt: number)
	assert(factor &gt; 0 and factor &lt;= 1, "slow factor must be in (0, 1]")
	local current = statuses[userId]
	if current == nil then
		statuses[userId] = { factor = factor, untilAt = untilAt }
		return
	end
	current.factor = math.min(current.factor, factor)
	current.untilAt = math.max(current.untilAt, untilAt)
end

-- The speed multiplier in force right now. 1 means no effect.
function AbilityRules.speedFactor(statuses: Statuses, userId: number, now: number): number
	local current = statuses[userId]
	if current == nil or now &gt;= current.untilAt then
		return 1
	end
	return current.factor
end

-- Drops every slow that has expired.
function AbilityRules.prune(statuses: Statuses, now: number)
	for userId, current in statuses do
		if now &gt;= current.untilAt then
			statuses[userId] = nil
		end
	end
end

return AbilityRules
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX001080">
          <Properties>
            <string name="Name">ArenaRoute</string>
            <ProtectedString name="Source">--!strict
-- Arena routing: where a player belongs, and whether they are actually there.
--
-- Pure logic, no Roblox objects, no remotes, no yielding. The Roblox adapter
-- (Main.server) owns the teleport call; this module owns *deciding* it is needed.
--
-- Why this exists
-- ---------------
-- Phase 1/2 shipped a single fire-and-forget `character:PivotTo(target)` on the
-- phase change. That is not a reliable transition:
--   * PivotTo can return while the humanoid is still unseated, and the engine's
--     own state machine (PlatformStand, Seats, terrain) can own the root for a
--     moment and drop the character back where it was;
--   * a character that spawns during the same frame the phase flips is skipped,
--     and nothing ever retries;
--   * a player killed/respawned mid-round is only rescued by the void check;
--   * nothing verifies the character ended up in the arena at all.
--
-- So the route is a small state machine: the server *asserts* a destination and
-- keeps asserting it (with backoff) until the character is measurably there, then
-- goes quiet. Every decision below is a pure function so it can be tested without
-- an engine.
local ArenaRoute = {}
ArenaRoute.__index = ArenaRoute

export type Position = { x: number, y: number, z: number }

-- Tuning. Exported so the adapter and the tests can reason about the same numbers.
--
-- The archipelago runs along +Z: the arena disc and its four satellites occupy
-- z &lt;= ~90, the garden lobby sits around z = 180, and a north causeway links them.
-- Deciding "which half is this player in" is therefore a plane test, not a radius:
-- a radius test was wrong in both directions (arena pads sit 36 studs out, while
-- the west dock reaches x = 94).
ArenaRoute.ARENA_MAX_Z = 92      -- south of this is arena, north is lobby
ArenaRoute.LOBBY_MIN_Z = 140     -- the lobby island's southern shore
ArenaRoute.ARENA_CENTRE = { x = 0, y = 21, z = 0 }
ArenaRoute.LOBBY_CENTRE = { x = 0, y = 21, z = 180 }
ArenaRoute.LOBBY_RADIUS = 46     -- spawn spacing / reporting only
ArenaRoute.RETRY_DELAY = 0.45    -- seconds between re-assertions
ArenaRoute.MAX_ATTEMPTS = 4      -- per destination (≈1.8 s), then escalate to the fallback
ArenaRoute.GRACE = 0.6           -- let the engine seat the character before judging
ArenaRoute.CELL_SIZE = 8         -- sweep cadence: one eighth of the roster per step

export type Verdict = "arrived" | "pending" | "retry" | "give-up" | "idle"
export type Zone = "arena" | "transit" | "lobby"

type Track = {
	target: string?,      -- "arena" | "lobby" | nil (open union: nil is valid)
	attempts: number,
	lastAttempt: number,
	firstAttempt: number,
	cooldownUntil: number,
}

type Fields = {
	tracks: { [number]: Track },
	corrections: number,
	fallbacks: number,
	arrivals: number,
}

export type Router = typeof(setmetatable({} :: Fields, ArenaRoute))

local function distance(a: Position, b: Position): number
	local dx, dz = a.x - b.x, a.z - b.z
	return math.sqrt(dx * dx + dz * dz)
end

ArenaRoute.distance = distance

-- The causeway is neutral ground: walking it must never start a teleport/return
-- loop in either direction, so "in transit" counts as arrived for both targets.
function ArenaRoute.zone(position: Position): Zone
	if position.z &gt;= ArenaRoute.LOBBY_MIN_Z then
		return "lobby"
	elseif position.z &lt;= ArenaRoute.ARENA_MAX_Z then
		return "arena"
	end
	return "transit"
end

function ArenaRoute.new(): Router
	return setmetatable({ tracks = {}, corrections = 0, fallbacks = 0, arrivals = 0 }, ArenaRoute)
end

function ArenaRoute.track(self: Router, id: number): Track
	local existing = self.tracks[id]
	if existing then
		return existing
	end
	local fresh: Track = { attempts = 0, lastAttempt = -math.huge, firstAttempt = 0, cooldownUntil = 0 }
	self.tracks[id] = fresh
	return fresh
end

function ArenaRoute.remove(self: Router, id: number)
	self.tracks[id] = nil
end

-- Which destination a player should be standing in, by phase and eligibility.
-- Idle players (spectating between rounds) are never moved.
function ArenaRoute.desired(phase: string, participating: boolean): string?
	if phase == "Playing" and participating then
		return "arena"
	end
	if phase == "Intermission" or phase == "Results" or phase == "Waiting" then
		return "lobby"
	end
	return nil
end

-- Is a position inside its destination? Generous on purpose: this asks "did the
-- character leave the other half of the map?", not "is it on a spawn pad?".
function ArenaRoute.atDestination(destination: string, position: Position): boolean
	local side = ArenaRoute.zone(position)
	if destination == "arena" then
		return side ~= "lobby"
	elseif destination == "lobby" then
		return side ~= "arena"
	end
	return false
end

-- Record that the adapter teleported this player now.
function ArenaRoute.attempt(self: Router, id: number, destination: string, now: number)
	local track = self:track(id)
	if track.target ~= destination then
		track.target = destination
		track.attempts = 0
		track.firstAttempt = now
	end
	track.attempts += 1
	track.lastAttempt = now
	track.cooldownUntil = now + ArenaRoute.RETRY_DELAY
end

-- The decision. `ready` means the adapter is willing to move the character at all
-- (character exists, humanoid alive, root present) — the caller must not teleport
-- when this is false.
--
--   arrived  -&gt; the character is measurably at the destination; stop asserting
--   pending  -&gt; moved recently, or the engine is still seating it; do nothing yet
--   retry    -&gt; assert the destination again (the adapter teleports)
--   give-up  -&gt; attempts exhausted; the adapter should escalate (fallback path)
--   idle     -&gt; the player belongs nowhere this phase
function ArenaRoute.evaluate(
	self: Router,
	id: number,
	phase: string,
	participating: boolean,
	position: Position?,
	ready: boolean,
	now: number
): (Verdict, string?)
	local destination = ArenaRoute.desired(phase, participating)
	local track = self:track(id)
	if not destination then
		track.target = nil
		track.attempts = 0
		return "idle", nil
	end
	if not ready or not position then
		-- Character is dead, loading or unseated. Not a failure: wait for it. A
		-- respawn fires CharacterAdded, which resets this track.
		return "pending", destination
	end
	if ArenaRoute.atDestination(destination, position) then
		if track.target ~= nil and track.target ~= destination then
			-- Travelling the other way: the position still reads as the old
			-- destination for a frame. Fall through to a fresh attempt.
			track.attempts = 0
		else
			if track.target ~= destination then
				self.arrivals += 1
			end
			track.target = destination
			track.attempts = 0
			return "arrived", destination
		end
	end
	-- Wrong place. Fresh intent (phase flip or first sight of this player)?
	if track.target ~= destination then
		if track.cooldownUntil &gt; now then
			return "pending", destination
		end
		return "retry", destination
	end
	-- Already asserting this destination.
	if now - track.lastAttempt &lt; ArenaRoute.RETRY_DELAY then
		return "pending", destination
	end
	if track.attempts &lt; ArenaRoute.MAX_ATTEMPTS then
		return "retry", destination
	end
	-- The normal path has failed repeatedly. The adapter escalates: it re-seats the
	-- character (reparent, humanoid state reset, teleport again) and this counter
	-- is what proves in the log that a fallback actually ran.
	track.attempts = 0
	track.firstAttempt = now
	self.fallbacks += 1
	self.corrections += 1
	return "give-up", destination
end

-- Cheap round-robin sweep so a full server does not re-evaluate 12 characters on
-- every heartbeat. Returns the slice of ids to examine this step.
function ArenaRoute.slice(ids: { number }, step: number): { number }
	local out: { number } = {}
	local size = math.max(1, ArenaRoute.CELL_SIZE)
	local cells = math.ceil(#ids / size)
	if cells &lt;= 1 then
		for _, id in ids do
			table.insert(out, id)
		end
		return out
	end
	local cell = step % cells
	for index, id in ids do
		if (index - 1) // size == cell then
			table.insert(out, id)
		end
	end
	return out
end

function ArenaRoute.stats(self: Router)
	return {
		arrivals = self.arrivals,
		fallbacks = self.fallbacks,
		corrections = self.corrections,
		tracked = (function()
			local count = 0
			for _ in self.tracks do
				count += 1
			end
			return count
		end)(),
	}
end

return ArenaRoute
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX001081">
          <Properties>
            <string name="Name">ChaosRules</string>
            <ProtectedString name="Source">--!strict
-- Pure, engine-independent rules for the Chaos Event. Given the live kind (or ""),
-- returns the complete set of modifiers the server should apply right now.
--
-- Every value is read from Config.Chaos or Config; nothing is duplicated here.
-- The server reconciles to `modifiers(machine.eventKind)` on every step, so the
-- neutral set is always what remains after an event ends. Cleanup therefore does
-- not depend on remembering to undo one specific effect.
local ChaosRules = {}

export type Modifiers = {
	Kind: string,
	Gravity: number,       -- Workspace.Gravity
	Friction: number?,     -- nil = surfaces keep their own physical properties
	JumpScale: number,     -- multiplier on Config.JumpPower
	RareScale: number,     -- weight multiplier for Rare and Prismatic cells
	Respawn: number?,      -- nil = normal respawn rules apply
}

export type Config = {
	NormalGravity: number,
	SlipperyFriction: number,
	RushRespawn: number,
	Chaos: {
		Kinds: { string },
		LowGravity: number,
		BouncyJumpScale: number,
		RushRarityScale: number,
	},
}

local function neutral(config: Config): Modifiers
	return {
		Kind = "",
		Gravity = config.NormalGravity,
		Friction = nil,
		JumpScale = 1,
		RareScale = 1,
		Respawn = nil,
	}
end

-- The set of kinds the server may draw from. Used by the round machine's validation.
function ChaosRules.isKnown(kind: string): boolean
	return kind == "LowGravity" or kind == "BouncyWorld" or kind == "SlipperyChaos" or kind == "BrainCellRush"
end

function ChaosRules.modifiers(kind: string, config: Config): Modifiers
	local result = neutral(config)
	if kind == "" then
		return result
	end
	result.Kind = kind
	if kind == "LowGravity" then
		result.Gravity = config.Chaos.LowGravity
	elseif kind == "BouncyWorld" then
		result.JumpScale = config.Chaos.BouncyJumpScale
	elseif kind == "SlipperyChaos" then
		result.Friction = config.SlipperyFriction
	elseif kind == "BrainCellRush" then
		result.RareScale = config.Chaos.RushRarityScale
		result.Respawn = config.RushRespawn
	else
		error("Unknown Chaos Event kind: " .. tostring(kind), 2)
	end
	return result
end

ChaosRules.neutral = neutral

return table.freeze(ChaosRules)
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX001082">
          <Properties>
            <string name="Name">CharacterRules</string>
            <ProtectedString name="Source">--!strict
-- Pure character state: which character each player holds, how many switches they
-- have left, and when each character's ability is ready again. No Roblox services.
--
-- Rules:
--   * One active character at a time. Everyone starts a round on Order[1].
--   * Normal switches: Config.Characters.SwitchesNormal per round, any time in Playing.
--   * Bonus switch: Config.Characters.SwitchesBonus per round, only while the Chaos Event
--     is active. Four switches at most in total.
--   * Cooldowns are stored per player AND per character. A switch never resets or
--     copies a cooldown, so switching away and back cannot clear one.
--   * beginRound() clears every cooldown and every switch quota.
local CharacterRules = {}
CharacterRules.__index = CharacterRules

export type Options = {
	phase: string,
	participating: boolean,
	chaos: boolean?,
}

export type Player = {
	active: string,
	normalLeft: number,
	bonusLeft: number,
	readyAt: { [string]: number },
}

export type Rules = typeof(setmetatable({} :: {
	order: { string },
	roster: { [string]: { Ability: string, Cooldown: number } },
	normalMax: number,
	bonusMax: number,
	players: { [number]: Player },
}, CharacterRules))

function CharacterRules.new(characters: any): Rules
	assert(typeof(characters) == "table", "characters config required")
	assert(#characters.Order == 6, "exactly six characters are required")
	local seen: { [string]: boolean } = {}
	for _, key in characters.Order do
		assert(characters.Roster[key] ~= nil, "missing roster entry: " .. key)
		assert(not seen[key], "duplicate character: " .. key)
		seen[key] = true
		assert(characters.Roster[key].Cooldown &gt; 0, "cooldown must be positive: " .. key)
	end
	assert(characters.SwitchesNormal &gt;= 0 and characters.SwitchesBonus &gt;= 0, "switch quotas cannot be negative")
	return setmetatable({
		order = characters.Order,
		roster = characters.Roster,
		normalMax = characters.SwitchesNormal,
		bonusMax = characters.SwitchesBonus,
		players = {},
	}, CharacterRules) :: any
end

local function freshPlayer(self: Rules): Player
	return { active = self.order[1], normalLeft = self.normalMax, bonusLeft = self.bonusMax, readyAt = {} }
end

-- Starts a new round for these players. Every cooldown and quota is reset here, and
-- nowhere else, so "cooldowns reset at the next round" has exactly one implementation.
function CharacterRules.beginRound(self: Rules, userIds: { number })
	self.players = {}
	for _, userId in userIds do
		self.players[userId] = freshPlayer(self)
	end
end

-- A player who joins mid-round gets a full quota and fresh cooldowns.
function CharacterRules.ensure(self: Rules, userId: number): Player
	local player = self.players[userId]
	if player == nil then
		player = freshPlayer(self)
		self.players[userId] = player
	end
	return player
end

function CharacterRules.clear(self: Rules, userId: number)
	self.players[userId] = nil
end

-- Returns (ok, reason). reason is "" on success.
function CharacterRules.switch(self: Rules, userId: number, slot: any, options: Options): (boolean, string)
	if options.phase ~= "Playing" then
		return false, "phase"
	end
	if not options.participating then
		return false, "not-participating"
	end
	if typeof(slot) ~= "number" or slot ~= math.floor(slot) or slot &lt; 1 or slot &gt; #self.order then
		return false, "bad-slot"
	end
	local player = CharacterRules.ensure(self, userId)
	local target = self.order[slot]
	if target == player.active then
		return false, "same-character"
	end
	local chaos = options.chaos == true
	if player.normalLeft &gt; 0 then
		player.normalLeft -= 1
	elseif player.bonusLeft &gt; 0 and chaos then
		player.bonusLeft -= 1
	elseif player.bonusLeft &gt; 0 then
		return false, "bonus-during-chaos-only"
	else
		return false, "no-switches"
	end
	player.active = target
	return true, ""
end

-- Starts the active character's ability. Returns (ok, reason, abilityKey).
function CharacterRules.ability(self: Rules, userId: number, now: number, options: Options): (boolean, string, string)
	if options.phase ~= "Playing" then
		return false, "phase", ""
	end
	if not options.participating then
		return false, "not-participating", ""
	end
	local player = CharacterRules.ensure(self, userId)
	local ready = player.readyAt[player.active] or 0
	if now &lt; ready then
		return false, "cooling", ""
	end
	local entry = self.roster[player.active]
	player.readyAt[player.active] = now + entry.Cooldown
	return true, "", entry.Ability
end

-- Seconds until a character's ability is ready again, never negative.
function CharacterRules.remaining(self: Rules, userId: number, characterId: string, now: number): number
	local player = self.players[userId]
	if player == nil then
		return 0
	end
	return math.max(0, (player.readyAt[characterId] or 0) - now)
end

-- The per-player view the client renders. Cooldowns are sent as server-clock deadlines,
-- so the client can count down without the server re-sending every second.
function CharacterRules.view(self: Rules, userId: number, chaos: boolean): { [string]: any }
	local player = CharacterRules.ensure(self, userId)
	local readyAt: { [string]: number } = {}
	for id, value in player.readyAt do
		readyAt[id] = value
	end
	return {
		active = player.active,
		normalLeft = player.normalLeft,
		bonusLeft = if chaos then player.bonusLeft else 0,
		bonusTotal = self.bonusMax,
		normalTotal = self.normalMax,
		readyAt = readyAt,
	}
end

return CharacterRules
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX001083">
          <Properties>
            <string name="Name">MovementGuard</string>
            <ProtectedString name="Source">--!strict
-- A modest server-side teleport/speed sanity check, not a claim of exploit-proof physics.
-- Vertical motion is unrestricted so low-gravity jumps and falling remain valid.
local MovementGuard = {}
MovementGuard.__index = MovementGuard

export type Position = { x: number, y: number, z: number }
type Track = { position: Position, at: number, unlockAt: number, grantSpeed: number, grantUntil: number }
type Fields = { tracks: { [number]: Track }, speed: number, slack: number, protection: number }
export type Guard = typeof(setmetatable({} :: Fields, MovementGuard))

local function valid(p: Position): boolean
	return p.x == p.x and p.y == p.y and p.z == p.z
		and math.abs(p.x) &lt; 100000 and math.abs(p.y) &lt; 100000 and math.abs(p.z) &lt; 100000
end

function MovementGuard.new(speed: number, slack: number, protection: number): Guard
	return setmetatable({ tracks = {}, speed = speed, slack = slack, protection = protection }, MovementGuard)
end

function MovementGuard.teleport(self: Guard, id: number, position: Position, now: number)
	self.tracks[id] = { position = position, at = now, unlockAt = now + self.protection, grantSpeed = 0, grantUntil = 0 }
end

-- A temporary allowance for movement the server itself caused (an ability push or dash).
-- It adds `speed` to the horizontal limit until `untilAt`, and nothing more. Without a
-- grant the check is exactly as strict as before.
function MovementGuard.grant(self: Guard, id: number, speed: number, untilAt: number, now: number)
	assert(speed &gt;= 0, "grant speed cannot be negative")
	local track = self.tracks[id]
	if track == nil then
		-- No known position yet: nothing to relax. The caller grants after observing.
		return false
	end
	track.grantSpeed = math.max(if now &lt; track.grantUntil then track.grantSpeed else 0, speed)
	track.grantUntil = math.max(if now &lt; track.grantUntil then track.grantUntil else 0, untilAt)
	return true
end

function MovementGuard.remove(self: Guard, id: number)
	self.tracks[id] = nil
end

function MovementGuard.observe(self: Guard, id: number, position: Position, now: number): (boolean, Position?)
	local track = self.tracks[id]
	if not valid(position) then
		return false, if track then track.position else nil
	end
	if not track then
		self:teleport(id, position, now)
		return false, nil
	end
	local dt = math.clamp(now - track.at, 0, 1)
	local dx = position.x - track.position.x
	local dz = position.z - track.position.z
	local bonus = if now &lt; track.grantUntil then track.grantSpeed else 0
	local limit = (self.speed + bonus) * dt + self.slack
	if dx * dx + dz * dz &gt; limit * limit then
		track.at = now
		track.unlockAt = now + self.protection
		return false, track.position
	end
	track.position = position
	track.at = now
	return now &gt;= track.unlockAt, nil
end

return MovementGuard
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX001084">
          <Properties>
            <string name="Name">PickupLedger</string>
            <ProtectedString name="Source">--!strict
-- Atomic, non-yielding collectible ownership. Positions and values originate on the server.
local PickupLedger = {}
PickupLedger.__index = PickupLedger

export type Position = { x: number, y: number, z: number }
export type Kind = { Name: string, Value: number, Weight: number, Color: { number } }
export type Slot = {
	id: number, position: Position, generation: number, available: boolean,
	readyAt: number, kindIndex: number, species: string,
}
export type Context = {
	userId: number, roundId: number, active: boolean, alive: boolean, position: Position,
}
export type Receipt = {
	userId: number, roundId: number, slotId: number, generation: number,
	kindIndex: number, value: number, position: Position, species: string,
}
type Fields = {
	slots: { Slot }, kinds: { Kind }, radius: number, respawn: number,
	roundId: number, running: boolean, choose: () -&gt; number, species: (number, number) -&gt; string,
	rareScale: number,
}
export type Ledger = typeof(setmetatable({} :: Fields, PickupLedger))

local function finite(n: number): boolean
	return n == n and n &gt; -math.huge and n &lt; math.huge
end
local function validPosition(p: Position): boolean
	return finite(p.x) and finite(p.y) and finite(p.z)
end

function PickupLedger.new(
	positions: { Position },
	kinds: { Kind },
	radius: number,
	respawn: number,
	choose: () -&gt; number,
	species: ((number, number) -&gt; string)?
): Ledger
	assert(radius &gt; 0 and respawn &gt; 0 and #kinds &gt; 0, "Invalid pickup rules")
	for _, kind in kinds do
		assert(kind.Value == 1 or kind.Value == 5 or kind.Value == 10, "Invalid server denomination")
		assert(kind.Weight &gt; 0, "Positive rarity weights required")
	end
	local slots: { Slot } = {}
	for id, position in positions do
		assert(validPosition(position), "Invalid server spawn point")
		table.insert(slots, {
			id = id, position = position, generation = 0, available = false,
			readyAt = 0, kindIndex = 1, species = "",
		})
	end
	-- Which of the two characters for a rarity a slot shows. Pure and deterministic,
	-- so a cell looks the same for every client and the receipt is authoritative.
	local speciesOf = species or function(slotId: number, _value: number): string
		return "brain" .. tostring(slotId % 2)
	end
	return setmetatable({
		slots = slots, kinds = kinds, radius = radius, respawn = respawn,
		roundId = 0, running = false, choose = choose, species = speciesOf, rareScale = 1,
	}, PickupLedger)
end

-- Weight of one kind for the next roll. Only denominations above +1 are scaled, so
-- Brain Cell Rush raises the odds of Rare and Prismatic cells and nothing else.
local function weightOf(self: Ledger, kind: Kind): number
	return if kind.Value &gt; 1 then kind.Weight * self.rareScale else kind.Weight
end

-- The server sets this from the live Chaos Event each tick (1 = normal odds).
function PickupLedger.setRareScale(self: Ledger, scale: number)
	assert(scale == scale and scale &gt;= 0 and scale &lt; math.huge, "Rarity scale must be finite and non-negative")
	self.rareScale = scale
end

function PickupLedger.rollKind(self: Ledger): number
	local total = 0
	for _, kind in self.kinds do
		total += weightOf(self, kind)
	end
	local roll = math.clamp(self.choose(), 0, 0.999999) * total
	for index, kind in self.kinds do
		roll -= weightOf(self, kind)
		if roll &lt; 0 then
			return index
		end
	end
	return #self.kinds
end

function PickupLedger.beginRound(self: Ledger, roundId: number)
	self.roundId = roundId
	self.running = true
	for _, slot in self.slots do
		slot.generation += 1
		slot.available = true
		slot.readyAt = 0
		slot.kindIndex = self:rollKind()
		slot.species = self.species(slot.id, self.kinds[slot.kindIndex].Value)
	end
end

function PickupLedger.clear(self: Ledger)
	self.running = false
	for _, slot in self.slots do
		slot.available = false
		slot.readyAt = math.huge
	end
end

function PickupLedger.tryClaim(self: Ledger, slotId: number, generation: number, context: Context, now: number): (Receipt?, string)
	if not finite(now) or not self.running or not context.active or context.roundId ~= self.roundId then
		return nil, "inactive-round"
	end
	if not finite(context.userId) or context.userId == 0 or context.userId % 1 ~= 0 or not context.alive then
		return nil, "invalid-player"
	end
	if not finite(slotId) or slotId % 1 ~= 0 then
		return nil, "invalid-slot"
	end
	local slot = self.slots[slotId]
	if not slot or not slot.available or slot.generation ~= generation then
		return nil, "unavailable"
	end
	if not validPosition(context.position) then
		return nil, "invalid-position"
	end
	local dx = slot.position.x - context.position.x
	local dy = slot.position.y - context.position.y
	local dz = slot.position.z - context.position.z
	if dx * dx + dy * dy + dz * dz &gt; self.radius * self.radius then
		return nil, "out-of-range"
	end
	-- Consume BEFORE returning. Two players in the same simulation tick cannot both win it.
	slot.available = false
	slot.readyAt = now + self.respawn
	return {
		userId = context.userId, roundId = self.roundId, slotId = slotId, generation = generation,
		kindIndex = slot.kindIndex, value = self.kinds[slot.kindIndex].Value, position = slot.position,
		species = slot.species,
	}, "ok"
end

function PickupLedger.step(self: Ledger, now: number): { number }
	local changed: { number } = {}
	if not self.running then
		return changed
	end
	for _, slot in self.slots do
		if not slot.available and now &gt;= slot.readyAt then
			slot.generation += 1
			slot.kindIndex = self:rollKind()
			slot.species = self.species(slot.id, self.kinds[slot.kindIndex].Value)
			slot.available = true
			table.insert(changed, slot.id)
		end
	end
	return changed
end

return PickupLedger
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX001085">
          <Properties>
            <string name="Name">RoundMachine</string>
            <ProtectedString name="Source">--!strict
-- Engine-independent authority. No task.wait(), remotes, or Roblox objects live here.
--
-- Phase 5 additions, all inside the same non-yielding model:
--   * staged rounds      Collect -&gt; Compete -&gt; Chaos -&gt; Final Rush, each boundary
--                        banks every player's carried cells (see `bank`)
--   * survival events    a scheduled timeline (low gravity + one rotating wildcard)
--                        with a public warning window, so timing is predictable
--   * stealing           short-range tag that moves ONE *carried* cell between two
--                        players. Banked score can never be taken, and nothing
--                        leaves the round: the total stays conserved.
local RoundMachine = {}
RoundMachine.__index = RoundMachine

export type Timing = {
	Intermission: number, Round: number, Results: number,
	ChaosStart: number, ChaosDuration: number, Warning: number,
}
export type Stage = { Name: string, At: number, Label: string }
export type StealRules = {
	Range: number, Cooldown: number, Protection: number, Immunity: number, RepeatWindow: number,
}
export type Settings = {
	Timing: Timing,
	Stages: { Stage }?, Chaos: { Kinds: { string } },
	Steal: StealRules,
	ParticipationCoins: number, CoinsPerPoint: number, WinnerCoins: number, HaloCost: number,
	SlipperyFriction: number?, RushRespawn: number?, FinalRespawn: number?,
}
export type Player = {
	id: number, name: string, score: number, coins: number, wins: number, pickups: number,
	participating: boolean, haloOwned: boolean, haloEquipped: boolean,
	collection: { [string]: number },
	-- Round inventory. `carried` holds the values not yet banked, so a stolen cell
	-- can be removed from exactly the right place.
	carried: { number }, carriedValue: number,
	stealReadyAt: number, protectedUntil: number, immuneUntil: number,
	lastVictim: number, lastStealAt: number, steals: number, lost: number,
}
export type Row = {
	id: number, name: string, score: number, coins: number, wins: number, pickups: number,
	haloOwned: boolean, haloEquipped: boolean, collection: { [string]: number },
	collected: number, carried: number, carriedValue: number,
	steals: number, lost: number, stealReadyAt: number, protectedUntil: number, immuneUntil: number,
}
export type Results = {
	roundId: number, winners: { Row }, topScore: number, rewards: { [string]: number },
}
export type Effect = {
	kind: string, phase: string?, active: boolean?, event: string?, stage: string?,
	label: string?, at: number?, endsAt: number?,
}
export type Scheduled = { Kind: string, StartsAt: number, EndsAt: number, WarningAt: number }
export type StealOutcome = 'ok' | 'inactive-round' | 'invalid-player' | 'missing-player'
	| 'self' | 'cooldown' | 'protected' | 'immune' | 'repeat' | 'out-of-range' | 'empty'

type Fields = {
	config: Settings, players: { [number]: Player }, phase: string, roundId: number,
	phaseStartedAt: number, phaseEndsAt: number, eventActive: boolean, eventEndsAt: number,
	eventKind: string, eventFinished: boolean, eventWarning: string, warningEndsAt: number,
	stage: string, stageIndex: number, stageEndsAt: number, schedule: { Scheduled },
	lastNow: number, lastResults: Results?,
	choose: (number) -&gt; number, chaosKind: string,
}
export type Machine = typeof(setmetatable({} :: Fields, RoundMachine))

local function finite(value: number): boolean
	return value == value and value &gt; -math.huge and value &lt; math.huge
end

-- Public names for each event. The client prints these verbatim, so every client
-- shows the same words for the same server event.
local LABEL: { [string]: string } = {
	LowGravity = "LOW GRAVITY",
	BouncyWorld = "BOUNCY WORLD",
	SlipperyChaos = "SLIPPERY CHAOS",
	BrainCellRush = "BRAIN CELL RUSH",
}

RoundMachine.Label = LABEL

local DEFAULT_STAGES: { Stage } = {
	{ Name = "Collect", At = 0, Label = "COLLECT" },
	{ Name = "Compete", At = 45, Label = "COMPETE" },
	{ Name = "Chaos", At = 105, Label = "CHAOS" },
	{ Name = "Final", At = 150, Label = "FINAL RUSH" },
}
local DEFAULT_KINDS = { "LowGravity", "BouncyWorld", "SlipperyChaos", "BrainCellRush" }

-- `choose(n)` returns an integer in 1..n. The server passes its own RNG; tests pass a
-- scripted one. Defaults to math.random so the pure module runs standalone.
function RoundMachine.new(config: Settings, choose: ((number) -&gt; number)?): Machine
	assert(config.Timing.Intermission &gt; 0 and config.Timing.Round &gt; 0 and config.Timing.Results &gt; 0, "Positive phase durations required")
	assert(config.Timing.ChaosStart &gt;= 0 and config.Timing.ChaosDuration &gt; 0, "Invalid Chaos Event timing")
	assert(config.Timing.ChaosStart + config.Timing.ChaosDuration &lt; config.Timing.Round, "Chaos event must fit inside the round")
	assert(#(config.Stages or DEFAULT_STAGES) &gt; 0, "At least one stage required")
	assert((config.Stages or DEFAULT_STAGES)[1].At == 0, "The first stage must start at zero")
	-- A config can legitimately carry a longer timeline than the round it is paired
	-- with (a quick-test round is shorter than the stage plan). Boundaries past the
	-- deadline are dropped rather than trimmed, so a stage never starts at an instant
	-- the round cannot reach.
	local stages: { Stage } = {}
	for _, stage in config.Stages or DEFAULT_STAGES do
		assert(stage.At &gt;= 0, "Stage outside the round")
		if stage.At &lt; config.Timing.Round then
			if #stages &gt; 0 then
				assert(stage.At &gt; stages[#stages].At, "Stages must be strictly increasing")
			end
			table.insert(stages, stage)
		end
	end
	local kinds = if config.Chaos then config.Chaos.Kinds else DEFAULT_KINDS
	assert(#kinds &gt; 0, "The Chaos pool needs at least one kind")
	local seen: { [string]: boolean } = {}
	for _, kind in kinds do
		assert(LABEL[kind] ~= nil, "Unknown Chaos Event kind: " .. tostring(kind))
		assert(not seen[kind], "Duplicate Chaos Event kind: " .. kind)
		seen[kind] = true
	end
	config = table.clone(config) :: Settings
	config.Stages = stages
	config.Chaos = { Kinds = table.clone(kinds) }
	assert(config.Steal.Range &gt; 0 and config.Steal.Cooldown &gt; 0, "Invalid steal rules")
	return setmetatable({
		config = config, players = {}, phase = "Waiting", roundId = 0,
		phaseStartedAt = 0, phaseEndsAt = 0, eventActive = false, eventEndsAt = 0,
		eventKind = "", eventFinished = false, eventWarning = "", warningEndsAt = 0,
		stage = stages[1].Name, stageIndex = 1, stageEndsAt = 0, schedule = {},
		lastNow = 0, lastResults = nil,
		choose = choose or function(n: number): number return math.random(1, n) end,
		chaosKind = "",
	}, RoundMachine)
end

function RoundMachine.addPlayer(self: Machine, id: number, name: string): boolean
	-- Studio local clients use negative UserIds. Never reject those.
	if not finite(id) or id % 1 ~= 0 or id == 0 or self.players[id] then
		return false
	end
	self.players[id] = {
		id = id, name = string.sub(name, 1, 50), score = 0, coins = 0, wins = 0, pickups = 0,
		participating = self.phase == "Playing", haloOwned = false, haloEquipped = false,
		collection = {}, carried = {}, carriedValue = 0,
		-- A player who joins mid-round is protected for the usual spawn window.
		stealReadyAt = 0, protectedUntil = 0, immuneUntil = 0,
		lastVictim = 0, lastStealAt = -math.huge, steals = 0, lost = 0,
	}
	if self.phase == "Playing" then
		self.players[id].protectedUntil = self.lastNow + self.config.Steal.Protection
	end
	return true
end

function RoundMachine.removePlayer(self: Machine, id: number)
	self.players[id] = nil
end

function RoundMachine.isParticipating(self: Machine, id: number): boolean
	local player = self.players[id]
	return self.phase == "Playing" and player ~= nil and player.participating
end

-- Spawn / respawn protection. Called by the server when a character (re)spawns or
-- is routed into the arena, so the window is real rather than wall-clock guesswork.
function RoundMachine.spawnProtect(self: Machine, id: number, now: number)
	local player = self.players[id]
	if player then
		player.protectedUntil = now + self.config.Steal.Protection
	end
end

-- --------------------------------------------------------------------------- #
-- Inventory: carried (stealable) vs banked (safe). `score` is always the sum of
-- both, so nothing a player collected is ever lost — a steal only moves it.
-- --------------------------------------------------------------------------- #
local function bankPlayer(player: Player): number
	local amount = player.carriedValue
	table.clear(player.carried)
	player.carriedValue = 0
	return amount
end

-- Bank everything now. Returns the value that became safe.
function RoundMachine.bank(self: Machine, id: number): number
	local player = self.players[id]
	if not player then
		return 0
	end
	return bankPlayer(player)
end

function RoundMachine.carriedValue(self: Machine, id: number): number
	local player = self.players[id]
	return if player then player.carriedValue else 0
end

-- `species` is the character the player actually collected. It is recorded for the
-- collection screen only: it never changes the reward, which stays pinned to the
-- server's denomination table.
function RoundMachine.award(
	self: Machine,
	id: number,
	value: number,
	roundId: number,
	species: string?
): boolean
	if roundId ~= self.roundId or not self:isParticipating(id) then
		return false
	end
	-- Only the server's three collectible denominations are permitted.
	if value ~= 1 and value ~= 5 and value ~= 10 then
		return false
	end
	local player = self.players[id]
	player.score += value
	player.pickups += 1
	-- Every award is carried until the next stage boundary; that is the risk window.
	table.insert(player.carried, value)
	player.carriedValue += value
	if species and species ~= "" then
		player.collection[species] = (player.collection[species] or 0) + 1
	end
	return true
end

-- --------------------------------------------------------------------------- #
-- Stealing. The server resolves distance and eligibility; this function only
-- decides. `distance` is passed in so the rule stays engine-independent.
-- --------------------------------------------------------------------------- #
function RoundMachine.stealBlockedReason(self: Machine, id: number, now: number): string?
	local player = self.players[id]
	if not player then
		return "missing-player"
	end
	if now &lt; player.protectedUntil then
		return "protected"
	end
	if now &lt; player.stealReadyAt then
		return "cooldown"
	end
	if now &lt; player.immuneUntil then
		return "immune"
	end
	return nil
end

function RoundMachine.canSteal(self: Machine, id: number, now: number): boolean
	return self:stealBlockedReason(id, now) == nil and self:isParticipating(id)
end

function RoundMachine.trySteal(
	self: Machine,
	thiefId: number,
	victimId: number,
	distance: number,
	now: number,
	roundId: number
): (StealOutcome, number)
	if roundId ~= self.roundId or self.phase ~= "Playing" then
		return "inactive-round", 0
	end
	if not finite(thiefId) or not finite(victimId) or thiefId == 0 or victimId == 0 then
		return "invalid-player", 0
	end
	if thiefId == victimId then
		return "self", 0
	end
	local thief, victim = self.players[thiefId], self.players[victimId]
	if not thief or not victim then
		return "missing-player", 0
	end
	if not thief.participating or not victim.participating then
		return "missing-player", 0
	end
	if not finite(distance) or distance &gt; self.config.Steal.Range then
		return "out-of-range", 0
	end
	local blocked = self:stealBlockedReason(thiefId, now)
	if blocked then
		return (blocked :: any) :: StealOutcome, 0
	end
	-- The victim needs their own protection too: no tagging a player who just spawned.
	if now &lt; victim.protectedUntil or now &lt; victim.immuneUntil then
		return "immune", 0
	end
	-- No repeated unfair targeting: the same pair cannot re-tag inside the window.
	if thief.lastVictim == victimId and now - thief.lastStealAt &lt; self.config.Steal.RepeatWindow then
		return "repeat", 0
	end
	if #victim.carried == 0 then
		return "empty", 0
	end
	-- Steal the biggest cell the victim is carrying; ties take the first.
	local best = 1
	for index = 2, #victim.carried do
		if victim.carried[index] &gt; victim.carried[best] then
			best = index
		end
	end
	local value = victim.carried[best]
	table.remove(victim.carried, best)
	victim.carriedValue -= value
	if math.abs(victim.carriedValue) &lt; 1e-6 then
		victim.carriedValue = 0
	end
	victim.score -= value
	victim.immuneUntil = now + self.config.Steal.Immunity
	victim.lost += value

	-- The cell arrives in the thief's own carried pile, so it can be taken back.
	table.insert(thief.carried, value)
	thief.carriedValue += value
	thief.score += value
	thief.steals += 1
	thief.stealReadyAt = now + self.config.Steal.Cooldown
	thief.lastVictim = victimId
	thief.lastStealAt = now
	return "ok", value
end

-- Number of distinct characters collected this session (0-6).
function RoundMachine.distinct(self: Machine, id: number): number
	local player = self.players[id]
	if not player then
		return 0
	end
	local count = 0
	for _, amount in player.collection do
		if amount &gt; 0 then
			count += 1
		end
	end
	return count
end

-- Persistent profile -&gt; round session. The machine still owns the live numbers
-- (so a purchase is atomic inside the round), but they start from the saved copy
-- and are written back after every change.
function RoundMachine.seedProfile(self: Machine, id: number, coins: number, halo: string): boolean
	local player = self.players[id]
	if not player then
		return false
	end
	player.coins = math.max(0, math.floor(coins))
	player.haloOwned = halo ~= nil and halo ~= "None" and halo ~= ""
	player.haloEquipped = player.haloOwned
	return true
end

-- What the adapter needs to persist after a halo purchase / equip.
function RoundMachine.cosmetics(self: Machine, id: number): (number, string)
	local player = self.players[id]
	if not player then
		return 0, "None"
	end
	return player.coins, if player.haloEquipped or player.haloOwned then "Cyan" else "None"
end

function RoundMachine.haloAction(self: Machine, id: number): (boolean, string)
	local player = self.players[id]
	if not player then
		return false, "Player missing"
	end
	if player.haloOwned then
		player.haloEquipped = not player.haloEquipped
		return true, if player.haloEquipped then "Halo equipped" else "Halo unequipped"
	end
	if player.coins &lt; self.config.HaloCost then
		return false, "Not enough coins — collect cells to earn them"
	end
	player.coins -= self.config.HaloCost
	player.haloOwned = true
	player.haloEquipped = true
	return true, "Pulse Halo unlocked for this session!"
end

function RoundMachine.rows(self: Machine): { Row }
	local rows: { Row } = {}
	for _, player in self.players do
		local collection: { [string]: number } = {}
		local collected = 0
		for species, amount in player.collection do
			collection[species] = amount
			if amount &gt; 0 then
				collected += 1
			end
		end
		table.insert(rows, {
			id = player.id, name = player.name, score = player.score, coins = player.coins,
			wins = player.wins, pickups = player.pickups,
			haloOwned = player.haloOwned, haloEquipped = player.haloEquipped,
			collection = collection, collected = collected,
			carried = #player.carried, carriedValue = player.carriedValue,
			steals = player.steals, lost = player.lost,
			stealReadyAt = player.stealReadyAt, protectedUntil = player.protectedUntil,
			immuneUntil = player.immuneUntil,
		})
	end
	table.sort(rows, function(a: Row, b: Row)
		return if a.score == b.score then a.id &lt; b.id else a.score &gt; b.score
	end)
	return rows
end

function RoundMachine.finishRound(self: Machine)
	local rows = self:rows()
	local topScore = if rows[1] then rows[1].score else 0
	local winners: { Row } = {}
	local rewards: { [string]: number } = {}
	for _, row in rows do
		local player = self.players[row.id]
		if player.participating then
			local won = topScore &gt; 0 and row.score == topScore
			local amount = self.config.ParticipationCoins + row.score * self.config.CoinsPerPoint
			if won then
				amount += self.config.WinnerCoins
				player.wins += 1
				table.insert(winners, row)
			end
			player.coins += amount
			rewards[tostring(row.id)] = amount
		end
		-- Round inventory never survives the round; the score that already counted
		-- it is what gets paid and recorded.
		bankPlayer(player)
		player.participating = false
	end
	self.lastResults = { roundId = self.roundId, winners = winners, topScore = topScore, rewards = rewards }
end

-- Which stage an elapsed time falls in. Pure, so both the machine and tests agree.
function RoundMachine.stageAt(self: Machine, elapsed: number): (number, Stage)
	local stages = self.config.Stages or DEFAULT_STAGES
	local index = 1
	for position, stage in stages do
		if elapsed &gt;= stage.At then
			index = position
		end
	end
	return index, stages[index]
end

-- Draw the single Chaos Event for a round. Uniform over the configured pool, decided
-- on the server at round start, and sent to clients inside the snapshot.
function RoundMachine.drawChaos(self: Machine): string
	local kinds = self.config.Chaos.Kinds
	local raw = self.choose(#kinds)
	local index = if finite(raw) then math.clamp(math.floor(raw), 1, #kinds) else 1
	return kinds[index]
end

-- The round's timeline: exactly one window, warned in advance. A kind can be given
-- explicitly (tests, replays); the live machine uses the kind drawn for this round.
function RoundMachine.buildSchedule(self: Machine, kind: string?): { Scheduled }
	local chosen = kind or self.chaosKind
	if chosen == "" then
		return {}
	end
	local start = self.config.Timing.ChaosStart
	return {{
		Kind = chosen,
		StartsAt = start,
		EndsAt = start + self.config.Timing.ChaosDuration,
		WarningAt = math.max(0, start - (self.config.Timing.Warning or 0)),
	}}
end

function RoundMachine.eventLabel(kind: string): string
	return LABEL[kind] or string.upper(kind)
end

function RoundMachine.setPhase(self: Machine, phase: string, now: number, effects: { Effect })
	self.phase = phase
	self.phaseStartedAt = now
	if phase == "Playing" then
		self.roundId += 1
		self.lastResults = nil
		self.eventFinished = false
		self.eventActive = false
		self.eventEndsAt = 0
		self.eventKind = ""
		self.eventWarning = ""
		self.warningEndsAt = 0
		self.phaseEndsAt = now + self.config.Timing.Round
		self.chaosKind = self:drawChaos()
		self.schedule = self:buildSchedule(self.chaosKind)
		local _, stage = self:stageAt(0)
		self.stage = stage.Name
		self.stageIndex = 1
		self.stageEndsAt = now + self.config.Timing.Round
		for _, player in self.players do
			player.score = 0
			player.pickups = 0
			player.participating = true
			table.clear(player.carried)
			player.carriedValue = 0
			player.stealReadyAt = 0
			player.protectedUntil = now + self.config.Steal.Protection
			player.immuneUntil = 0
			player.lastVictim = 0
			player.lastStealAt = -math.huge
			player.steals = 0
			player.lost = 0
		end
	elseif phase == "Intermission" then
		self.phaseEndsAt = now + self.config.Timing.Intermission
		self.stage = ""
		self.stageIndex = 0
		self.stageEndsAt = 0
		self.eventActive = false
		self.eventEndsAt = 0
		self.eventKind = ""
		self.eventWarning = ""
		self.schedule = {}
		self.chaosKind = ""
	elseif phase == "Results" then
		self:finishRound()
		self.phaseEndsAt = now + self.config.Timing.Results
		self.eventActive = false
		self.eventEndsAt = 0
		self.eventKind = ""
		self.eventWarning = ""
	else
		self.phaseEndsAt = 0
		self.lastResults = nil
		self.stage = ""
		self.stageIndex = 0
		self.stageEndsAt = 0
		self.eventActive = false
		self.eventEndsAt = 0
		self.eventKind = ""
		self.eventWarning = ""
		self.schedule = {}
		self.chaosKind = ""
		for _, player in self.players do
			player.participating = false
			table.clear(player.carried)
			player.carriedValue = 0
		end
	end
	table.insert(effects, { kind = "phase", phase = phase })
end

local function closeEvent(self: Machine, effects: { Effect })
	if self.eventActive then
		self.eventActive = false
		self.eventEndsAt = 0
		table.insert(effects, { kind = "event", active = false, event = self.eventKind })
	end
	self.eventKind = ""
end

function RoundMachine.step(self: Machine, now: number): { Effect }
	assert(finite(now) and now &gt;= self.lastNow, "Server clock must be finite and monotonic")
	self.lastNow = now
	local effects: { Effect } = {}
	if next(self.players) == nil then
		if self.eventActive then
			closeEvent(self, effects)
		end
		if self.phase ~= "Waiting" then
			self:setPhase("Waiting", now, effects)
		end
		return effects
	end

	-- End first: a stalled server must never award a pickup after the deadline.
	if self.phase == "Waiting" then
		self:setPhase("Intermission", now, effects)
	elseif self.phase == "Intermission" and now &gt;= self.phaseEndsAt then
		self:setPhase("Playing", now, effects)
	elseif self.phase == "Playing" and now &gt;= self.phaseEndsAt then
		closeEvent(self, effects)
		self:setPhase("Results", now, effects)
	elseif self.phase == "Results" and now &gt;= self.phaseEndsAt then
		self:setPhase("Intermission", now, effects)
	end

	if self.phase == "Playing" then
		local elapsed = now - self.phaseStartedAt

		-- Stage boundaries bank everything carried. A player who never competes
		-- still keeps what they collected, which is the point of banking.
		local desiredIndex, desiredStage = self:stageAt(elapsed)
		if desiredIndex &gt; self.stageIndex then
			for _, player in self.players do
				bankPlayer(player)
			end
			self.stageIndex = desiredIndex
			self.stage = desiredStage.Name
			table.insert(effects, { kind = "stage", stage = desiredStage.Name, label = desiredStage.Label })
		end
		local stages = self.config.Stages or DEFAULT_STAGES
		local nextStage = stages[self.stageIndex + 1]
		self.stageEndsAt = if nextStage then self.phaseStartedAt + nextStage.At else self.phaseEndsAt

		-- Event timeline: warnings first, then the window itself.
		for _, entry in self.schedule do
			if elapsed &gt;= entry.WarningAt and elapsed &lt; entry.StartsAt and self.eventWarning ~= entry.Kind then
				self.eventWarning = entry.Kind
				self.warningEndsAt = self.phaseStartedAt + entry.StartsAt
				table.insert(effects, {
					kind = "warning", event = entry.Kind,
					label = RoundMachine.eventLabel(entry.Kind),
					at = self.phaseStartedAt + entry.StartsAt,
				})
			end
		end
		if self.eventActive and elapsed &gt;= self.eventEndsAt - self.phaseStartedAt then
			closeEvent(self, effects)
		end
		if not self.eventActive then
			for _, entry in self.schedule do
				if elapsed &gt;= entry.StartsAt and elapsed &lt; entry.EndsAt then
					self.eventActive = true
					self.eventKind = entry.Kind
					self.eventEndsAt = self.phaseStartedAt + entry.EndsAt
					self.eventWarning = ""
					table.insert(effects, {
						kind = "event", active = true, event = entry.Kind,
						label = RoundMachine.eventLabel(entry.Kind), endsAt = self.eventEndsAt,
					})
					break
				end
			end
		end
		local finished = true
		for _, entry in self.schedule do
			if elapsed &lt; entry.EndsAt then
				finished = false
			end
		end
		self.eventFinished = finished
		if finished and self.eventWarning ~= "" then
			self.eventWarning = ""
		end
	end
	return effects
end

function RoundMachine.snapshot(self: Machine)
	local schedule: { { Kind: string, Label: string, At: number, Duration: number } } = {}
	local base = self.phaseStartedAt
	for _, entry in self.schedule do
		table.insert(schedule, {
			Kind = entry.Kind, Label = RoundMachine.eventLabel(entry.Kind),
			At = base + entry.StartsAt, Duration = entry.EndsAt - entry.StartsAt,
		})
	end
	return {
		phase = self.phase, roundId = self.roundId, phaseEndsAt = self.phaseEndsAt,
		eventActive = self.eventActive, eventEndsAt = self.eventEndsAt,
		eventKind = self.eventKind,
		eventWarning = self.eventWarning, eventWarningEndsAt = self.warningEndsAt,
		stage = self.stage, stageIndex = self.stageIndex, stageEndsAt = self.stageEndsAt,
		events = schedule,
		rows = self:rows(), results = self.lastResults,
	}
end

return RoundMachine
</ProtectedString>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBX001086">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CharacterWalkSpeed">22</float>
      <float name="CharacterJumpPower">50</float>
      <float name="CameraMaxZoomDistance">80</float>
      <float name="CameraMinZoomDistance">8</float>
      <bool name="CharacterUseJumpPower">true</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBX001087">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="RBX001088">
        <Properties>
          <string name="Name">BrainrotClient</string>
        </Properties>
        <Item class="ModuleScript" referent="RBX001089">
          <Properties>
            <string name="Name">Audio</string>
            <ProtectedString name="Source">--!strict
-- Client-side music and cue playback. It follows the replicated state, and every
-- decision (which track, when a cue fires) comes from AudioRules. Nothing here is
-- authoritative: audio never changes gameplay.
--
-- Behaviour:
--   * One looped Sound per CONFIGURED music track. An empty ID creates no Sound.
--   * Track changes crossfade over Config.Audio.CrossfadeSeconds. Volume moves a
--     fixed step per frame, so a fade always takes the same wall time.
--   * Stingers fire on the server-driven edges: round start/end, Chaos start/end.
--   * The Settings "Sound" toggle (hud.soundOn) mutes music and cues together.
--   * destroy() removes every Sound this module created.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")
local AudioRules = require(ReplicatedStorage:WaitForChild("BrainrotShared"):WaitForChild("AudioRules"))

local Audio = {}
Audio.__index = Audio

export type Track = { sound: Sound?, wanted: boolean }

export type Controller = typeof(setmetatable({} :: {
	config: any,
	folder: Folder,
	tracks: { [string]: Track },
	wanted: string,
	enabled: boolean,
	lastPhase: string?,
	lastEvent: string,
	cueCount: number,
}, Audio))

function Audio.new(config: any): Controller
	local folder = Instance.new("Folder")
	folder.Name = "BrainrotAudio"
	folder.Parent = SoundService
	local tracks: { [string]: Track } = {}
	for name, id in config.Audio.Tracks do
		assert(AudioRules.validId(id), "Invalid music ID for track " .. name)
		local track: Track = { sound = nil, wanted = false }
		if id ~= "" then
			local sound = Instance.new("Sound")
			sound.Name = "Music_" .. name
			sound.Looped = true
			sound.Volume = 0
			sound.SoundId = id
			sound.Parent = folder
			track.sound = sound
		end
		tracks[name] = track
	end
	return setmetatable({
		config = config, folder = folder, tracks = tracks, wanted = "Lobby",
		enabled = true, lastPhase = nil, lastEvent = "", cueCount = 0,
	}, Audio) :: any
end

-- Plays a one-shot cue. Returns true only when a sound actually started.
function Audio.cue(self: Controller, name: string): boolean
	local id = AudioRules.cueId(self.config.Audio.Cues, name)
	if id == nil or not self.enabled then
		return false
	end
	local sound = Instance.new("Sound")
	self.cueCount += 1
	sound.Name = "Cue_" .. name .. "_" .. self.cueCount
	sound.SoundId = id
	sound.Volume = self.config.Audio.CueVolume
	sound.Parent = self.folder
	sound:Play()
	Debris:AddItem(sound, 8)
	return true
end

-- Reacts to a replicated state snapshot. Only edges trigger stingers, so joining
-- mid-event does not replay anything from the past.
function Audio.setState(self: Controller, state: any)
	self.wanted = AudioRules.trackFor(state)
	local phase = state.phase
	local event = if state.eventActive then tostring(state.eventKind or "") else ""
	-- The first snapshot only records where things stand. A player who joins mid-round
	-- or mid-event hears the right music but not a stinger for something already past.
	if self.lastPhase == nil then
		self.lastPhase = phase
		self.lastEvent = event
		return
	end
	if phase ~= self.lastPhase then
		if phase == "Playing" then
			Audio.cue(self, "RoundStart")
		elseif self.lastPhase == "Playing" then
			Audio.cue(self, "RoundEnd")
		end
		self.lastPhase = phase
	end
	if event ~= self.lastEvent then
		if event ~= "" then
			Audio.cue(self, "ChaosStart")
		else
			Audio.cue(self, "ChaosEnd")
		end
		self.lastEvent = event
	end
end

-- Advances every crossfade by `dt` seconds. `enabled` is the Sound setting.
function Audio.tick(self: Controller, dt: number, enabled: boolean)
	self.enabled = enabled
	local fade = self.config.Audio.CrossfadeSeconds
	local full = self.config.Audio.MusicVolume
	for name, track in self.tracks do
		local sound = track.sound
		if sound then
			local target = if enabled and self.wanted == name then full else 0
			if target &gt; 0 and not track.wanted then
				track.wanted = true
				sound:Play()
			elseif target == 0 then
				track.wanted = false
			end
			sound.Volume = AudioRules.stepVolume(sound.Volume, target, dt, full, fade)
		end
	end
end

function Audio.destroy(self: Controller)
	self.folder:Destroy()
	table.clear(self.tracks)
end

return Audio
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX001090">
          <Properties>
            <string name="Name">Collection</string>
            <ProtectedString name="Source">--!nonstrict
-- The collection screen: six cards, one per character.
--
-- Every card is a live 3D viewport of the real model (the same Model class the
-- arena uses), so what the player sees in the log is literally the thing they
-- collect. Data comes from the server's per-player collection record: the name,
-- rarity, reward, how many were caught and whether it has been seen at all. There
-- are no placeholder stats — an uncollected card says so.
local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)
local Creatures = require(script.Parent.Creatures)

local Collection = {}
Collection.__index = Collection

local C, Type, Space, Motion, Copy = Theme.Colors, Theme.Type, Theme.Space, Theme.Motion, Theme.Copy

local RARITY = {
	Common = { color = C.Cyan, label = "COMMON" },
	Rare = { color = C.Amber, label = "RARE" },
	Legendary = { color = C.Violet, label = "LEGENDARY" },
}

-- A stage for one card: a turntable camera, a soft key light, and the model itself.
local function buildStage(card, character, size, reducedMotion)
	local viewport = Kit.instance("ViewportFrame", {
		Name = "Preview",
		Size = UDim2.fromOffset(size, size),
		Position = UDim2.fromOffset(0, 0),
		BackgroundColor3 = C.Navy,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 4,
	}, card)
	Kit.instance("UICorner", { CornerRadius = UDim.new(0, 10) }, viewport)

	local camera = Instance.new("Camera")
	camera.Name = "StageCamera"
	-- Slightly above and in front of the character: the same angle the arena uses.
	camera.CFrame = CFrame.lookAt(Vector3.new(0, .55, 2.9), Vector3.new(0, .05, 0))
	camera.FieldOfView = 34
	camera.Parent = viewport
	viewport.CurrentCamera = camera

	local stage = Instance.new("Model")
	stage.Name = "Stage_" .. character.name
	stage.Parent = viewport

	-- Plinth: the same idea as the lobby exhibit, so the cards feel like a museum.
	local plinth = Instance.new("Part")
	plinth.Name = "Plinth"
	plinth.Size = Vector3.new(1.7, .12, 1.7)
	plinth.CFrame = CFrame.new(0, -.86, 0)
	plinth.Anchored = true
	plinth.CanCollide, plinth.CanTouch, plinth.CanQuery, plinth.CastShadow = false, false, false, false
	plinth.Material = Enum.Material.SmoothPlastic
	plinth.Color = C.NavyRaised
	plinth.Parent = stage

	-- A rim of the rarity colour, so the card is readable at a glance.
	local rim = Instance.new("Part")
	rim.Name = "Rim"
	rim.Size = Vector3.new(.06, 1.9, 1.9)
	rim.Shape = Enum.PartType.Cylinder
	rim.CFrame = CFrame.new(0, -.80, 0) * CFrame.Angles(0, 0, math.pi / 2)
	rim.Anchored = true
	rim.CanCollide, rim.CanTouch, rim.CanQuery, rim.CastShadow = false, false, false, false
	rim.Material = Enum.Material.Neon
	rim.Color = RARITY[character.rarity].color
	rim.Transparency = .35
	rim.Parent = stage

	local view = Creatures.Build(stage, character.name, character.value, character.color, {
		label = false, phase = character.index * .7,
	})
	view.model.Name = character.label
	-- Models are authored around their own origin; the camera frames that origin.
	view.model:PivotTo(CFrame.new(0, -.62, 0))

	return {
		viewport = viewport,
		camera = camera,
		stage = stage,
		plinth = plinth,
		rim = rim,
		view = view,
		spin = 0,
		reducedMotion = reducedMotion,
	}
end

function Collection.new(parent, config)
	local self = setmetatable({}, Collection)
	self.config = config
	self.cards = {}
	self.entries = Creatures.catalogue()

	-- Full-screen layer under the modal card, so the collection is its own screen.
	self.frame = Kit.instance("Frame", {
		Name = "Collection",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 30,
	}, parent)
	self.scrim = Kit.instance("Frame", {
		Name = "Scrim",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.Void,
		BackgroundTransparency = .18,
		BorderSizePixel = 0,
		ZIndex = 30,
	}, self.frame)

	local panel = Kit.panel(self.frame, "Panel", UDim2.new(1, -48, 1, -48), UDim2.fromScale(.5, .5), {
		anchor = Vector2.new(.5, .5), zIndex = 31, padding = Space.xl, radius = 18,
	})
	self.panel = panel

	self.heading = Kit.text(panel, "Title", Copy.CollectionTitle, "Title", {
		size = UDim2.new(1, -220, 0, 26), color = C.White, zIndex = 32,
	})
	self.subtitle = Kit.text(panel, "Subtitle", "", "Label", {
		size = UDim2.new(1, -220, 0, 16), position = UDim2.fromOffset(0, 28),
		color = C.Muted, zIndex = 32,
	})
	self.progress = Kit.text(panel, "Progress", "", "Title", {
		size = UDim2.fromOffset(200, 24), position = UDim2.new(1, -208, 0, 2),
		color = C.Cyan, xAlign = Enum.TextXAlignment.Right, zIndex = 32,
	})
	self.hint = Kit.text(panel, "Hint", Copy.CollectionHint, "Micro", {
		size = UDim2.new(1, -220, 0, 14), position = UDim2.fromOffset(0, 46),
		color = C.Dim, zIndex = 32,
	})

	self.close = Kit.button(panel, "Close", "X", UDim2.fromOffset(36, 36), UDim2.new(1, -36, 0, 0),
		function() self:hide() end, { accent = C.NavyEdge, zIndex = 32 })
	self.close.Label.TextSize = Type.Body

	self.grid = Kit.instance("Frame", {
		Name = "Grid",
		-- Starts below the hint line: the grid can never overlap the header text.
		Size = UDim2.new(1, 0, 1, -Space.xl - 64),
		Position = UDim2.fromOffset(0, Space.xl + 64),
		BackgroundTransparency = 1,
		ZIndex = 31,
	}, panel)
	local layout = Kit.instance("UIGridLayout", {
		CellSize = UDim2.fromOffset(150, 196),
		CellPadding = UDim2.fromOffset(10, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
		FillDirectionMaxCells = 6,
	}, self.grid)
	self.layout = layout

	-- Resize hooks: the grid adapts to width, the cards keep a 3:4-ish shape.
	self.layout.FillDirectionMaxCells = 3
	self.cards = {}
	for _, entry in self.entries do
		table.insert(self.cards, self:buildCard(entry))
	end
	self.frame.Visible = false
	return self
end

function Collection:buildCard(entry)
	local rarity = RARITY[entry.rarity] or RARITY.Common
	local card = Kit.panel(self.grid, "Card_" .. entry.name, UDim2.fromOffset(150, 196), UDim2.fromOffset(0, 0), {
		zIndex = 32, radius = 12, color = C.NavyRaised, transparency = .5,
	})
	card.LayoutOrder = entry.index

	local stage = buildStage(card, entry, 150, false)
	stage.viewport.Size = UDim2.fromOffset(146, 108)
	stage.viewport.Position = UDim2.fromOffset(2, 2)

	local status = Kit.instance("Frame", {
		Name = "Status",
		Size = UDim2.fromOffset(10, 10),
		Position = UDim2.fromOffset(10, 116),
		BackgroundColor3 = C.Dim,
		BorderSizePixel = 0,
		ZIndex = 34,
	}, card)
	Kit.corner(status, 10)

	local name = Kit.text(card, "Name", entry.label, "Label", {
		size = UDim2.new(1, -26, 0, 16), position = UDim2.fromOffset(24, 112),
		color = C.White, zIndex = 34, truncate = true,
	})
	-- Starts after the status dot, so the rarity and the dot never collide.
	local rarityLabel = Kit.text(card, "Rarity", string.upper(entry.rarity) .. "  +" .. entry.value, "Micro", {
		size = UDim2.new(1, -34, 0, 12), position = UDim2.fromOffset(24, 130),
		color = rarity.color, zIndex = 34, truncate = true,
	})
	local count = Kit.text(card, "Count", "", "Body", {
		size = UDim2.new(1, -16, 0, 18), position = UDim2.fromOffset(9, 146),
		color = C.Muted, zIndex = 34, truncate = true,
	})
	count.Font = Enum.Font.GothamBold
	local blurb = Kit.text(card, "Blurb", entry.blurb, "Micro", {
		size = UDim2.new(1, -16, 0, 24), position = UDim2.fromOffset(9, 166),
		color = C.Dim, zIndex = 34, wrapped = true,
	})
	blurb.Font = Enum.Font.GothamMedium

	return {
		entry = entry,
		frame = card,
		stage = stage,
		status = status,
		name = name,
		rarity = rarityLabel,
		count = count,
		blurb = blurb,
		seen = false,
		amount = 0,
	}
end

-- `row` is the local player's server row: row.collection[name] -&gt; count.
function Collection:update(row)
	local caught = 0
	for _, card in self.cards do
		local amount = (row and row.collection and row.collection[card.entry.name]) or 0
		card.amount = amount
		card.seen = amount &gt; 0
		if card.seen then
			caught += 1
		end
		card.status.BackgroundColor3 = if card.seen then RARITY[card.entry.rarity].color else C.Dim
		card.name.TextColor3 = if card.seen then C.White else C.Dim
		card.rarity.TextTransparency = if card.seen then 0 else .45
		card.count.Text = if card.seen
			then Copy.CollectionCount .. "  ×" .. amount
			else Copy.CollectionMissing
		card.count.TextColor3 = if card.seen then C.Muted else C.Dim
		-- Uncollected specimens are shown as silhouettes: you can see what you are
		-- missing without the log pretending you caught it.
		for _, part in card.stage.view.parts do
			part.part.Transparency = if card.seen then 0 else .72
		end
		for _, item in card.stage.stage:GetChildren() do
			if item:IsA("BasePart") and (item.Name == "Plinth" or item.Name == "Rim") then
				item.Transparency = if card.seen then (if item.Name == "Rim" then .35 else 0) else .85
			end
		end
		card.stage.rim.Color = RARITY[card.entry.rarity].color
	end
	if row then
		self.subtitle.Text = string.format(
			"%d / %d CHARACTERS LOGGED  •  %d CELLS CAUGHT THIS SESSION  •  %d COINS",
			caught, #self.cards, row.pickups or 0, row.coins or 0)
	else
		self.subtitle.Text = string.format("%d / %d CHARACTERS LOGGED", caught, #self.cards)
	end
	self.progress.Text = string.format("%d / %d", caught, #self.cards)
	self.progress.TextColor3 = if caught == #self.cards then C.Amber else C.Cyan
end

function Collection:resize(width, height)
	local compact = width &lt; 780
	local columns = if compact then 2 else 3
	self.layout.FillDirectionMaxCells = columns
	self.layout.CellSize = if compact then UDim2.fromOffset(140, 178)
		else UDim2.fromOffset(150, 196)
	self.panel.Size = UDim2.new(1, -24, 1, -24)
	self.heading.TextSize = if compact then 18 else Type.Title
	self.subtitle.Visible = not compact
	self.hint.Visible = not compact
	for _, card in self.cards do
		card.frame.Size = self.layout.CellSize
		local cardWidth = self.layout.CellSize.X.Offset
		local cardHeight = self.layout.CellSize.Y.Offset
		card.stage.viewport.Size = UDim2.fromOffset(cardWidth - 4, cardHeight - 88)
		card.name.Position = UDim2.fromOffset(24, cardHeight - 84)
		card.rarity.Position = UDim2.fromOffset(24, cardHeight - 66)
		card.count.Position = UDim2.fromOffset(9, cardHeight - 50)
		card.blurb.Position = UDim2.fromOffset(9, cardHeight - 30)
		card.status.Position = UDim2.fromOffset(10, cardHeight - 72)
	end
	self.visibleHeight = height
end

function Collection:show()
	self.frame.Visible = true
end

function Collection:hide()
	self.frame.Visible = false
end

function Collection:isVisible()
	return self.frame.Visible == true
end

-- Turntable + idle animation for every visible card. Called from the HUD tick.
function Collection:step(now, reducedMotion)
	if not self.frame.Visible then
		return
	end
	for _, card in self.cards do
		local stage = card.stage
		local idle = stage.view.idle
		if reducedMotion then
			stage.view.model:PivotTo(CFrame.new(0, -.62, 0))
		else
			-- A slow turntable plus the character's own idle: it reads as a display
			-- case, not a static thumbnail.
			local spin = (now * .45 + card.entry.index * .6) % (math.pi * 2)
			local bob = math.sin(now * idle.Rate * 1.4 + card.entry.index) * .04
			Creatures.Idle(stage.view, now + card.entry.index * .7, false)
			stage.view.model:PivotTo(CFrame.new(0, -.62 + bob, 0) * CFrame.Angles(0, spin, 0))
		end
	end
end

function Collection:destroy()
	self.frame:Destroy()
end

return Collection
</ProtectedString>
          </Properties>
        </Item>
